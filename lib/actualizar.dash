# Versiones nuevas de Tachyon (tarea 44): mirar la última publicada en GitHub, y bajarla e instalarla cuando el
# usuario lo pida, como Chrome. Cada versión publica, junto al .lha, el ejecutable solo comprimido con gzip
# (Tachyon.gz, de tools/paquete.sh): Tachyon no sabe abrir .lha. Antes de cambiar nada se comprueba entero (el CRC
# y el tamaño del gzip, la cabecera de ejecutable y su $VER); el de antes queda como Tachyon.old.
#
#   c = actualizar_empezar()                    # sin esperar: http_avanzar(c) hasta true
#   n = actualizar_leer(http_texto(c.respuesta), "0.4.0-alfa")   # nil si no hay una más nueva
#   d = actualizar_bajar(n)                     # http_avanzar(d) hasta true
#   error = actualizar_instalar(actualizar_programa())           # "" si quedó instalada

import "http.dash"

# (las pruebas la cambian por la de un servidor local)
var actualizar_api: String = "https://api.github.com/repos/FreeMEM/tachyon/releases?per_page=3"
# los ficheros de cada versión publicada: + "v0.7.0-alfa/Tachyon-espanol.catalog"
var actualizar_descargas: String = "https://github.com/FreeMEM/tachyon/releases/download/"
const ACTUALIZAR_GZ = "T:Tachyon.gz"

struct Novedad
    version: String   # "0.5.0-alfa"
    url: String       # la de su Tachyon.gz
    catalogos: [String] = nil   # las de sus Tachyon-<idioma>.catalog (tarea 45g): se bajan tras instalar
end

# Las versiones publicadas (también las pre-release, que /releases/latest no da), sin esperar
func actualizar_empezar() -> Carga
    return http_empezar_metodo(actualizar_api, "GET", "", "", "Accept: application/vnd.github+json", 20000)
end

# Los números de una versión ("v0.4.0-alfa": 0, 4, 0)
func _version_numeros(v: String) -> [Int]
    var r: [Int] = []
    n = -1
    for i in (0..v.length - 1)
        c = str_code(v, i)
        if c >= 48 and c <= 57
            if n < 0
                n = 0
            end
            n = n * 10 + c - 48
        else
            if n >= 0
                r.push(n)
            end
            n = -1
            if c == 45
                # (lo de detrás del guion, "-alfa", no cuenta)
                break
            end
        end
    end
    if n >= 0
        r.push(n)
    end
    return r
end

# true si la versión nueva pasa a la actual (por sus números; con los mismos, no)
func actualizar_mas_nueva(nueva: String, actual: String) -> Bool
    a = _version_numeros(nueva)
    b = _version_numeros(actual)
    i = 0
    while i < a.length or i < b.length
        x = 0
        y = 0
        if i < a.length
            x = a[i]
        end
        if i < b.length
            y = b[i]
        end
        if x != y
            return x > y
        end
        i = i + 1
    end
    return false
end

# El texto de una clave de JSON ("clave":"valor") desde la posición desde, sin pasar de hasta; "" si no está
func _json_texto(json: String, clave: String, desde: Int, hasta: Int) -> String
    p = str_find_from(json, "\"" + clave + "\"", desde)
    if p < 0 or (hasta >= 0 and p >= hasta)
        return ""
    end
    p = str_find_from(json, "\"", p + clave.length + 2)
    if p < 0
        return ""
    end
    f = str_find_from(json, "\"", p + 1)
    if f < 0
        return ""
    end
    return json[p + 1:f]
end

# La versión más nueva que la actual, de la respuesta de GitHub (la primera es la última publicada); nil si no hay
# o no trae Tachyon.gz
func actualizar_leer(json: String, actual: String) -> Novedad
    var nada: Novedad = nil
    p = str_find(json, "\"tag_name\"")
    if p < 0
        return nada
    end
    etiqueta = _json_texto(json, "tag_name", p, -1)
    if not actualizar_mas_nueva(etiqueta, actual)
        return nada
    end
    # los ficheros de esa versión van entre su tag_name y el de la siguiente: su Tachyon.gz y sus catálogos
    fin = str_find_from(json, "\"tag_name\"", p + 10)
    gz = ""
    var catalogos: [String] = []
    q = p
    while true
        url = _json_texto(json, "browser_download_url", q, fin)
        if url == ""
            break
        end
        if str_ends(url, "/Tachyon.gz")
            gz = url
        elif actualizar_catalogo_idioma(url) != ""
            catalogos.push(url)
        end
        q = str_find_from(json, "\"browser_download_url\"", q) + 22
    end
    if gz == ""
        return nada
    end
    version = etiqueta
    if str_starts(version, "v")
        version = version[1:]
    end
    n = Novedad(version, gz)
    n.catalogos = catalogos
    return n
end

# El idioma de un catálogo publicado (".../Tachyon-english.catalog": "english"); "" si no es uno
func actualizar_catalogo_idioma(url: String) -> String
    p = str_find(url, "/Tachyon-")
    if p < 0 or not str_ends(url, ".catalog")
        return ""
    end
    while str_find_from(url, "/Tachyon-", p + 1) >= 0
        p = str_find_from(url, "/Tachyon-", p + 1)
    end
    idioma = url[p + 9:url.length - 8]
    if idioma == "" or str_find(idioma, "/") >= 0
        return ""
    end
    return idioma
end

# El cajón Catalogs junto al programa ("Work:Tachyon/Catalogs"; también en la raíz de un disco), creado si no está
func actualizar_catalogos(programa: String) -> String
    i = programa.length - 1
    while i >= 0 and str_code(programa, i) != 47 and str_code(programa, i) != 58
        i = i - 1
    end
    cajon = programa[:i + 1]
    if i >= 0 and str_code(programa, i) == 47
        cajon = programa[:i]
    end
    sep = "/"
    if cajon == "" or str_ends(cajon, ":")
        sep = ""
    end
    dir_create(cajon + sep + "Catalogs")
    return cajon + sep + "Catalogs"
end

# Baja el catálogo a Catalogs/Tachyon-<idioma>.new (sin esperar: http_avanzar hasta true y luego
# actualizar_catalogo_poner)
func actualizar_catalogo_bajar(url: String, cajon: String) -> Carga
    nuevo = cajon + "/Tachyon-" + actualizar_catalogo_idioma(url) + ".new"
    file_delete(nuevo)
    return http_volcar(http_empezar_a_fichero(url, nuevo, 30000))
end

# Lo bajado, si llegó bien (un catálogo: FORM con su LANG), en Catalogs/<idioma>/Tachyon.catalog en lugar del de
# antes; el idioma, el de dentro del catálogo ("español": el nombre publicado va sin acentos), o "" si no quedó puesto
func actualizar_catalogo_poner(c: Carga, url: String, cajon: String) -> String
    r = c.respuesta
    nuevo = cajon + "/Tachyon-" + actualizar_catalogo_idioma(url) + ".new"
    idioma = ""
    if r.error == "" and r.estado == 200 and file_size(nuevo) >= 12 and str_starts(file_read_text(nuevo), "FORM")
        idioma = actualizar_catalogo_lang(nuevo)
    end
    if idioma == "" or str_find(idioma, "/") >= 0 or str_find(idioma, ":") >= 0
        file_delete(nuevo)
        return ""
    end
    dir_create(cajon + "/" + idioma)
    destino = cajon + "/" + idioma + "/Tachyon.catalog"
    file_delete(destino)
    if not file_rename(nuevo, destino)
        file_delete(nuevo)
        return ""
    end
    return idioma
end

# El idioma de un catálogo (su trozo LANG: "español"), "" si no es un catálogo
func actualizar_catalogo_lang(fichero: String) -> String
    b = buffer_alloc(512)
    n = 0
    f = file_open(fichero, 1005)
    if f != 0
        n = file_read(f, b, 512)
        file_close(f)
    end
    idioma = ""
    if n >= 12 and str_from_buffer(b, 0, 4) == "FORM" and str_from_buffer(b, 8, 4) == "CTLG"
        i = 12
        while i + 8 <= n
            largo = (buffer_get_byte(b, i + 4) << 24) | (buffer_get_byte(b, i + 5) << 16) | (buffer_get_byte(b, i + 6) << 8) | buffer_get_byte(b, i + 7)
            if largo < 0
                break
            end
            if str_from_buffer(b, i, 4) == "LANG"
                k = 0
                while k < largo and k < 63 and i + 8 + k < n and buffer_get_byte(b, i + 8 + k) != 0
                    k = k + 1
                end
                idioma = str_from_buffer(b, i + 8, k)
                break
            end
            i = i + 8 + largo + (largo & 1)
        end
    end
    buffer_free(b)
    return idioma
end

# El idioma elegido el primero en las Preferencias de Locale ("español"), "" si no se sabe
func actualizar_idioma_preferido() -> String
    return locale_language()
end

# Un idioma como va en el nombre de un fichero publicado: sin acentos, que GitHub los cambia ("español": "espanol")
func actualizar_ascii(idioma: String) -> String
    # las letras con tilde de Latin-1 (sus códigos) y sus letras sin ella
    de = [192, 193, 194, 195, 196, 197, 199, 200, 201, 202, 203, 204, 205, 206, 207, 209, 210, 211, 212, 213, 214, 216, 217, 218, 219, 220, 221, 224, 225, 226, 227, 228, 229, 231, 232, 233, 234, 235, 236, 237, 238, 239, 241, 242, 243, 244, 245, 246, 248, 249, 250, 251, 252, 253, 255]
    a = "AAAAAACEEEEIIIINOOOOOOUUUUYaaaaaaceeeeiiiinoooooouuuuyy"
    r = ""
    i = 0
    while i < idioma.length and r.length < 61
        o = str_code(idioma, i)
        if o == 223
            r = r + "ss"
        elif o == 230
            r = r + "ae"
        elif o == 198
            r = r + "AE"
        elif o >= 128
            k = 0
            while k < de.length and de[k] != o
                k = k + 1
            end
            if k < de.length
                r = r + a[k:k + 1]
            end
        else
            r = r + idioma[i]
        end
        i = i + 1
    end
    return r
end

# Dónde está publicado el catálogo de una versión en un idioma (lo bajan las que se quedan sin el suyo)
func actualizar_catalogo_url(version: String, idioma: String) -> String
    return actualizar_descargas + "v" + version + "/Tachyon-" + actualizar_ascii(idioma) + ".catalog"
end

# El idioma de Locale como lo dicen las webs ("español": "es-ES"); "en-US" si no se conoce
func actualizar_idioma_web(idioma: String) -> String
    nombres = ["espanol", "catala", "euskara", "galego", "deutsch", "francais", "italiano", "portugues", "nederlands", "svenska", "dansk", "norsk", "suomi", "polski", "magyar", "turkce", "english", "american", "british"]
    codigos = ["es-ES", "ca-ES", "eu-ES", "gl-ES", "de-DE", "fr-FR", "it-IT", "pt-PT", "nl-NL", "sv-SE", "da-DK", "nb-NO", "fi-FI", "pl-PL", "hu-HU", "tr-TR", "en-GB", "en-US", "en-GB"]
    a = str_lower(actualizar_ascii(idioma))
    for i in (0..nombres.length - 1)
        if a == nombres[i]
            return codigos[i]
        end
    end
    return "en-US"
end

# Su Accept-Language, como Chrome ("es-ES": "es-ES,es;q=0.9,en;q=0.8")
func actualizar_idioma_cabecera(web: String) -> String
    base = str_split(web, "-")[0]
    if base == "en"
        return web + ",en;q=0.9"
    end
    return web + "," + base + ";q=0.9,en;q=0.8"
end

# Baja su Tachyon.gz a T: sin esperar
func actualizar_bajar(n: Novedad) -> Carga
    file_delete(ACTUALIZAR_GZ)
    return http_volcar(http_empezar_a_fichero(n.url, ACTUALIZAR_GZ, 30000))
end

# Dónde está el ejecutable que corre (su cajón y su nombre: "Work:Tachyon/Tachyon")
func actualizar_programa() -> String
    return program_path()
end

# El día de hoy (días desde 1978): para mirar como mucho una vez al día
func actualizar_hoy() -> Int
    return clock_days()
end

# Descomprime T:Tachyon.gz, lo comprueba y lo pone en lugar de programa (el de antes, como programa.old); 0 si
# quedó instalado o el número de por qué no (y el de antes sigue como estaba): actualizar_instalar
func _actualizar_instalar(programa: String) -> Int
    if programa == "" or programa.length > 300
        return 1
    end
    # el gzip entero en memoria
    n = file_size(ACTUALIZAR_GZ)
    if n < 0
        return 2
    end
    gz = 0
    if n > 18
        gz = buffer_alloc(n)
    end
    if gz == 0
        return 3
    end
    if file_load(ACTUALIZAR_GZ, gz, n) != n
        buffer_free(gz)
        return 3
    end
    if buffer_get_byte(gz, 0) != 31 or buffer_get_byte(gz, 1) != 139 or buffer_get_byte(gz, 2) != 8
        buffer_free(gz)
        return 4
    end
    crc_gz = _act_le32(gz, n - 8)
    isize = _act_le32(gz, n - 4)
    ex = 0
    if isize > 0
        ex = buffer_alloc(isize + 64)
    end
    if ex == 0
        buffer_free(gz)
        return 5
    end
    largo = inflate_auto(gz, n, ex, isize + 64)
    buffer_free(gz)
    e = _act_comprobar(ex, largo, isize, crc_gz)
    if e == 0
        e = _act_cambiar(programa, ex, largo)
    end
    buffer_free(ex)
    return e
end

# Un entero de 32 bits en little endian (el final de un gzip)
func _act_le32(b: Int, i: Int) -> Int
    return buffer_get_byte(b, i) | (buffer_get_byte(b, i + 1) << 8) | (buffer_get_byte(b, i + 2) << 16) | (buffer_get_byte(b, i + 3) << 24)
end

# Entero: su tamaño y su CRC-32 (el del gzip), un ejecutable y de Tachyon; 0 si está bien
func _act_comprobar(ex: Int, largo: Int, isize: Int, crc_gz: Int) -> Int
    if largo < 0
        return 5
    end
    if largo != isize or crc32(ex, largo, 0) != crc_gz
        return 6
    end
    if largo < 64 or buffer_get_byte(ex, 0) != 0 or buffer_get_byte(ex, 1) != 0 or buffer_get_byte(ex, 2) != 3 or buffer_get_byte(ex, 3) != 243
        return 7
    end
    if str_find(str_from_buffer(ex, 0, largo), "$VER: Tachyon ") < 0
        return 8
    end
    return 0
end

# programa.new, y luego el cambio: programa -> programa.old, programa.new -> programa
func _act_cambiar(programa: String, ex: Int, largo: Int) -> Int
    nuevo = programa + ".new"
    viejo = programa + ".old"
    f = file_open(nuevo, 1006)
    if f == 0
        return 9
    end
    ok = file_write(f, ex, largo) == largo
    file_close(f)
    if not ok
        file_delete(nuevo)
        return 10
    end
    file_delete(viejo)
    if not file_rename(programa, viejo)
        file_delete(nuevo)
        return 11
    end
    if not file_rename(nuevo, programa)
        file_rename(viejo, programa)
        file_delete(nuevo)
        return 12
    end
    file_delete(ACTUALIZAR_GZ)
    return 0
end

# Lo mismo con el porqué en texto ("" si quedó instalado)
func actualizar_instalar(programa: String) -> String
    porque = [tr(450, "can't tell where Tachyon is"), tr(451, "the download is missing"), tr(452, "can't read the download"), tr(453, "the download isn't a gzip"), tr(454, "can't decompress the download"), tr(455, "the download arrived damaged (CRC)"), tr(456, "the download isn't a program"), tr(457, "the download isn't Tachyon"), tr(458, "can't write in Tachyon's drawer"), tr(459, "the disk is full"), tr(460, "can't move the current Tachyon aside"), tr(461, "can't put the new one in place")]
    e = _actualizar_instalar(programa)
    if e == 0
        return ""
    end
    return porque[e - 1]
end

# Abre otra vez Tachyon (el nuevo) y sigue sin esperar; false si no se pudo
func actualizar_lanzar(programa: String) -> Bool
    if programa.length > 300
        return false
    end
    return run_program("\"" + programa + "\"")
end
