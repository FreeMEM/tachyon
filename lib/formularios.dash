# Formularios: lo que hace un clic en un control (marcar, elegir, dar el foco, enviar), una tecla en
# un campo de texto, y los datos de un formulario para enviarlo por GET. Los valores viven en el nodo (Nodo.valor y
# Nodo.marcado: dom_valor_campo y dom_marcado); los atributos value, checked y selected son los de partida.
#
#   r = formulario_clic(n)                     # FORM_NADA, FORM_CAMBIO (repintar), FORM_FOCO, FORM_ENVIAR
#   r = formulario_tecla(campo, caracter, raw) # FORM_CAMBIO o FORM_ENVIAR (Return)
#   r = formulario_pegar(campo, texto)         # FORM_CAMBIO o FORM_NADA; formulario_copiable(campo): lo que se copia
#   destino = formulario_destino(n, base)      # la dirección del envío por GET ("" si no hay <form>)
#   e = formulario_envio(n, base)              # GET o POST según el <form>: e.metodo, e.direccion, e.cuerpo

import "maqueta.dash"

const FORM_NADA = 0
const FORM_CAMBIO = 1
const FORM_FOCO = 2
const FORM_ENVIAR = 3

func formulario_de(n: Nodo) -> Nodo
    p = n
    while p != nil
        if p.tipo == DOM_ELEMENTO and p.nombre == "form"
            return p
        end
        p = p.padre
    end
    var nada: Nodo = nil
    return nada
end

# Un campo donde se escribe (input de texto, password, email..., textarea)
func formulario_es_texto(n: Nodo) -> Bool
    if n != nil and n.nombre == "textarea"
        return true
    end
    if n == nil or n.nombre != "input"
        return false
    end
    t = str_lower(dom_atributo(n, "type"))
    return t == "" or t == "text" or t == "password" or t == "email" or t == "search" or t == "url" or t == "tel" or t == "number"
end

func _form_es_boton_envio(n: Nodo) -> Bool
    t = str_lower(dom_atributo(n, "type"))
    if n.nombre == "button"
        return t == "" or t == "submit"
    end
    return n.nombre == "input" and (t == "submit" or t == "image")
end

func _form_poner(n: Nodo, nombre: String, valor: String)
    dom_olvidar_atributos(n)
    for a in n.atributos
        if a.nombre == nombre
            a.valor = valor
            return
        end
    end
    n.atributos.push(Atributo(nombre, valor))
end

func _form_quitar(n: Nodo, nombre: String)
    dom_olvidar_atributos(n)
    i = 0
    while i < n.atributos.length
        a = n.atributos[i]
        if a.nombre == nombre
            n.atributos.remove(i)
            return
        end
        i = i + 1
    end
end

func formulario_clic(n: Nodo) -> Int
    if n == nil or n.tipo != DOM_ELEMENTO or dom_tiene_atributo(n, "disabled")
        return FORM_NADA
    end
    t = str_lower(dom_atributo(n, "type"))
    if formulario_es_texto(n)
        return FORM_FOCO
    end
    if n.nombre == "input" and t == "checkbox"
        formulario_marcar(n, not dom_marcado(n))
        return FORM_CAMBIO
    end
    if n.nombre == "input" and t == "radio"
        formulario_marcar(n, true)
        return FORM_CAMBIO
    end
    if n.nombre == "select"
        # cada clic pasa a la opción siguiente (y de la última a la primera)
        var opciones: [Nodo] = []
        for o in n.hijos
            if o.tipo == DOM_ELEMENTO and o.nombre == "option"
                opciones.push(o)
            end
        end
        if opciones.length == 0
            return FORM_NADA
        end
        actual = formulario_opcion(n)
        siguiente = 0
        for i in (0..opciones.length - 1)
            if opciones[i] == actual
                siguiente = (i + 1) % opciones.length
            end
        end
        formulario_marcar(opciones[siguiente], true)
        return FORM_CAMBIO
    end
    if _form_es_boton_envio(n)
        return FORM_ENVIAR
    end
    return FORM_NADA
end

# Marca o desmarca n (checked de un input, selected de un option). Un radio marcado desmarca los de su grupo (el mismo
# name en el mismo <form>, o en el mismo árbol si no hay form); un option elegido, los otros de su <select> si no es
# multiple
func formulario_marcar(n: Nodo, si: Bool)
    if si
        n.marcado = 1
    else
        n.marcado = 2
    end
    dom_tocar(n)
    if not si
        return
    end
    if n.nombre == "input" and str_lower(dom_atributo(n, "type")) == "radio" and dom_atributo(n, "name") != ""
        form = formulario_de(n)
        raiz = form
        if raiz == nil
            raiz = n
            while raiz.padre != nil
                raiz = raiz.padre
            end
        end
        _form_desmarcar(raiz, n, dom_atributo(n, "name"), form)
    elif n.nombre == "option"
        s = n.padre
        if s != nil and s.nombre == "optgroup"
            s = s.padre
        end
        if s != nil and s.nombre == "select" and not dom_tiene_atributo(s, "multiple")
            _form_otras_opciones(s, n)
        end
    end
end

func _form_desmarcar(n: Nodo, menos: Nodo, nombre: String, form: Nodo)
    if n != menos and n.tipo == DOM_ELEMENTO and n.nombre == "input" and str_lower(dom_atributo(n, "type")) == "radio" and dom_atributo(n, "name") == nombre and formulario_de(n) == form and dom_marcado(n)
        n.marcado = 2
        dom_tocar(n)
    end
    for h in n.hijos
        _form_desmarcar(h, menos, nombre, form)
    end
end

func _form_otras_opciones(n: Nodo, menos: Nodo)
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO and h.nombre == "option" and h != menos and dom_marcado(h)
            h.marcado = 2
            dom_tocar(h)
        elif h.tipo == DOM_ELEMENTO and h.nombre == "optgroup"
            _form_otras_opciones(h, menos)
        end
    end
end

# El valor de un campo: el value de un input, el texto de un textarea, el de la opción elegida
func formulario_valor(n: Nodo) -> String
    if n.nombre == "textarea"
        return dom_texto(n)
    end
    if n.nombre == "select"
        o = formulario_opcion(n)
        if o == nil
            return ""
        end
        if dom_tiene_atributo(o, "value")
            return dom_atributo(o, "value")
        end
        return str_trim(dom_texto(o))
    end
    return dom_valor_campo(n)
end

func formulario_poner_valor(n: Nodo, v: String)
    if n.nombre == "textarea"
        var nadie: Nodo = nil
        for h in n.hijos
            h.padre = nadie
        end
        n.hijos.clear()
        if v != ""
            dom_agregar(n, dom_nodo(DOM_TEXTO, "", v))
        end
        return
    end
    if n.nombre == "select"
        for o in n.hijos
            if o.tipo == DOM_ELEMENTO and o.nombre == "option"
                ov = str_trim(dom_texto(o))
                if dom_tiene_atributo(o, "value")
                    ov = dom_atributo(o, "value")
                end
                if ov == v
                    formulario_marcar(o, true)
                else
                    formulario_marcar(o, false)
                end
            end
        end
        return
    end
    if dom_campo_modo_valor(n)
        n.valor = v
        dom_tocar(n)
    else
        _form_poner(n, "value", v)
    end
end

# Una tecla en un campo de texto: caracter (mui_canvas_char) y su código raw. Return envía (en un
# textarea, salta de línea).
func formulario_tecla(campo: Nodo, caracter: String, raw: Int) -> Int
    valor = formulario_valor(campo)
    if raw == 0x44 or raw == 0x43
        if campo.nombre == "textarea"
            formulario_poner_valor(campo, valor + "\n")
            return FORM_CAMBIO
        end
        return FORM_ENVIAR
    end
    if raw == 0x41
        if valor == ""
            return FORM_NADA
        end
        formulario_poner_valor(campo, valor[:valor.length - 1])
        return FORM_CAMBIO
    end
    if caracter.length == 1 and str_code(caracter, 0) >= 32 and str_code(caracter, 0) != 127
        maximo = Int(dom_atributo(campo, "maxlength"))
        if maximo > 0 and valor.length >= maximo
            return FORM_NADA
        end
        formulario_poner_valor(campo, valor + caracter)
        return FORM_CAMBIO
    end
    return FORM_NADA
end

# Pegar texto (Latin-1) al final de un campo: en un input solo la primera línea, en un textarea todo (sin los \r de
# los saltos de PC); lo que no quepa en su maxlength se queda fuera
func formulario_pegar(campo: Nodo, texto: String) -> Int
    t = str_replace(str_replace(texto, "\r\n", "\n"), "\r", "\n")
    if campo.nombre != "textarea"
        i = str_find(t, "\n")
        if i >= 0
            t = t[:i]
        end
    end
    valor = formulario_valor(campo)
    maximo = Int(dom_atributo(campo, "maxlength"))
    if maximo > 0
        sitio = maximo - valor.length
        if sitio <= 0
            return FORM_NADA
        end
        if t.length > sitio
            t = t[:sitio]
        end
    end
    if t == ""
        return FORM_NADA
    end
    formulario_poner_valor(campo, valor + t)
    return FORM_CAMBIO
end

# Lo que se copia de un campo: todo su texto (no hay selección dentro de los campos); "" en uno de contraseña, que
# los navegadores no dejan copiar ni cortar
func formulario_copiable(campo: Nodo) -> String
    if campo.nombre == "input" and str_lower(dom_atributo(campo, "type")) == "password"
        return ""
    end
    return formulario_valor(campo)
end

# Los datos del formulario (nombre=valor&...) como application/x-www-form-urlencoded; el botón que lo
# envía cuenta si tiene nombre
func formulario_datos(form: Nodo, enviado_por: Nodo) -> String
    var partes: [String] = []
    _form_recoger(form, enviado_por, partes)
    r = ""
    for p in partes
        if r != ""
            r = r + "&"
        end
        r = r + p
    end
    return r
end

func _form_recoger(n: Nodo, enviado_por: Nodo, partes: [String])
    if n.tipo != DOM_ELEMENTO
        return
    end
    nombre = dom_atributo(n, "name")
    if nombre != "" and not dom_tiene_atributo(n, "disabled")
        t = str_lower(dom_atributo(n, "type"))
        if n.nombre == "input"
            if t == "checkbox" or t == "radio"
                if dom_marcado(n)
                    v = "on"
                    if dom_tiene_atributo(n, "value")
                        v = dom_atributo(n, "value")
                    end
                    partes.push(url_codificar(nombre) + "=" + url_codificar(v))
                end
            elif t == "submit" or t == "image" or t == "button" or t == "reset"
                if n == enviado_por
                    partes.push(url_codificar(nombre) + "=" + url_codificar(formulario_etiqueta(n)))
                end
            else
                partes.push(url_codificar(nombre) + "=" + url_codificar(dom_valor_campo(n)))
            end
        elif n.nombre == "button"
            if n == enviado_por
                partes.push(url_codificar(nombre) + "=" + url_codificar(dom_atributo(n, "value")))
            end
        elif n.nombre == "select"
            o = formulario_opcion(n)
            if o != nil
                v = str_trim(dom_texto(o))
                if dom_tiene_atributo(o, "value")
                    v = dom_atributo(o, "value")
                end
                partes.push(url_codificar(nombre) + "=" + url_codificar(v))
            end
        elif n.nombre == "textarea"
            partes.push(url_codificar(nombre) + "=" + url_codificar(dom_texto(n)))
        end
    end
    if n.nombre == "select"
        return
    end
    for h in n.hijos
        _form_recoger(h, enviado_por, partes)
    end
end

# La dirección a la que se envía por GET el formulario de desde (un botón o un campo): su action (o la
# página) con los datos como consulta; "" si desde no está en un <form>
func formulario_destino(desde: Nodo, base: String) -> String
    form = formulario_de(desde)
    if form == nil
        return ""
    end
    accion = str_trim(dom_atributo(form, "action"))
    u = url_parse(base)
    if accion != ""
        u = url_resolve(u, accion)
    end
    destino = url_text(u)
    p = str_find(destino, "#")
    if p >= 0
        destino = destino[:p]
    end
    p = str_find(destino, "?")
    if p >= 0
        destino = destino[:p]
    end
    enviado_por = desde
    if formulario_es_texto(desde)
        var nadie: Nodo = nil
        enviado_por = nadie
    end
    return destino + "?" + formulario_datos(form, enviado_por)
end

struct Envio
    metodo: String       # "GET" o "POST"
    direccion: String    # con GET, ya con los datos como consulta
    cuerpo: String       # con POST, los datos (application/x-www-form-urlencoded)
end

# El envío del formulario de desde según su method; direccion "" si desde no está en un <form>
func formulario_envio(desde: Nodo, base: String) -> Envio
    form = formulario_de(desde)
    if form == nil
        return Envio("GET", "", "")
    end
    if str_lower(str_trim(dom_atributo(form, "method"))) != "post"
        return Envio("GET", formulario_destino(desde, base), "")
    end
    accion = str_trim(dom_atributo(form, "action"))
    u = url_parse(base)
    if accion != ""
        u = url_resolve(u, accion)
    end
    destino = url_text(u)
    p = str_find(destino, "#")
    if p >= 0
        destino = destino[:p]
    end
    enviado_por = desde
    if formulario_es_texto(desde)
        var nadie: Nodo = nil
        enviado_por = nadie
    end
    return Envio("POST", destino, formulario_datos(form, enviado_por))
end

