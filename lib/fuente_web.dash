# Fuentes de la web (@font-face, tarea 31h): un TTF (o OTF con contornos TrueType, o un WOFF 1.0 o 2.0 de ellos) hecho TextFont del Amiga en
# memoria, con stb_truetype (el builtin font_from_ttf de Dash 2.0, que lleva el C que antes iba aquí). Los caracteres de
# Latin-1 (32-255, los mismos puntos de Unicode) a un tamaño dado (el font-size: el em), en un plano de 1 bit
# (sin suavizado: el pintor del Amiga pinta así). Lo devuelto vale para font_use, font_text_width... de Dash.
#
#   f = fuente_web("T:fuente.ttf", 16)     # 0 si no se puede
#   font_use(f)
#   fuente_web_liberar(f)                  # (nunca con font_close)

import "css.dash"

# El TextFont de la fuente del fichero a tam px (el em); 0 si no se puede leer o no es una fuente TrueType. La
# fuente leída (y sacada del WOFF/WOFF2) se guarda para los demás tamaños (tarea 37e6: Brotli y rehacer glyf con
# cada tamaño costaba un 3 % del tiempo al bajar por pre.opentimetrack.com); fuente_web_olvidar la suelta.
func fuente_web(fichero: String, tam: Int) -> Int
    return fuente_web_ancha(fichero, tam, 100)
end

# Lo mismo con las letras a ancho % de su anchura (font-stretch; tarea 37h)
func fuente_web_ancha(fichero: String, tam: Int, ancho: Int) -> Int
    return font_from_ttf(fichero, tam, ancho)
end

# Un icono de una fuente de la página (el carácter codigo, de la zona privada de Unicode: los de Xataka, tarea 42g)
# como la "A" de una fuente de Amiga a tam px: 0 si ninguna familia de la lista tiene fuente o no la tiene
func fuente_web_icono(familias: String, tam: Int, codigo: Int) -> Int
    fichero = _fuente_web_fichero(familias, 400, "normal")
    if fichero == "" or codigo <= 0
        return 0
    end
    if _fuentes_web_hechas == nil
        var h: {String: Int} = {}
        _fuentes_web_hechas = h
    end
    clave = fichero + "|" + tam + "|i" + codigo
    if not _fuentes_web_hechas.has(clave)
        _fuentes_web_hechas[clave] = font_ttf_icon(fichero, tam, codigo)
    end
    return _fuentes_web_hechas[clave]
end

# Olvida la fuente guardada de ese fichero (se registra otra con el mismo nombre: otra página)
func fuente_web_olvidar(fichero: String)
    font_ttf_forget(fichero)
end

func fuente_web_liberar(f: Int)
    font_ttf_free(f)
end

# === Las fuentes de la página (lib/imagenes.dash las registra al llegar; la maqueta las pide) ===

# "familia|peso|estilo" -> el fichero bajado
var fuentes_web: {String: String} = nil
# "fichero|tamaño" -> la fuente hecha a ese tamaño (0: no se pudo)
var _fuentes_web_hechas: {String: Int} = nil
# cambia con cada fuente registrada (la maqueta guarda lo elegido por font-family y tamaño: con otra versión
# vuelve a elegir)
var fuentes_web_version: Int = 0

func fuente_web_registrar(clave: String, fichero: String)
    # (el mismo fichero puede ser otra fuente: otra página usa los mismos nombres; las hechas antes no se sueltan,
    # que una página de antes aún puede pintarlas)
    fuente_web_olvidar(fichero)
    if _fuentes_web_hechas != nil
        var fuera: [String] = []
        for k in _fuentes_web_hechas.keys()
            if str_starts(k, fichero + "|")
                fuera.push(k)
            end
        end
        for k in fuera
            _fuentes_web_hechas.remove(k)
        end
    end
    if fuentes_web == nil
        var f: {String: String} = {}
        fuentes_web = f
    end
    fuentes_web[clave] = fichero
    fuentes_web_version = fuentes_web_version + 1
end

# La fuente de la web para un font-family (la primera familia de la lista que tenga alguna, con el peso más
# cercano a peso y, si hay, del mismo estilo) a tam px; 0 si ninguna
func fuente_web_para(familias: String, peso: Int, estilo: String, tam: Int) -> Int
    return fuente_web_para_ancha(familias, peso, estilo, tam, 100)
end

# Lo mismo con font-stretch: ancho en % (100: normal)
func fuente_web_para_ancha(familias: String, peso: Int, estilo: String, tam: Int, ancho: Int) -> Int
    fichero = _fuente_web_fichero(familias, peso, estilo)
    if fichero == ""
        return 0
    end
    if _fuentes_web_hechas == nil
        var h: {String: Int} = {}
        _fuentes_web_hechas = h
    end
    clave = fichero + "|" + tam + "|" + ancho
    if not _fuentes_web_hechas.has(clave)
        _fuentes_web_hechas[clave] = fuente_web_ancha(fichero, tam, ancho)
    end
    return _fuentes_web_hechas[clave]
end

# El fichero de la fuente de la web para un font-family (la primera familia de la lista que tenga alguna, con el peso
# más cercano y, si hay, del mismo estilo); "" si ninguna
func _fuente_web_fichero(familias: String, peso: Int, estilo: String) -> String
    if fuentes_web == nil or fuentes_web.length == 0
        return ""
    end
    for parte in css_partir(familias, 44)
        familia = str_lower(str_trim(str_replace(str_replace(parte, "\"", ""), "'", "")))
        mejor = ""
        distancia = 100000
        for k in fuentes_web.keys()
            if str_starts(k, familia + "|")
                trozos = css_partir(k, 124)
                d = Int(trozos[1]) - peso
                if d < 0
                    d = 0 - d
                end
                if trozos[2] != estilo
                    d = d + 1000
                end
                if d < distancia
                    distancia = d
                    mejor = k
                end
            end
        end
        if mejor != ""
            return fuentes_web[mejor]
        end
    end
    return ""
end
