# HTML5 de verdad con Hubbub (el analizador de NetSurf, third_party/hubbub; tarea 36): el árbol del documento
# como lo construyen los navegadores, con las reglas de HTML5 (etiquetas mal anidadas, lo que sobra dentro de una
# tabla, los modos de inserción) y las 2231 entidades.
#
#   doc = dom_desde_html5(texto)      # el texto en Latin-1, como dom_desde_html; el mismo tipo de árbol
#
# Hubbub construye el árbol llamando a funciones nuestras (crear un elemento, añadir un hijo, mover los hijos...).
# Aquí el lado de C guarda ese árbol con números de nodo (y nada de punteros de C llega al DOM) y al acabar Dash
# lo copia a Nodos de lib/dom.dash. Si Hubbub no puede (sin memoria), se usa dom_desde_html.

import "dom.dash"

@link "../build/img-lib/libimg.a"
@link "../build/pegamento-lib/libpegamento.a"


# El árbol de Hubbub del texto (Latin-1, o los bytes UTF-8 tal cual con utf8); 0 si no se pudo
@extern("html5") func _h5_analizar(texto: String, utf8: Bool) -> Int

@extern("html5") func _h5_liberar(h: Int)

@extern("html5") func _h5_tipo(h: Int, id: Int) -> Int

@extern("html5") func _h5_nombre(h: Int, id: Int) -> String

# (los textos y valores salen como textos de Dash, copiados: uno de C de 64 o más se mediría entero en cada
# str_code, y el script de React de pre.opentimetrack.com, 26 KB, tardaba 7 s en pasar a Latin-1; D61)
@extern("html5") func _h5_texto_de(h: Int, id: Int) -> String

@extern("html5") func _h5_nhijos(h: Int, id: Int) -> Int

@extern("html5") func _h5_hijo(h: Int, id: Int, i: Int) -> Int

@extern("html5") func _h5_natributos(h: Int, id: Int) -> Int

@extern("html5") func _h5_atr_nombre(h: Int, id: Int, i: Int) -> String

@extern("html5") func _h5_atr_valor(h: Int, id: Int, i: Int) -> String

@extern("html5") func _h5_doctype_de(h: Int) -> String

# El modo de la página según su doctype: 0 estándar, 1 casi estándar, 2 quirks (las páginas viejas sin doctype)
@extern("html5") func _h5_modo_de(h: Int) -> Int

# El árbol del documento con las reglas de HTML5 (o el de dom_desde_html si Hubbub no puede)
func dom_desde_html5(texto: String) -> Nodo
    return _dom_desde_html5(texto, false)
end

# Lo mismo desde los bytes UTF-8 de la página tal cual (tarea 37a4): el DOM sale en Latin-1 como siempre, pero el
# texto de los <script> conserva lo que no cabe en Latin-1 como \uXXXX (utf8_a_js)
func dom_desde_html5_utf8(bytes: String) -> Nodo
    return _dom_desde_html5(bytes, true)
end

func _dom_desde_html5(texto: String, utf8: Bool) -> Nodo
    h = _h5_analizar(texto, utf8)
    if h == 0
        if utf8
            return dom_desde_html(utf8_a_latin1(texto))
        end
        return dom_desde_html(texto)
    end
    doc = dom_nodo(DOM_DOCUMENTO, "#document", "")
    doc.texto = _h5_doctype_de(h)
    # (lib/estilo.dash lo mira: en modo estándar una longitud sin unidad no vale; tarea 41a)
    if _h5_modo_de(h) == 2
        doc.atributos.push(Atributo("modo", "quirks"))
    end
    _h5_copiar(h, 1, doc)
    _h5_liberar(h)
    return doc
end

func _h5_copiar(h: Int, id: Int, padre: Nodo)
    n = _h5_nhijos(h, id)
    i = 0
    while i < n
        c = _h5_hijo(h, id, i)
        t = _h5_tipo(h, c)
        if t == DOM_ELEMENTO
            e = dom_nodo(DOM_ELEMENTO, _h5_nombre(h, c), "")
            k = _h5_natributos(h, c)
            j = 0
            while j < k
                e.atributos.push(Atributo(_h5_atr_nombre(h, c, j), utf8_a_latin1(_h5_atr_valor(h, c, j))))
                j = j + 1
            end
            dom_agregar(padre, e)
            _h5_copiar(h, c, e)
        elif t == DOM_TEXTO and padre.nombre == "script"
            dom_agregar(padre, dom_nodo(t, "", utf8_a_js(_h5_texto_de(h, c))))
        elif t == DOM_TEXTO or t == DOM_COMENTARIO
            dom_agregar(padre, dom_nodo(t, "", utf8_a_latin1(_h5_texto_de(h, c))))
        elif t == DOM_TIPO_DOC
            ids = str_split(utf8_a_latin1(_h5_texto_de(h, c)), "\n")
            if ids.length == 2
                dom_agregar(padre, dom_tipo_doc(_h5_nombre(h, c), ids[0], ids[1]))
            end
        end
        i = i + 1
    end
end
