# Imágenes decodificadas por dashweb (tarea 29), sin los datatypes (con Dash 2.0, los builtins image_decode*, que
# llevan el C que antes iba aquí): JPEG con TJpgDec (third_party/tjpgd),
# que decodifica ya reducido a 1/2, 1/4 o 1/8; WebP (con y sin pérdida, con alfa; no animado) con el
# decodificador de libwebp (third_party/libwebp), que también reduce al decodificar; JPEG progresivo, PNG,
# GIF y BMP con stb_image (third_party/stb), reducidos después; SVG con nanosvg (third_party/nanosvg),
# dibujado al tamaño en que se ve (sin él, a su tamaño). El resultado pasa a la pantalla con image_from_rgb de Dash
# (picture.datatype V43: AmigaOS 3.5+).
#
#   img = imagen_decodificar("T:foto.jpg", 1280, 1024)   # 0 si no se puede: entonces image_load
#
# Una imagen más grande que ancho x alto se reduce hasta caber (para no gastar memoria ni tiempo en
# píxeles que no se van a ver); la proporción se guarda.

# La imagen del fichero decodificada aquí (cabe en maxw x maxh, reducida si es más grande); 0 si el
# formato no es de estos o picture.datatype es anterior a V43
func imagen_decodificar(fichero: String, maxw: Int, maxh: Int) -> Int
    return _imgdec_imagen(_imgdec(fichero, maxw, maxh), -1)
end

# imagen_decodificar teñida (tinte: 0xRRGGBB)
func imagen_decodificar_tinte(fichero: String, maxw: Int, maxh: Int, tinte: Int) -> Int
    return _imgdec_imagen(_imgdec(fichero, maxw, maxh), tinte)
end

# image_decode con los tamaños de Tachyon: 1280x1024 o más es "no se sabe a qué tamaño se ve" (un tope: un SVG va a
# su tamaño); menos, el tamaño al que se ve (un SVG se dibuja para cubrirlo)
func _imgdec(fichero: String, maxw: Int, maxh: Int) -> Int
    if maxw >= 1280 and maxh >= 1024
        return image_decode(fichero, -maxw, -maxh)
    end
    return image_decode(fichero, maxw, maxh)
end

# La imagen de pantalla de lo decodificado (teñido si tinte >= 0), que se libera; 0 si d es 0
func _imgdec_imagen(d: Int, tinte: Int) -> Int
    if d == 0
        return 0
    end
    if tinte >= 0
        _imgdec_tenir(d, tinte)
    end
    img = image_from_decoded(d)
    image_decoded_free(d)
    return img
end

# Todos los píxeles del color rgb, con su transparencia (una máscara de mask-image teñida con el fondo del elemento)
func _imgdec_tenir(d: Int, rgb: Int)
    k = 3
    if image_decoded_alpha(d)
        k = 4
    end
    r = (rgb >> 16) & 255
    g = (rgb >> 8) & 255
    b = rgb & 255
    p = image_decoded_pixels(d)
    fin = p + image_decoded_width(d) * image_decoded_height(d) * k
    while p < fin
        buffer_set_byte(p, 0, r)
        buffer_set_byte(p, 1, g)
        buffer_set_byte(p, 2, b)
        p = p + k
    end
end

# === En otro proceso (la ventana sigue respondiendo mientras) ===

struct Decodificando
    tarea: Int
    tinte: Int = -1     # una máscara (mask-image): todos los píxeles de este color (0xRRGGBB), con su transparencia
end

# Empieza a decodificar el fichero en otro proceso, con prioridad -1 (avanza cuando el programa espera);
# nil si no se pudo empezar (entonces, imagen_decodificar)
func imagen_empezar(fichero: String, maxw: Int, maxh: Int) -> Decodificando
    var nada: Decodificando = nil
    w = maxw
    h = maxh
    if maxw >= 1280 and maxh >= 1024
        w = -maxw
        h = -maxh
    end
    t = image_decode_start(fichero, w, h)
    if t == 0
        return nada
    end
    return Decodificando(t)
end

# ¿Ya ha terminado? (no espera)
func imagen_lista(d: Decodificando) -> Bool
    return image_decode_ready(d.tarea)
end

# La imagen (como imagen_decodificar: 0 si el formato no es de estos, o si picture.datatype es anterior a
# V43); espera si aún no ha terminado
func imagen_acabar(d: Decodificando) -> Int
    return _imgdec_imagen(_imagen_terminar(d), d.tinte)
end

# Lo decodificado por la tarea (0 si nada), con la tarea ya liberada
func _imagen_terminar(d: Decodificando) -> Int
    r = image_decode_finish(d.tarea)
    d.tarea = 0
    return r
end

# Para las pruebas, como imagen_probar con lo que decodificó la tarea
func imagen_acabar_probar(d: Decodificando, x: Int, y: Int) -> String
    return _imgdec_texto(_imagen_terminar(d), x, y)
end

# Para las pruebas: "ancho x alto alfa=0/1 r,g,b" del píxel (x, y) de lo decodificado (sin pasarlo a la
# pantalla); "no" si no se puede
func imagen_probar(fichero: String, maxw: Int, maxh: Int, x: Int, y: Int) -> String
    return _imgdec_texto(_imgdec(fichero, maxw, maxh), x, y)
end

# (y lo libera)
func _imgdec_texto(d: Int, x: Int, y: Int) -> String
    if d == 0
        return "no"
    end
    w = image_decoded_width(d)
    k = 3
    if image_decoded_alpha(d)
        k = 4
    end
    p = image_decoded_pixels(d) + (y * w + x) * k
    r = "" + w + "x" + image_decoded_height(d) + " alfa=" + image_decoded_alpha(d) + " " + buffer_get_byte(p, 0) + "," + buffer_get_byte(p, 1) + "," + buffer_get_byte(p, 2)
    if k == 4
        r = r + "," + buffer_get_byte(p, 3)
    end
    image_decoded_free(d)
    return r
end
