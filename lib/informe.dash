# El informe de depuración (tarea 54): cuando algo falla, el usuario lo manda desde Tachyon (menú Proyecto, "Enviar
# informe de depuración...", la página tachyon:informe) a https://tachyon.freemem.space/informe, que contesta con un
# código para citarlo en la incidencia de GitHub (el receptor: herramientas/servidor/tachyon_informes.py de
# FreeMEM/webs-freemem).
#
#   t = informe_texto("0.7.4-alfa", http_idiomas, "https://ejemplo.com/a")   # versiones, memoria y el registro
#   h = informe_html(t)                                # la página que lo enseña entero, con el botón de enviar
#
# Lleva solo lo que la página enseña: las versiones del sistema, la memoria y el registro de lib/js.dash (las
# páginas abiertas, sin lo que va tras "?" ni "#", y lo que dijo su JavaScript). Ni cookies ni lo escrito en los
# formularios. Nada sale sin que el usuario pulse el botón.

import "js.dash"
import "idioma.dash"

const INFORME_DIRECCION = "https://tachyon.freemem.space/informe"

# Una dirección sin lo que puede llevar datos de quien la abre: usuario y contraseña, lo que va tras "?" y tras "#"
func informe_sin_parametros(direccion: String) -> String
    d = direccion
    p = str_find(d, "#")
    if p >= 0
        d = d[:p]
    end
    p = str_find(d, "?")
    if p >= 0
        d = d[:p] + "?..."
    end
    p = str_find(d, "://")
    if p >= 0
        resto = d[p + 3:]
        fin = str_find(resto, "/")
        if fin < 0
            fin = resto.length
        end
        arroba = str_find(resto[:fin], "@")
        if arroba >= 0
            d = d[:p + 3] + resto[arroba + 1:]
        end
    end
    return d
end

# El sistema: Kickstart, Workbench, CPU y FPU, MUI, gráficos, red, AmiSSL y la memoria
func _informe_sistema() -> String
    cpu = cpu_model()
    f = fpu_model()
    fpu = "no"
    if f != 0
        fpu = "" + f
    end
    morphos = ""
    if resident_version("MorphOS") >= 0
        morphos = " (MorphOS)"
    end
    rtg = _informe_lib("Picasso96API.library")
    if rtg == "no"
        rtg = _informe_lib("cybergraphics.library")
        if rtg != "no"
            rtg = "CyberGraphX " + rtg
        end
    else
        rtg = "Picasso96 " + rtg
    end
    wb = _informe_lib("version.library")
    if wb == "no"
        wb = "?"
    end
    return "System: exec " + _informe_lib("exec.library") + ", Workbench " + wb + morphos + "\nCPU: " + cpu + ", FPU " + fpu +
           "\nMUI: " + _informe_lib("muimaster.library") + "\nGraphics card: " + rtg + "\nbsdsocket.library: " +
           _informe_lib("bsdsocket.library") + "\nAmiSSL: " + _informe_lib("amisslmaster.library") + "\nMemory: chip " +
           mem_chip_free() / 1024 + " KB free, fast " + mem_fast_free() / 1024 + " KB free, largest block " +
           mem_largest() / 1024 + " KB"
end

# "versión.revisión" de una librería, "no" si no está
func _informe_lib(nombre: String) -> String
    v = library_version(nombre)
    if v < 0
        return "no"
    end
    return "" + v + "." + library_revision(nombre)
end

# El informe entero: Tachyon, el sistema, el idioma, la última página y el registro
func informe_texto(version: String, idioma: String, pagina: String) -> String
    t = "Tachyon " + version + "\n" + _informe_sistema() + "\nLanguage: " + idioma + "\n"
    if pagina != ""
        t = t + "Last page: " + informe_sin_parametros(pagina) + "\n"
    end
    registro = registro_texto()
    if registro == ""
        registro = "(empty)\n"
    end
    return t + "\n--- log ---\n" + registro
end

func _informe_escapar(t: String) -> String
    return str_replace(str_replace(str_replace(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

# La página tachyon:informe: qué es, lo que se va a mandar entero y el botón (un formulario a tachyon:informe?enviar)
func informe_html(texto: String) -> String
    h = "<html><head><title>" + tr(471, "Debug report") + "</title><style>body { font-family: sans-serif; margin: 12px } "
    h = h + "h1 { color: #036 } pre { background: #eef2fb; border: 1px solid #d5ddef; padding: 8px; font-size: 12px; white-space: pre-wrap } "
    h = h + "button { padding: 6px 16px; font-weight: bold }</style></head><body>"
    h = h + "<h1>" + tr(471, "Debug report") + "</h1>"
    h = h + "<p>" + tr(472, "If Tachyon does something wrong, this report helps to find out why. Nothing is sent until you press the button. It carries the versions of Tachyon and of the system, the memory, and the last things Tachyon noted down: the pages you opened (without what comes after ? in their address) and what their JavaScript said. No cookies, passwords or anything typed in forms.") + "</p>"
    h = h + "<form action=\"tachyon:informe\" method=get><input type=hidden name=enviar value=1>"
    h = h + "<button type=submit>" + tr(473, "Send the report") + "</button></form>"
    h = h + "<p>" + hueco(tr(474, "You will get a code: put it in the issue you open at %1, and say what you were doing and what happened."), "<a href=\"https://github.com/FreeMEM/tachyon/issues\">github.com/FreeMEM/tachyon/issues</a>") + "</p>"
    h = h + "<p>" + tr(475, "This is everything that will be sent:") + "</p>"
    return h + "<pre>" + _informe_escapar(texto) + "</pre></body></html>"
end
