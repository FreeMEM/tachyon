# JavaScript con QuickJS (third_party/quickjs, como librería: tools/build_qjs.sh lib).
#
#   js = js_nuevo()                              # 0 si no hay memoria
#   r = js_evaluar(js, "1 + 2", "prueba.js")     # el resultado como texto ("3")
#   if js_error(js) != ""                        # la excepción de la última evaluación, o ""
#       Print js_error(js)
#   end
#   js_liberar(js)
#
# console.log (y error, warn, info) escribe en la salida del programa y en el registro de depuración
# (registro_anotar, registro_texto). Los textos de Dash son Latin-1 y los de QuickJS UTF-8: se convierten al
# entrar y al salir ("?" lo que no cabe).
# QuickJS pide mucha pila: el programa que importa este módulo arranca con 256 KB.

@link "../build/pegamento-lib/libpegamento.a"
@link "../build/qjs-lib/libqjs.a"
@stack 262144




# El perfil por muestras del JavaScript (solo con QuickJS y dashweb compilados con -DJS_PERFIL: tools/build_qjs.sh
# lib -DJS_PERFIL y DASH_CFLAGS=-DJS_PERFIL): las funciones que más pesan, por la salida
@extern("js") func js_perfil_volcar(js: Int, cuantas: Int)

# Un motor nuevo con su contexto y console; 0 si no hay memoria
@extern("js") func js_nuevo() -> Int

# Ejecuta el código (Latin-1) como un script; el resultado como texto ("undefined" si no da
# nada). Si salta una excepción, da "" y js_error la cuenta.
@extern("js") func js_evaluar(js: Int, codigo: String, nombre: String) -> String

# js_evaluar con un código que ya está en UTF-8 (un script de fuera, tal como llegó): sin pasarlo de Latin-1 a UTF-8,
# así que sin copiarlo (el de YouTube son 10,8 MB; con 128 MB no había otro hueco así; tarea 38c8)
@extern("js") func js_evaluar_utf8(js: Int, codigo: String, nombre: String) -> String

# Los ms que tardó en compilarse el último código de js_evaluar (el resto, hasta lo que tardó entera, es ejecutarlo)
@extern("js") func js_ms_compilar() -> Int

# Lo mismo para un código que se ejecuta igual en cada motor (el preludio de lib/jsdom_preludio.js, 110 KB): se compila
# una vez y su bytecode se guarda, en memoria y (si sobra memoria) en T:tachyon_preludio.bc; los demás motores, y los
# programas que vengan después, lo leen sin analizarlo otra vez (en el 68020 de las pruebas, analizar el preludio era
# casi todo lo que tardaba en crearse un documento con JavaScript; tarea 38). Si el código cambia, se compila otra vez. (Un
# bytecode hecho en el PC no lo lee bien el 68k: QuickJS abortaba.)
@extern("js") func js_evaluar_guardado(js: Int, codigo: String, nombre: String) -> String

# Para buscar fallos de referencias: el recolector de ciclos tras cada script, llamada y trabajo (lento)
@extern("js") func js_gc_siempre(si: Bool)

# ¿Se cortó algún script por pasar de js_tope segundos desde la última vez que se preguntó? (tarea 40c)
# Al registro de depuración (lo de arriba, _registro): una línea, sin escribirla en la salida
@extern("js") func registro_anotar(texto: String)

# A la salida y al registro
func registro_decir(texto: String)
    Print texto
    registro_anotar(texto)
end

# Lo que hay en el registro, de lo más antiguo a lo último (sin la primera línea, a medias, si ya dio la vuelta)
@extern("js") func registro_texto() -> String

@extern("js") func js_cortado() -> Bool

# Los segundos que puede durar un script, una llamada o un trabajo antes de cortarlo (0: sin tope; por omisión 30)
@extern("js") func js_tope(segundos: Int)

# Con 1, el JavaScript suelta la CPU un tic cada 100 ms (mientras se decodifican imágenes en otro proceso, que si
# no apenas avanzan: lib/imagenes.dash)
@extern("js") func js_ceder(si: Int)

# Bytes que usa ahora el JavaScript de este motor (lo que ha pedido a malloc)
@extern("js") func js_memoria(js: Int) -> Int

# Otro tope de memoria para el JavaScript de este motor (por omisión dos tercios de la memoria libre, de 48 a 256 MB): pasado, sus scripts
# reciben "out of memory"
@extern("js") func js_limite(js: Int, bytes: Int)

# La excepción de la última evaluación (mensaje y pila), o ""
@extern("js") func js_error(js: Int) -> String

@extern("js") func js_liberar(js: Int)
