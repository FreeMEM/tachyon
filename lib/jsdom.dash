# El DOM para el JavaScript de una página (QuickJS, lib/js.dash): document, getElementById,
# querySelector(All) con los selectores de lib/css.dash, textContent, innerHTML, atributos,
# createElement, appendChild, removeChild... sobre el árbol de lib/dom.dash.
#
#   js = js_nuevo()
#   jsdom_preparar(js, doc)                     # document = doc, eventos y temporizadores
#   jsdom_ejecutar_scripts(js, doc, base)       # los <script> en orden (en línea y src)
#   if jsdom_cambios(js) > 0 ...                # cuántas veces lo cambió el JS (para volver a maquetar)
#   seguir = jsdom_clic(js, nodo)               # evento click (sube hasta document); false: preventDefault
#   espera = jsdom_temporizadores(js)           # los setTimeout/setInterval que tocan; ms al siguiente, -1 si no hay
#   js_liberar(js)                              # suelta también los nodos que tenía el JS
#
# Cada nodo tiene un solo objeto JS (a === b funciona); el objeto sujeta su Nodo hasta js_liberar.
# Los textos van en Latin-1 hacia Dash y en UTF-8 hacia el JS, como en lib/js.dash.

import "js.dash"
import "estilo.dash"
import "formularios.dash"
import "jsdom_preludio.dash"
import "lienzo.dash"
import "traza.dash"

# === La parte en Dash (la llaman las funciones de C de abajo) ===

func jsdom_por_id(doc: Nodo, id: String) -> Nodo
    return dom_por_id(doc, id)
end

# Los elementos de dentro de raiz (sin ella) que cumplen el selector (con comas); el primero solo
# si no son todos. Un selector que no se entiende no da ninguno.
func jsdom_selector(raiz: Nodo, texto: String, todos: Bool) -> [Nodo]
    var r: [Nodo] = []
    var sels: [Selector] = []
    for t in css_partir(texto, 44)
        if str_trim(t) != ""
            sels.push(css_selector(str_trim(t)))
        end
    end
    for h in raiz.hijos
        if _jsdom_buscar(h, sels, todos, r)
            return r
        end
    end
    return r
end

# true cuando ya no hace falta seguir (encontró uno y no se buscan todos)
func _jsdom_buscar(n: Nodo, sels: [Selector], todos: Bool, r: [Nodo]) -> Bool
    if n.tipo != DOM_ELEMENTO
        return false
    end
    for s in sels
        if estilo_cumple(n, s)
            r.push(n)
            if not todos
                return true
            end
            break
        end
    end
    for h in n.hijos
        if _jsdom_buscar(h, sels, todos, r)
            return true
        end
    end
    return false
end

func jsdom_texto(n: Nodo) -> String
    return dom_texto(n)
end

# textContent = t: los hijos se cambian por un texto
func jsdom_poner_texto(n: Nodo, t: String)
    if n.tipo == DOM_TEXTO or n.tipo == DOM_COMENTARIO
        n.texto = t
        # su elemento cambia de contenido (un reloj de React: sin estilo entero, y si no cambia de forma, sin maqueta;
        # lo medido en él y en los de fuera ya no vale: tarea 37e6)
        dom_tocar(n)
        if n.tipo == DOM_TEXTO and n.padre != nil and n.padre.tipo == DOM_ELEMENTO
            dom_apuntar(n.padre, TOQUE_CONTENIDO, "#texto", "", "")
        end
        return
    end
    solo_texto = _jsdom_sin_elementos(n)
    _jsdom_vaciar(n)
    if t != ""
        dom_agregar(n, dom_nodo(DOM_TEXTO, "", t))
    end
    dom_apuntar(n, TOQUE_CONTENIDO, _jsdom_marca_texto(solo_texto), "", "")
end

# (un TOQUE_CONTENIDO en un elemento que no tenía elementos dentro lleva "#texto": no salió ninguno, y los que entran
# se apuntan aparte; a lib/estilo.dash le dice que ningún :has() puede cambiar por él)
func _jsdom_sin_elementos(n: Nodo) -> Bool
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO
            return false
        end
    end
    return true
end

func _jsdom_marca_texto(solo: Bool) -> String
    if solo
        return "#texto"
    end
    return ""
end

# Sin hijos (los que quedan vivos, por ejemplo en el JS, ya no tienen padre)
func _jsdom_vaciar(n: Nodo)
    var nadie: Nodo = nil
    for h in n.hijos
        h.padre = nadie
    end
    n.hijos.clear()
end

func jsdom_atributo(n: Nodo, nombre: String) -> String
    return dom_atributo(n, str_lower(nombre))
end

func jsdom_tiene_atributo(n: Nodo, nombre: String) -> Bool
    return dom_tiene_atributo(n, str_lower(nombre))
end

func jsdom_poner_atributo(n: Nodo, nombre: String, valor: String)
    dom_olvidar_atributos(n)
    clave = str_lower(nombre)
    for a in n.atributos
        if a.nombre == clave
            if a.valor != valor
                dom_apuntar(n, TOQUE_ATRIBUTO, clave, a.valor, valor)
            end
            a.valor = valor
            return
        end
    end
    n.atributos.push(Atributo(clave, valor))
    dom_apuntar(n, TOQUE_ATRIBUTO, clave, "", valor)
end

func jsdom_quitar_atributo(n: Nodo, nombre: String)
    dom_olvidar_atributos(n)
    clave = str_lower(nombre)
    i = 0
    while i < n.atributos.length
        a = n.atributos[i]
        if a.nombre == clave
            dom_apuntar(n, TOQUE_ATRIBUTO, clave, a.valor, "")
            n.atributos.remove(i)
            return
        end
        i = i + 1
    end
end

func jsdom_valor(n: Nodo) -> String
    return formulario_valor(n)
end

func jsdom_poner_valor(n: Nodo, v: String)
    formulario_poner_valor(n, v)
    dom_apuntar(n, TOQUE_ATRIBUTO, "value", "", v)
end

func jsdom_crear(nombre: String) -> Nodo
    return dom_nodo(DOM_ELEMENTO, str_lower(nombre), "")
end

func jsdom_crear_texto(t: String) -> Nodo
    return dom_nodo(DOM_TEXTO, "", t)
end

# hijo pasa al final de padre (si estaba en otro sitio, sale de allí); false si hijo contiene a padre
# (un fragmento mete sus hijos)
func jsdom_agregar(padre: Nodo, hijo: Nodo) -> Bool
    var nadie: Nodo = nil
    return jsdom_insertar_antes(padre, hijo, nadie)
end

func jsdom_quitar(padre: Nodo, hijo: Nodo) -> Bool
    i = 0
    while i < padre.hijos.length
        if padre.hijos[i] == hijo
            if hijo.tipo == DOM_ELEMENTO
                dom_apuntar_salida(padre, hijo)
                dom_apuntar(dom_hermano_elemento(hijo, false), TOQUE_VECINO, "", "", "")
                dom_apuntar(dom_hermano_elemento(hijo, true), TOQUE_VECINO, "", "", "")
            end
            var nadie: Nodo = nil
            hijo.padre = nadie
            padre.hijos.remove(i)
            return true
        end
        i = i + 1
    end
    return false
end

func jsdom_padre(n: Nodo) -> Nodo
    return n.padre
end

# Los hijos (solo los elementos, o todos)
func jsdom_hijos(n: Nodo, solo_elementos: Bool) -> [Nodo]
    var r: [Nodo] = []
    for h in n.hijos
        if not solo_elementos or h.tipo == DOM_ELEMENTO
            r.push(h)
        end
    end
    return r
end

# innerHTML: el HTML de los hijos
func jsdom_html(n: Nodo) -> String
    r = ""
    for h in n.hijos
        r = r + _jsdom_html_nodo(h)
    end
    return r
end

func _jsdom_html_nodo(n: Nodo) -> String
    if n.tipo == DOM_TEXTO
        if n.padre != nil and (n.padre.nombre == "script" or n.padre.nombre == "style")
            return n.texto
        end
        return _jsdom_escapar(n.texto, false)
    elif n.tipo == DOM_COMENTARIO
        return "<!--" + n.texto + "-->"
    elif n.tipo != DOM_ELEMENTO
        return ""
    end
    r = "<" + n.nombre
    for a in n.atributos
        r = r + " " + a.nombre + "=\"" + _jsdom_escapar(a.valor, true) + "\""
    end
    r = r + ">"
    if dom_es_vacio(n.nombre)
        return r
    end
    return r + jsdom_html(n) + "</" + n.nombre + ">"
end

func _jsdom_escapar(t: String, atributo: Bool) -> String
    r = str_replace(str_replace(str_replace(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
    if atributo
        r = str_replace(r, "\"", "&quot;")
    end
    return r
end

# innerHTML = html: los hijos se cambian por lo que da ese HTML (leído como el cuerpo de una página)
func jsdom_poner_html(n: Nodo, html: String)
    solo_texto = _jsdom_sin_elementos(n)
    _jsdom_vaciar(n)
    dom_apuntar(n, TOQUE_CONTENIDO, _jsdom_marca_texto(solo_texto), "", "")
    trozo = dom_desde_html("<body>" + html)
    cuerpo = dom_buscar(trozo, "body")
    if cuerpo == nil
        return
    end
    for h in jsdom_hijos(cuerpo, false)
        jsdom_agregar(n, h)
    end
end

# === Más DOM (tarea 25: lo que necesita jQuery) ===

# El hermano de al lado (después o antes; solo elementos o cualquier nodo); nil si no hay
func jsdom_hermano(n: Nodo, despues: Bool, solo_elementos: Bool) -> Nodo
    var nada: Nodo = nil
    p = n.padre
    if p == nil
        return nada
    end
    k = p.hijos.length
    i = 0
    while i < k and p.hijos[i] != n
        i = i + 1
    end
    paso = -1
    if despues
        paso = 1
    end
    j = i + paso
    while j >= 0 and j < k
        h = p.hijos[j]
        if not solo_elementos or h.tipo == DOM_ELEMENTO
            return h
        end
        j = j + paso
    end
    return nada
end

# nuevo entra en padre antes de ref (al final si ref es nil); un fragmento mete sus hijos. false si
# ref no es hijo de padre o nuevo contiene a padre.
func jsdom_insertar_antes(padre: Nodo, nuevo: Nodo, ref: Nodo) -> Bool
    if nuevo.tipo == DOM_FRAGMENTO
        for h in jsdom_hijos(nuevo, false)
            if not jsdom_insertar_antes(padre, h, ref)
                return false
            end
        end
        return true
    end
    p = padre
    while p != nil
        if p == nuevo
            return false
        end
        p = p.padre
    end
    if ref == nuevo
        return true
    end
    if nuevo.padre != nil
        jsdom_quitar(nuevo.padre, nuevo)
    end
    if ref == nil
        dom_agregar(padre, nuevo)
        _jsdom_entra(nuevo)
        return true
    end
    i = 0
    while i < padre.hijos.length
        if padre.hijos[i] == ref
            padre.hijos.insert(i, nuevo)
            nuevo.padre = padre
            _jsdom_entra(nuevo)
            return true
        end
        i = i + 1
    end
    return false
end

# Un nodo que acaba de entrar en el árbol: él y sus vecinos (por + y :first-child...)
func _jsdom_entra(n: Nodo)
    if n.tipo != DOM_ELEMENTO
        if n.padre != nil
            dom_apuntar(n.padre, TOQUE_CONTENIDO, "#texto", "", "")
        end
        return
    end
    dom_apuntar(n, TOQUE_ENTRA, "", "", "")
    dom_apuntar(dom_hermano_elemento(n, false), TOQUE_VECINO, "", "", "")
    dom_apuntar(dom_hermano_elemento(n, true), TOQUE_VECINO, "", "", "")
end

# Una copia de n (con sus hijos si profundo), sin padre
func jsdom_clonar(n: Nodo, profundo: Bool) -> Nodo
    c = dom_nodo(n.tipo, n.nombre, n.texto)
    for a in n.atributos
        c.atributos.push(Atributo(a.nombre, a.valor))
    end
    if profundo
        for h in n.hijos
            dom_agregar(c, jsdom_clonar(h, true))
        end
    end
    return c
end

# ¿b está dentro de a (o es a)?
func jsdom_contiene(a: Nodo, b: Nodo) -> Bool
    p = b
    while p != nil
        if p == a
            return true
        end
        p = p.padre
    end
    return false
end

# compareDocumentPosition: 1 sin relación, 2 b va antes, 4 b va después, 8 b contiene a a,
# 16 a contiene a b
func jsdom_posicion(a: Nodo, b: Nodo) -> Int
    if a == b
        return 0
    end
    if jsdom_contiene(b, a)
        return 8 + 2
    end
    if jsdom_contiene(a, b)
        return 16 + 4
    end
    ra = _jsdom_raiz_de(a)
    if ra != _jsdom_raiz_de(b)
        return 1 + 32 + 4
    end
    # el primer antepasado común y cuál de sus hijos va antes
    var camino: [Nodo] = []
    p = a
    while p != nil
        camino.push(p)
        p = p.padre
    end
    hb = b
    q = b.padre
    while q != nil
        i = 0
        while i < camino.length and camino[i] != q
            i = i + 1
        end
        if i < camino.length
            ha = camino[i - 1]
            for h in q.hijos
                if h == ha
                    return 4
                end
                if h == hb
                    return 2
                end
            end
            return 1
        end
        hb = q
        q = q.padre
    end
    return 1
end

func _jsdom_raiz_de(n: Nodo) -> Nodo
    p = n
    while p.padre != nil
        p = p.padre
    end
    return p
end

# ¿Se entiende el selector? (si no, querySelector y matches dan un SyntaxError, como en los
# navegadores, y jQuery usa su propio buscador)
func jsdom_selector_valido(texto: String) -> Bool
    hay = false
    for t in css_partir(texto, 44)
        if str_trim(t) == ""
            return false
        end
        sel = css_selector(str_trim(t))
        if sel == nil or not estilo_puede_cumplirse(sel)
            return false
        end
        hay = true
    end
    return hay
end

# matches(): ¿n cumple alguno de los selectores?
func jsdom_cumple(n: Nodo, texto: String) -> Bool
    for t in css_partir(texto, 44)
        sel = css_selector(str_trim(t))
        if sel != nil and estilo_cumple(n, sel)
            return true
        end
    end
    return false
end

func jsdom_crear_comentario(t: String) -> Nodo
    return dom_nodo(DOM_COMENTARIO, "", t)
end

func jsdom_crear_fragmento() -> Nodo
    return dom_nodo(DOM_FRAGMENTO, "", "")
end

# document.implementation.createHTMLDocument(): un documento aparte, vacío
func jsdom_documento_nuevo(titulo: String) -> Nodo
    return dom_desde_html("<html><head><title>" + titulo + "</title></head><body></body></html>")
end

# outerHTML
func jsdom_html_fuera(n: Nodo) -> String
    return _jsdom_html_nodo(n)
end

func jsdom_cabeza(doc: Nodo) -> Nodo
    return dom_buscar(doc, "head")
end

# getComputedStyle: lo calculado por lib/estilo.dash; si el elemento es nuevo (sin estilo aún),
# display según la etiqueta
func jsdom_estilo_calculado(n: Nodo, propiedad: String) -> String
    e = n.estilo
    fresco = _jsdom_estilo_fresco(n)
    if fresco != nil
        e = fresco
    end
    if e.has(propiedad)
        return e[propiedad]
    end
    if propiedad == "display" and n.tipo == DOM_ELEMENTO
        if jsdom_cumple(n, "html, body, div, p, h1, h2, h3, h4, h5, h6, ul, ol, dl, pre, blockquote, form, table, header, footer, nav, section, article, aside, main, figure, fieldset, address, hr")
            return "block"
        elif n.nombre == "li"
            return "list-item"
        elif jsdom_cumple(n, "head, script, style, title, meta, link, template")
            return "none"
        end
        return "inline"
    end
    # lo que no dice ninguna regla: su valor inicial, como en un navegador (iron-fit-behavior de Polymer, en el diálogo de
    # cookies de YouTube, mira top !== 'auto' para saber si ya está colocado: con "" no se ponía position: fixed y el
    # diálogo quedaba debajo de su fondo; tarea 38c5)
    if _jsdom_iniciales == nil
        var d: {String: String} = {}
        for par in css_partir(JSDOM_INICIALES, 32)
            dos = css_partir(par, 61)
            if dos.length == 2
                d[dos[0]] = dos[1]
            end
        end
        _jsdom_iniciales = d
    end
    if _jsdom_iniciales.has(propiedad)
        return _jsdom_iniciales[propiedad]
    end
    return ""
end

var _jsdom_iniciales: {String: String} = nil

# Las hojas de cada documento con JavaScript (lib/documento.dash las apunta y las quita): con ellas, getComputedStyle
# calcula al momento el estilo de un elemento que tiene cambios sin estilo aún, él o uno de arriba (como un navegador;
# estilo_calcular_uno, tarea 38c5)
var _jsdom_docs: [Nodo] = []
var _jsdom_hojas: [Hojas] = []
# (el último calculado así, mientras no haya más cambios: iron-fit pide top, left, bottom, right... seguidos)
var _jsdom_fresco_nodo: Nodo = nil
var _jsdom_fresco_ultimo: Toque = nil
var _jsdom_fresco_cuantos: Int = 0
var _jsdom_fresco: {String: String} = nil

func jsdom_poner_hojas(doc: Nodo, h: Hojas)
    i = 0
    while i < _jsdom_docs.length
        if _jsdom_docs[i] == doc
            _jsdom_hojas[i] = h
            return
        end
        i = i + 1
    end
    _jsdom_docs.push(doc)
    _jsdom_hojas.push(h)
end

func jsdom_quitar_hojas(doc: Nodo)
    var docs: [Nodo] = []
    var hojas: [Hojas] = []
    i = 0
    while i < _jsdom_docs.length
        if _jsdom_docs[i] != doc
            docs.push(_jsdom_docs[i])
            hojas.push(_jsdom_hojas[i])
        end
        i = i + 1
    end
    _jsdom_docs = docs
    _jsdom_hojas = hojas
    var nadie: Nodo = nil
    _jsdom_fresco_nodo = nadie
    var ninguno: Toque = nil
    _jsdom_fresco_ultimo = ninguno
    var nada: {String: String} = nil
    _jsdom_fresco = nada
end

# El estilo de n al momento si él o uno de arriba tiene cambios del JavaScript sin estilo aún; nil si no
func _jsdom_estilo_fresco(n: Nodo) -> {String: String}
    var nada: {String: String} = nil
    if n.tipo != DOM_ELEMENTO
        return nada
    end
    doc = n
    while doc.padre != nil
        doc = doc.padre
    end
    if doc.tipo != DOM_DOCUMENTO or doc.toques == nil or doc.toques.length == 0
        return nada
    end
    ultimo = doc.toques[doc.toques.length - 1]
    if n == _jsdom_fresco_nodo and ultimo == _jsdom_fresco_ultimo and doc.toques.length == _jsdom_fresco_cuantos
        return _jsdom_fresco
    end
    var hojas: Hojas = nil
    i = 0
    while i < _jsdom_docs.length
        if _jsdom_docs[i] == doc
            hojas = _jsdom_hojas[i]
        end
        i = i + 1
    end
    if hojas == nil
        return nada
    end
    # el de más arriba con cambios (con demasiados para apuntarlos, todos)
    var cadena: [Nodo] = []
    p = n
    while p != nil and p.tipo == DOM_ELEMENTO
        cadena.push(p)
        p = p.padre
    end
    alto = -1
    for t in doc.toques
        if t.tipo == TOQUE_TODO
            alto = cadena.length - 1
            break
        end
        k = cadena.length - 1
        while k > alto
            if t.nodo == cadena[k]
                alto = k
            end
            k = k - 1
        end
    end
    # (<html> no se calcula así: el de debajo)
    if alto > cadena.length - 2
        alto = cadena.length - 2
    end
    if alto < 0
        return nada
    end
    _jsdom_fresco = estilo_calcular_uno(n, cadena[alto], hojas)
    _jsdom_fresco_nodo = n
    _jsdom_fresco_ultimo = ultimo
    _jsdom_fresco_cuantos = doc.toques.length
    return _jsdom_fresco
end
const JSDOM_INICIALES = "top=auto right=auto bottom=auto left=auto z-index=auto position=static float=none clear=none max-width=none max-height=none min-width=0px min-height=0px margin-top=0px margin-right=0px margin-bottom=0px margin-left=0px padding-top=0px padding-right=0px padding-bottom=0px padding-left=0px border-top-width=0px border-right-width=0px border-bottom-width=0px border-left-width=0px opacity=1 visibility=visible transform=none overflow=visible overflow-x=visible overflow-y=visible box-sizing=content-box flex-grow=0 flex-shrink=1 flex-basis=auto pointer-events=auto direction=ltr animation-name=none transition-duration=0s"

# === XMLHttpRequest y fetch (tarea 37e2) ===
# Las peticiones del JavaScript de cada motor van sin esperar (lib/http.dash); jsdom_peticiones_avanzar, en cada
# tic de dashweb, las avanza y da al JavaScript las que acaban (__dashweb_respuesta)

struct PeticionJS
    js: Int
    id: Int
    carga: Carga
end

var jsdom_peticiones: [PeticionJS] = []

# (desde __dashweb_pedir) cabeceras: "Nombre: valor" por línea; las que pone el navegador no se dejan cambiar
func jsdom_pedir(js: Int, id: Int, metodo: String, url: String, cabeceras: String, cuerpo: String)
    tipo = ""
    extra = ""
    for linea in str_split(cabeceras, "\n")
        p = str_find(linea, ":")
        if p <= 0
            continue
        end
        nombre = str_lower(str_trim(linea[:p]))
        valor = str_trim(linea[p + 1:])
        if nombre == "content-type"
            tipo = valor
        elif nombre == "host" or nombre == "content-length" or nombre == "cookie" or nombre == "connection" or nombre == "user-agent" or nombre == "accept-encoding" or str_starts(nombre, "sec-") or str_starts(nombre, "proxy-")
            continue
        else
            if extra != ""
                extra = extra + "\r\n"
            end
            extra = extra + str_trim(linea[:p]) + ": " + valor
        end
    end
    if tipo == "" and cuerpo != "" and metodo != "GET"
        tipo = "text/plain;charset=UTF-8"
    end
    if URL_RASTREO_BLOQUEAR and url_rastreador(url)
        # (un rastreador: no se pide; en el siguiente avance, un error de red; también los <script> que mete el
        # JavaScript, que van por aquí)
        var sin: Carga = nil
        jsdom_peticiones.push(PeticionJS(js, id, sin))
        return
    end
    jsdom_peticiones.push(PeticionJS(js, id, http_empezar_metodo(url, metodo, cuerpo, tipo, extra, 20000)))
end

# Avanza las peticiones de ese motor; cuántas acabaron (ya entregadas al JavaScript)
func jsdom_peticiones_avanzar(js: Int) -> Int
    hechas = 0
    i = 0
    while i < jsdom_peticiones.length
        p = jsdom_peticiones[i]
        if p.js == js and p.carga == nil
            jsdom_peticiones.remove(i)
            _jsdom_responder(js, p.id, 0, "", "", "", "", "bloqueado (rastreo)")
            hechas = hechas + 1
            continue
        end
        if p.js == js and http_avanzar(p.carga)
            r = p.carga.respuesta
            cab = ""
            for k in r.cabeceras.keys()
                cab = cab + k + ": " + r.cabeceras[k] + "\r\n"
            end
            jsdom_peticiones.remove(i)
            _jsdom_responder(js, p.id, r.estado, r.razon, cab, r.url, r.cuerpo, r.error)
            hechas = hechas + 1
            continue
        end
        i = i + 1
    end
    return hechas
end

func jsdom_peticiones_pendientes(js: Int) -> Int
    n = 0
    for p in jsdom_peticiones
        if p.js == js
            n = n + 1
        end
    end
    return n
end

# Las de un motor que se va (antes de js_liberar: su respuesta ya no tiene a quién ir)
func jsdom_peticiones_cancelar(js: Int)
    i = 0
    while i < jsdom_peticiones.length
        if jsdom_peticiones[i].js == js
            if jsdom_peticiones[i].carga != nil
                http_cancelar(jsdom_peticiones[i].carga)
            end
            jsdom_peticiones.remove(i)
            continue
        end
        i = i + 1
    end
end

# ¿Tiene n una caja de la última maqueta de doc? (lib/maqueta.dash la pone en sus campos caja_*)
func jsdom_caja_valida(n: Nodo, doc: Nodo) -> Bool
    return doc != nil and doc.caja_pase != 0 and n.caja_pase == doc.caja_pase
end

# ¿Se ve? (offsetWidth/offsetHeight: sin posiciones de la maqueta, 0 si él o un antepasado tiene
# display: none, en su estilo o en el atributo style; 1 si no; 0 fuera del documento)
func jsdom_visible(n: Nodo) -> Bool
    p = n
    while p != nil and p.tipo == DOM_ELEMENTO
        # el atributo style manda sobre lo calculado (puede haberlo cambiado el JS después)
        s = str_replace(str_lower(dom_atributo(p, "style")), " ", "")
        k = str_find(s, "display:")
        if k >= 0
            v = s[k + 8:]
            fin = str_find(v, ";")
            if fin >= 0
                v = v[:fin]
            end
            if v == "none"
                return false
            end
        elif p.estilo.has("display") and p.estilo["display"] == "none"
            return false
        end
        p = p.padre
    end
    return p != nil and p.tipo == DOM_DOCUMENTO
end

func jsdom_cuerpo(doc: Nodo) -> Nodo
    return dom_buscar(doc, "body")
end

func jsdom_raiz(doc: Nodo) -> Nodo
    return dom_buscar(doc, "html")
end

# location.assign, replace, href = ... (y window.location = ...) del JavaScript de la página (tarea 51; la página de
# salto de DuckDuckGo hace window.parent.location.replace(destino)): la dirección y si sustituye a la de la página en
# el historial, en el documento (sus atributos "ir" e "ir_sustituir"); dashweb la abre en el siguiente tic
func jsdom_navegar(doc: Nodo, u: String, sustituir: Bool)
    _jsdom_doc_atributo(doc, "ir", u)
    s = ""
    if sustituir
        s = "1"
    end
    _jsdom_doc_atributo(doc, "ir_sustituir", s)
end

func _jsdom_doc_atributo(doc: Nodo, nombre: String, valor: String)
    for a in doc.atributos
        if a.nombre == nombre
            a.valor = valor
            return
        end
    end
    doc.atributos.push(Atributo(nombre, valor))
end

func jsdom_titulo(doc: Nodo) -> String
    t = dom_buscar(doc, "title")
    if t == nil
        return ""
    end
    return str_trim(dom_texto(t))
end

# El <script> que se está ejecutando (document.currentScript; nil entre uno y otro)
var jsdom_script_actual: Nodo = nil

func jsdom_script_en_curso() -> Nodo
    return jsdom_script_actual
end

# Ejecuta los <script> del documento en orden: los de dentro y los de src (http(s) o fichero,
# relativo a base). Solo JavaScript (sin type, o type text/javascript, module no). Un error se
# escribe en la salida y se sigue con el siguiente. Cuántos se ejecutaron.
func jsdom_ejecutar_scripts(js: Int, doc: Nodo, base: String) -> Int
    var traidos: {String: String} = {}
    var cuerpos: {String: Respuesta} = {}
    return jsdom_ejecutar_scripts_con(js, doc, base, traidos, cuerpos)
end

# Lo mismo con los src ya traídos (dirección -> texto, o en cuerpos su respuesta en UTF-8; lib/recursos.dash); los que
# falten se piden
func jsdom_ejecutar_scripts_con(js: Int, doc: Nodo, base: String, traidos: {String: String}, cuerpos: {String: Respuesta}) -> Int
    var scripts: [Nodo] = []
    _jsdom_scripts(doc, scripts)
    hechos = 0
    u = url_parse(base)
    js_evaluar(js, "__dashweb_lugar('" + str_replace(str_replace(base, "\\", "\\\\"), "'", "\\'") + "')", "dashweb")
    for s in scripts
        tipo = str_lower(str_trim(dom_atributo(s, "type")))
        if tipo == "" or tipo == "text/javascript" or tipo == "application/javascript"
            nombre = base
            traido = false
            if dom_tiene_atributo(s, "src")
                nombre = url_text(url_resolve(u, dom_atributo(s, "src")))
                traido = traidos.has(nombre)
            end
            jsdom_script_actual = s
            t0 = time_ms()
            largo = 0
            if traido
                # el traído, sin copiarlo a una variable (Dash copia el texto: el de YouTube son 10,8 MB, y tras otra
                # página no había dos huecos así; tarea 38c8) y fuera en cuanto se ha ejecutado
                if cuerpos.has(nombre)
                    # (la respuesta en una variable: su cuerpo va prestado, sin copia)
                    rc = cuerpos[nombre]
                    cuerpos.remove(nombre)
                    largo = rc.cuerpo.length
                    js_evaluar_utf8(js, rc.cuerpo, nombre)
                    rc.cuerpo = ""
                else
                    largo = traidos[nombre].length
                    js_evaluar(js, traidos[nombre], nombre)
                end
                traidos.remove(nombre)
            else
                codigo = dom_texto(s)
                if nombre != base
                    codigo = _jsdom_traer(nombre)
                end
                largo = codigo.length
                js_evaluar(js, codigo, nombre)
            end
            if traza_activa and time_ms() - t0 >= 1000
                traza("script de " + largo + " bytes en " + (time_ms() - t0) + " ms (compilar " + js_ms_compilar() + "): " + nombre)
            end
            if traza_activa and nombre != base and largo == 0
                traza("script vacío: " + nombre)
            end
            var ninguno: Nodo = nil
            jsdom_script_actual = ninguno
            if js_error(js) != ""
                registro_decir("JS: " + str_replace(js_error(js), "\n    ", " | "))
            end
            hechos = hechos + 1
        end
    end
    # DOMContentLoaded y load, como un navegador al acabar la página
    js_evaluar(js, "__dashweb_cargado()", "dashweb")
    # con QuickJS y dashweb compilados con -DJS_PERFIL, el perfil del JavaScript de la página (si no, nada)
    js_perfil_volcar(js, 40)
    if js_error(js) != ""
        registro_decir("JS: " + str_replace(js_error(js), "\n    ", " | "))
    end
    return hechos
end

func _jsdom_scripts(n: Nodo, r: [Nodo])
    if n.tipo == DOM_ELEMENTO and n.nombre == "script"
        r.push(n)
    end
    for h in n.hijos
        _jsdom_scripts(h, r)
    end
end

func _jsdom_traer(direccion: String) -> String
    u = url_parse(direccion)
    if URL_RASTREO_BLOQUEAR and url_rastreador(direccion)
        return URL_RASTREO_SUSTITUTO
    end
    if u.esquema == "http" or u.esquema == "https"
        r = http_get(direccion, 15000)
        if r.error != "" or r.estado != 200
            return ""
        end
        return texto_decodificar_js(r.cuerpo, r.juego)
    end
    ruta = url_fichero(direccion)
    t = file_read_text(ruta)
    if t == nil
        return ""
    end
    return utf8_a_js_ascii(t)
end

# === La parte en C: los objetos JS de los nodos ===

@c
"""
/* lib/jsdom.dash: one JS object per Dash node, kept in a table until js_liberar */
static JSClassID _jsdom_clase;

/* A text made here (malloc) that went to a Dash function: Dash keeps the length of long texts in a cache by
   address, and a free() it does not see would leave it there for the next text at the same address (a selector
   of 104 characters was read cut short: tarea 37a3). Forget it before freeing. */
#define _jsdom_soltar(p) do { _dash_str_forget((STRPTR)(p)); free(p); } while (0)

typedef struct {
    _Dash_Nodo *doc;
    _Dash_Nodo **nodos;      /* open addressing: node -> its JS object */
    JSValue *objetos;
    LONG capacidad, usados;
    LONG cambios;
    LONG vista[4];           /* jsdom_vista: what is seen (width, height), the scroll (y) and the page's height */
    LONG motor;              /* its _JsMotor (the js handle of Dash): XMLHttpRequest/fetch requests go with it */
} _JsDom;

static void _jsdom_finalizar(JSRuntime *rt, JSValue val) {
    _Dash_Nodo *n = (_Dash_Nodo *)JS_GetOpaque(val, _jsdom_clase);
    if (n) {
        dom_olvidar_toques(n);   /* (sin el ciclo documento -> aviso -> documento) */
        _dash_release(n);
    }
}

static _JsDom *_jsdom_de(JSContext *ctx) { return (_JsDom *)JS_GetContextOpaque(ctx); }

/* A change to the DOM: counted (jsdom_cambios); what changed is noted by the Dash functions (dom_apuntar) */
static void _jsdom_tocado(JSContext *ctx, _Dash_Nodo *n) {
    _jsdom_de(ctx)->cambios++;
}

static void _jsdom_crecer(_JsDom *d);

/* The JS object of a node (the same every time); null for nil */
static JSValue _jsdom_objeto(JSContext *ctx, _Dash_Nodo *n) {
    _JsDom *d = _jsdom_de(ctx);
    ULONG i;
    JSValue o;
    if (!n || !d) return JS_NULL;
    if (d->usados * 2 >= d->capacidad) _jsdom_crecer(d);
    i = ((ULONG)n >> 3) & (d->capacidad - 1);
    while (d->nodos[i]) {
        if (d->nodos[i] == n) return JS_DupValue(ctx, d->objetos[i]);
        i = (i + 1) & (d->capacidad - 1);
    }
    o = JS_NewObjectClass(ctx, _jsdom_clase);
    if (JS_IsException(o)) return o;
    _dash_retain(n);
    JS_SetOpaque(o, n);
    /* un elemento, con el prototipo de su etiqueta si el preludio lo tiene (__dashweb_protos: text de <a>, href, src...
       solo en las suyas; tarea 38c5); un texto o un comentario, con el suyo (data) */
    {
        const char *clave = n->tipo == DOM_ELEMENTO ? (const char *)n->nombre : n->tipo == DOM_TEXTO ? "#text"
                          : n->tipo == DOM_COMENTARIO ? "#comment" : NULL;
        JSValue g, pt;
        if (clave && !*clave) clave = NULL;
        g = clave ? JS_GetGlobalObject(ctx) : JS_UNDEFINED;
        pt = clave ? JS_GetPropertyStr(ctx, g, "__dashweb_protos") : JS_UNDEFINED;
        if (JS_IsObject(pt)) {
            JSValue p = JS_GetPropertyStr(ctx, pt, clave);
            if (JS_IsObject(p)) JS_SetPrototype(ctx, o, p);
            JS_FreeValue(ctx, p);
        }
        JS_FreeValue(ctx, pt);
        JS_FreeValue(ctx, g);
    }
    d->nodos[i] = n;
    d->objetos[i] = JS_DupValue(ctx, o);
    d->usados++;
    return o;
}

static void _jsdom_crecer(_JsDom *d) {
    LONG vieja = d->capacidad, i;
    _Dash_Nodo **nodos = d->nodos;
    JSValue *objetos = d->objetos;
    d->capacidad = vieja ? vieja * 2 : 256;
    d->nodos = (_Dash_Nodo **)calloc(d->capacidad, sizeof(_Dash_Nodo *));
    d->objetos = (JSValue *)calloc(d->capacidad, sizeof(JSValue));
    for (i = 0; i < vieja; i++) {
        if (nodos[i]) {
            ULONG j = ((ULONG)nodos[i] >> 3) & (d->capacidad - 1);
            while (d->nodos[j]) j = (j + 1) & (d->capacidad - 1);
            d->nodos[j] = nodos[i];
            d->objetos[j] = objetos[i];
        }
    }
    free(nodos);
    free(objetos);
}

static void _jsdom_liberar(_JsMotor *m) {
    _JsDom *d = (_JsDom *)m->extra;
    LONG i;
    if (!d) return;
    for (i = 0; i < d->capacidad; i++) if (d->nodos[i]) JS_FreeValue(m->ctx, d->objetos[i]);
    free(d->nodos);
    free(d->objetos);
    if (d->doc) _dash_release(d->doc);
    free(d);
    m->extra = NULL;
    JS_SetContextOpaque(m->ctx, NULL);
}

static _Dash_Nodo *_jsdom_nodo(JSContext *ctx, JSValueConst v) {
    return (_Dash_Nodo *)JS_GetOpaque(v, _jsdom_clase);
}

/* A JS string from a Latin-1 text */
static JSValue _jsdom_cadena(JSContext *ctx, STRPTR s) {
    char *u = _js_utf8(s ? (const char *)s : "");
    JSValue v = u ? JS_NewString(ctx, u) : JS_EXCEPTION;
    _jsdom_soltar(u);
    return v;
}

/* argument i as a Latin-1 text (malloc; free it) */
static char *_jsdom_arg(JSContext *ctx, int argc, JSValueConst *argv, int i) {
    return i < argc ? _js_texto(ctx, argv[i]) : strdup("undefined");
}

static JSValue _jsdom_lista(JSContext *ctx, DashArrayLong *l) {
    JSValue a = JS_NewArray(ctx);
    LONG i, n = l ? DashArray_length(l) : 0;
    for (i = 0; i < n; i++)
        JS_SetPropertyUint32(ctx, a, i, _jsdom_objeto(ctx, (_Dash_Nodo *)DashArray_get(l, i)));
    return a;
}

#define _JSDOM_ESTE _Dash_Nodo *n = _jsdom_nodo(ctx, this_val); \
    if (!n) return JS_ThrowTypeError(ctx, "not a node")
/* en un setter: sobre algo que no es un nodo de verdad (el prototipo de una clase que hereda de HTMLElement, como
   hace Polymer en YouTube), una propiedad normal suya, como si el setter no estuviera (tarea 38) */
#define _JSDOM_ESTE_PONER(nombre) _Dash_Nodo *n = _jsdom_nodo(ctx, this_val); \
    if (!n) { JS_DefinePropertyValueStr(ctx, this_val, nombre, JS_DupValue(ctx, v), JS_PROP_C_W_E); return JS_UNDEFINED; }

static JSValue _jsdom_tagName(JSContext *ctx, JSValueConst this_val) {
    char *t;
    JSValue v;
    _JSDOM_ESTE;
    if (n->tipo != DOM_ELEMENTO)
        return JS_NewString(ctx, n->tipo == DOM_TEXTO ? "#text" : n->tipo == DOM_COMENTARIO ? "#comment"
                                 : n->tipo == DOM_FRAGMENTO ? "#document-fragment" : "#document");
    t = strdup((const char *)n->nombre);
    if (!t) return JS_EXCEPTION;
    { char *p; for (p = t; *p; p++) if (*p >= 'a' && *p <= 'z') *p -= 32; }
    v = JS_NewString(ctx, t);
    _jsdom_soltar(t);
    return v;
}

static JSValue _jsdom_nodeType(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return JS_NewInt32(ctx, n->tipo);
}

static JSValue _jsdom_textContent(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return _jsdom_cadena(ctx, jsdom_texto(n));
}

static JSValue _jsdom_set_textContent(JSContext *ctx, JSValueConst this_val, JSValueConst v) {
    char *t;
    _JSDOM_ESTE_PONER("textContent");
    t = _js_texto(ctx, v);
    jsdom_poner_texto(n, (STRPTR)(t ? t : ""));
    _jsdom_soltar(t);
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

static JSValue _jsdom_innerHTML(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return _jsdom_cadena(ctx, jsdom_html(n));
}

static JSValue _jsdom_set_innerHTML(JSContext *ctx, JSValueConst this_val, JSValueConst v) {
    char *t;
    _JSDOM_ESTE_PONER("innerHTML");
    t = _js_texto(ctx, v);
    jsdom_poner_html(n, (STRPTR)(t ? t : ""));
    _jsdom_soltar(t);
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

/* id and className: getters and setters of an attribute (magic 0: id, 1: class) */
static const char *_jsdom_atr_nombres[] = { "id", "class" };

static JSValue _jsdom_atr(JSContext *ctx, JSValueConst this_val, int magic) {
    _JSDOM_ESTE;
    return _jsdom_cadena(ctx, jsdom_atributo(n, (STRPTR)_jsdom_atr_nombres[magic]));
}

static JSValue _jsdom_set_atr(JSContext *ctx, JSValueConst this_val, JSValueConst v, int magic) {
    char *t;
    _JSDOM_ESTE_PONER((magic == 0 ? "id" : "className"));
    t = _js_texto(ctx, v);
    jsdom_poner_atributo(n, (STRPTR)_jsdom_atr_nombres[magic], (STRPTR)(t ? t : ""));
    _jsdom_soltar(t);
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

/* value (input, textarea, select) and checked */
static JSValue _jsdom_value(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return _jsdom_cadena(ctx, jsdom_valor(n));
}

static JSValue _jsdom_set_value(JSContext *ctx, JSValueConst this_val, JSValueConst v) {
    char *t;
    _JSDOM_ESTE_PONER("value");
    t = _js_texto(ctx, v);
    jsdom_poner_valor(n, (STRPTR)(t ? t : ""));
    _jsdom_soltar(t);
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

static JSValue _jsdom_checked(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return JS_NewBool(ctx, jsdom_tiene_atributo(n, (STRPTR)"checked"));
}

static JSValue _jsdom_set_checked(JSContext *ctx, JSValueConst this_val, JSValueConst v) {
    _JSDOM_ESTE_PONER("checked");
    if (JS_ToBool(ctx, v)) jsdom_poner_atributo(n, (STRPTR)"checked", (STRPTR)"");
    else jsdom_quitar_atributo(n, (STRPTR)"checked");
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

static JSValue _jsdom_parentNode(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return _jsdom_objeto(ctx, jsdom_padre(n));
}

/* magic 0: children (elements), 1: childNodes */
static JSValue _jsdom_hijos(JSContext *ctx, JSValueConst this_val, int magic) {
    _JSDOM_ESTE;
    return _jsdom_lista(ctx, jsdom_hijos(n, magic == 0));
}

/* magic 0: firstChild, 1: lastChild */
static JSValue _jsdom_extremo(JSContext *ctx, JSValueConst this_val, int magic) {
    DashArrayLong *l;
    LONG k;
    _JSDOM_ESTE;
    l = n->hijos;
    k = l ? DashArray_length(l) : 0;
    if (!k) return JS_NULL;
    return _jsdom_objeto(ctx, (_Dash_Nodo *)DashArray_get(l, magic ? k - 1 : 0));
}

static JSValue _jsdom_getAttribute(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *a;
    JSValue v;
    _JSDOM_ESTE;
    a = _jsdom_arg(ctx, argc, argv, 0);
    v = a && jsdom_tiene_atributo(n, (STRPTR)a) ? _jsdom_cadena(ctx, jsdom_atributo(n, (STRPTR)a)) : JS_NULL;
    _jsdom_soltar(a);
    return v;
}

static JSValue _jsdom_hasAttribute(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *a;
    BOOL r;
    _JSDOM_ESTE;
    a = _jsdom_arg(ctx, argc, argv, 0);
    r = a && jsdom_tiene_atributo(n, (STRPTR)a);
    _jsdom_soltar(a);
    return JS_NewBool(ctx, r);
}

static JSValue _jsdom_setAttribute(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *a, *v;
    _JSDOM_ESTE;
    a = _jsdom_arg(ctx, argc, argv, 0);
    v = _jsdom_arg(ctx, argc, argv, 1);
    if (a && v) jsdom_poner_atributo(n, (STRPTR)a, (STRPTR)v);
    _jsdom_soltar(a);
    _jsdom_soltar(v);
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

static JSValue _jsdom_removeAttribute(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *a;
    _JSDOM_ESTE;
    a = _jsdom_arg(ctx, argc, argv, 0);
    if (a) jsdom_quitar_atributo(n, (STRPTR)a);
    _jsdom_soltar(a);
    _jsdom_tocado(ctx, n);
    return JS_UNDEFINED;
}

static JSValue _jsdom_appendChild(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *h;
    _JSDOM_ESTE;
    h = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    if (!h) return JS_ThrowTypeError(ctx, "appendChild: not a node");
    if (!jsdom_agregar(n, h)) return JS_ThrowRangeError(ctx, "appendChild: the node contains this one");
    _jsdom_tocado(ctx, n);
    return JS_DupValue(ctx, argv[0]);
}

static JSValue _jsdom_removeChild(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *h;
    _JSDOM_ESTE;
    h = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    if (!h || !jsdom_quitar(n, h)) return JS_ThrowRangeError(ctx, "removeChild: not a child of this node");
    _jsdom_tocado(ctx, n);
    return JS_DupValue(ctx, argv[0]);
}

/* magic 0: querySelector, 1: querySelectorAll, 2: getElementsByTagName */
static JSValue _jsdom_selector(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv, int magic) {
    char *s;
    DashArrayLong *l;
    _JSDOM_ESTE;
    s = _jsdom_arg(ctx, argc, argv, 0);
    if (!s) return JS_EXCEPTION;
    if (magic != 2 && !jsdom_selector_valido((STRPTR)s)) {
        JSValue e = JS_ThrowSyntaxError(ctx, "'%s' is not a valid selector", s);
        _jsdom_soltar(s);
        return e;
    }
    l = jsdom_selector(n, (STRPTR)s, magic != 0);
    _jsdom_soltar(s);
    if (magic) return _jsdom_lista(ctx, l);
    return l && DashArray_length(l) ? _jsdom_objeto(ctx, (_Dash_Nodo *)DashArray_get(l, 0)) : JS_NULL;
}

/* Tarea 25: lo que necesita jQuery */

/* magic 0: nextSibling, 1: previousSibling, 2: nextElementSibling, 3: previousElementSibling */
static JSValue _jsdom_hermano(JSContext *ctx, JSValueConst this_val, int magic) {
    _JSDOM_ESTE;
    return _jsdom_objeto(ctx, jsdom_hermano(n, !(magic & 1), magic >= 2));
}

static JSValue _jsdom_insertBefore(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *h, *ref;
    _JSDOM_ESTE;
    h = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    ref = argc > 1 ? _jsdom_nodo(ctx, argv[1]) : NULL;
    if (!h) return JS_ThrowTypeError(ctx, "insertBefore: not a node");
    if (argc > 1 && !ref && !JS_IsNull(argv[1]) && !JS_IsUndefined(argv[1]))
        return JS_ThrowTypeError(ctx, "insertBefore: the reference is not a node");
    if (!jsdom_insertar_antes(n, h, ref)) return JS_ThrowRangeError(ctx, "insertBefore: cannot insert there");
    _jsdom_tocado(ctx, n);
    return JS_DupValue(ctx, argv[0]);
}

static JSValue _jsdom_replaceChild(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *h, *viejo;
    _JSDOM_ESTE;
    h = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    viejo = argc > 1 ? _jsdom_nodo(ctx, argv[1]) : NULL;
    if (!h || !viejo || jsdom_padre(viejo) != n) return JS_ThrowRangeError(ctx, "replaceChild: not a child of this node");
    if (h != viejo) {
        if (!jsdom_insertar_antes(n, h, viejo)) return JS_ThrowRangeError(ctx, "replaceChild: cannot insert there");
        jsdom_quitar(n, viejo);
    }
    _jsdom_tocado(ctx, n);
    return JS_DupValue(ctx, argv[1]);
}

static JSValue _jsdom_cloneNode(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _JSDOM_ESTE;
    return _jsdom_objeto(ctx, jsdom_clonar(n, argc > 0 && JS_ToBool(ctx, argv[0])));
}

static JSValue _jsdom_contains(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *b;
    _JSDOM_ESTE;
    b = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    return JS_NewBool(ctx, b && jsdom_contiene(n, b));
}

static JSValue _jsdom_compareDocumentPosition(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *b;
    _JSDOM_ESTE;
    b = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    if (!b) return JS_ThrowTypeError(ctx, "compareDocumentPosition: not a node");
    return JS_NewInt32(ctx, jsdom_posicion(n, b));
}

static JSValue _jsdom_matches(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *s;
    BOOL r;
    _JSDOM_ESTE;
    s = _jsdom_arg(ctx, argc, argv, 0);
    if (!s) return JS_EXCEPTION;
    if (!jsdom_selector_valido((STRPTR)s)) {
        JSValue e = JS_ThrowSyntaxError(ctx, "'%s' is not a valid selector", s);
        _jsdom_soltar(s);
        return e;
    }
    r = n->tipo == DOM_ELEMENTO && jsdom_cumple(n, (STRPTR)s);
    _jsdom_soltar(s);
    return JS_NewBool(ctx, r);
}

static JSValue _jsdom_getElementsByClassName(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *s, *sel, *p, *q;
    DashArrayLong *l;
    _JSDOM_ESTE;
    s = _jsdom_arg(ctx, argc, argv, 0);
    if (!s) return JS_EXCEPTION;
    sel = (char *)malloc(strlen(s) * 2 + 2);
    if (!sel) { _jsdom_soltar(s); return JS_EXCEPTION; }
    /* "a b" -> ".a.b" */
    for (p = s, q = sel; *p; ) {
        while (*p && (unsigned char)*p <= 32) p++;
        if (!*p) break;
        *q++ = '.';
        while (*p && (unsigned char)*p > 32) *q++ = *p++;
    }
    *q = 0;
    l = sel[0] ? jsdom_selector(n, (STRPTR)sel, TRUE) : NULL;
    _jsdom_soltar(s);
    _jsdom_soltar(sel);
    return _jsdom_lista(ctx, l);
}

static JSValue _jsdom_ownerDocument(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    if (n->tipo == DOM_DOCUMENTO) return JS_NULL;
    return _jsdom_objeto(ctx, _jsdom_de(ctx)->doc);
}

static JSValue _jsdom_outerHTML(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    return _jsdom_cadena(ctx, jsdom_html_fuera(n));
}

/* nodeValue / data: the text of a text or comment node (null for the others) */
static JSValue _jsdom_nodeValue(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    if (n->tipo != DOM_TEXTO && n->tipo != DOM_COMENTARIO) return JS_NULL;
    return _jsdom_cadena(ctx, n->texto);
}

static JSValue _jsdom_set_nodeValue(JSContext *ctx, JSValueConst this_val, JSValueConst v) {
    _JSDOM_ESTE_PONER("nodeValue");
    if (n->tipo != DOM_TEXTO && n->tipo != DOM_COMENTARIO) return JS_UNDEFINED;
    return _jsdom_set_textContent(ctx, this_val, v);
}

/* defaultValue: the value attribute (the text of a textarea) */
static JSValue _jsdom_defaultValue(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    if (n->tipo == DOM_ELEMENTO && !strcmp((const char *)n->nombre, "textarea")) return _jsdom_cadena(ctx, jsdom_texto(n));
    return _jsdom_cadena(ctx, jsdom_atributo(n, (STRPTR)"value"));
}

/* Lo pone lib/documento.dash: si el JavaScript cambió el documento de ese árbol, maquetarlo ya (como hace un navegador
   al pedirle una medida). Se llama cuando se mide un elemento sin caja de la última maqueta: lo que estaba escondido
   y se acaba de enseñar (el diálogo de cookies de YouTube se centraba con su tamaño a 0; tarea 38c5) */
static int (*jsdom_al_pedir_caja)(_Dash_Nodo *doc, _Dash_Nodo *n) = 0;
static void _jsdom_caja_al_dia(JSContext *ctx, _Dash_Nodo *n) {
    _JsDom *d = _jsdom_de(ctx);
    if (jsdom_al_pedir_caja && d && d->doc && n) jsdom_al_pedir_caja(d->doc, n);
}

/* offsetWidth/offsetHeight...: its box in the last layout (tarea 37b); before the first one, 0 if not shown
   (display: none here or above, or out of the document) and otherwise a nominal size (magic 0: width, 1: height) */
static JSValue _jsdom_tamano(JSContext *ctx, JSValueConst this_val, int magic) {
    _JSDOM_ESTE;
    _jsdom_caja_al_dia(ctx, n);
    if (n->tipo != DOM_ELEMENTO) return JS_NewInt32(ctx, 0);
    if (jsdom_caja_valida(n, _jsdom_de(ctx)->doc)) return JS_NewInt32(ctx, magic ? n->caja_h : n->caja_w);
    if (_jsdom_de(ctx)->doc->caja_pase || !jsdom_visible(n)) return JS_NewInt32(ctx, 0);
    return JS_NewInt32(ctx, magic ? 16 : 100);
}

/* __dashweb_caja(node): [x, y, width, height, fixed] of its box in the page (fixed: position: fixed, it goes with the
   window), or null (not laid out, or no layout yet) */
static JSValue _jsdom_caja(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _Dash_Nodo *n = argc > 0 ? _jsdom_nodo(ctx, argv[0]) : NULL;
    JSValue a;
    _jsdom_caja_al_dia(ctx, n);
    if (!n || !jsdom_caja_valida(n, _jsdom_de(ctx)->doc)) return JS_NULL;
    a = JS_NewArray(ctx);
    JS_SetPropertyUint32(ctx, a, 0, JS_NewInt32(ctx, n->caja_x));
    JS_SetPropertyUint32(ctx, a, 1, JS_NewInt32(ctx, n->caja_y));
    JS_SetPropertyUint32(ctx, a, 2, JS_NewInt32(ctx, n->caja_w));
    JS_SetPropertyUint32(ctx, a, 3, JS_NewInt32(ctx, n->caja_h));
    JS_SetPropertyUint32(ctx, a, 4, JS_NewBool(ctx, n->caja_fija));
    {
        /* el sticky más cercano hacia fuera (él incluido): [5..7] = su sitio, su top y lo más abajo que va */
        _Dash_Nodo *p = n;
        LONG pase = _jsdom_de(ctx)->doc->caja_pase;
        while (p && p->pg_pase != pase) p = p->padre;
        if (p) {
            JS_SetPropertyUint32(ctx, a, 5, JS_NewInt32(ctx, p->pg_y0));
            JS_SetPropertyUint32(ctx, a, 6, JS_NewInt32(ctx, p->pg_top));
            JS_SetPropertyUint32(ctx, a, 7, JS_NewInt32(ctx, p->pg_fin));
        }
    }
    return a;
}

/* __dashweb_vista(): [width, height, scroll y, page height] (jsdom_vista) */
/* __dashweb_pedir(id, method, url, headers "k: v\n...", body): a request of XMLHttpRequest/fetch (jsdom_pedir) */
static JSValue _jsdom_pedir(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _JsDom *d = _jsdom_de(ctx);
    int32_t id = 0;
    char *metodo, *url, *cab, *cuerpo;
    if (!d || argc < 5 || JS_ToInt32(ctx, &id, argv[0])) return JS_UNDEFINED;
    metodo = _jsdom_arg(ctx, argc, argv, 1);
    url = _jsdom_arg(ctx, argc, argv, 2);
    cab = _jsdom_arg(ctx, argc, argv, 3);
    cuerpo = _jsdom_arg(ctx, argc, argv, 4);
    if (metodo && url && cab && cuerpo)
        jsdom_pedir(d->motor, id, (STRPTR)metodo, (STRPTR)url, (STRPTR)cab, (STRPTR)cuerpo);
    if (metodo) _jsdom_soltar(metodo);
    if (url) _jsdom_soltar(url);
    if (cab) _jsdom_soltar(cab);
    if (cuerpo) _jsdom_soltar(cuerpo);
    return JS_UNDEFINED;
}

static JSValue _jsdom_vista(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    _JsDom *d = _jsdom_de(ctx);
    JSValue a = JS_NewArray(ctx);
    int i;
    for (i = 0; i < 4; i++) JS_SetPropertyUint32(ctx, a, i, JS_NewInt32(ctx, d ? d->vista[i] : 0));
    return a;
}

/* attributes: [{name, value}] (a copy: changing it does not change the element) */
static JSValue _jsdom_attributes(JSContext *ctx, JSValueConst this_val) {
    JSValue a;
    LONG i, k;
    _JSDOM_ESTE;
    a = JS_NewArray(ctx);
    k = n->atributos ? DashArray_length(n->atributos) : 0;
    for (i = 0; i < k; i++) {
        _Dash_Atributo *at = (_Dash_Atributo *)DashArray_get(n->atributos, i);
        JSValue o = JS_NewObject(ctx);
        JS_SetPropertyStr(ctx, o, "name", _jsdom_cadena(ctx, at->nombre));
        JS_SetPropertyStr(ctx, o, "nodeName", _jsdom_cadena(ctx, at->nombre));
        JS_SetPropertyStr(ctx, o, "value", _jsdom_cadena(ctx, at->valor));
        JS_SetPropertyStr(ctx, o, "nodeValue", _jsdom_cadena(ctx, at->valor));
        JS_SetPropertyStr(ctx, o, "specified", JS_TRUE);
        JS_SetPropertyUint32(ctx, a, i, o);
    }
    return a;
}

/* __dashweb_media("(max-width: 600px)"): matchMedia, como lib/css.dash los @media */
static JSValue _jsdom_media(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
    char *q = _jsdom_arg(ctx, argc, argv, 0);
    BOOL r;
    if (!q) return JS_EXCEPTION;
    r = css_media_vale((STRPTR)q);
    _jsdom_soltar(q);
    return JS_NewBool(ctx, r);
}

static JSValue _jsdom_localName(JSContext *ctx, JSValueConst this_val) {
    _JSDOM_ESTE;
    if (n->tipo != DOM_ELEMENTO) return JS_NULL;
    return _jsdom_cadena(ctx, n->nombre);
}

