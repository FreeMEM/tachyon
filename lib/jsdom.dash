# El DOM para el JavaScript de una página (QuickJS, lib/js.dash): document, getElementById,
# querySelector(All) con los selectores de lib/css.dash, textContent, innerHTML, atributos,
# createElement, appendChild, removeChild... sobre el árbol de lib/dom.dash.
#
#   js = js_nuevo()
#   jsdom_preparar(js, doc)                     # document = doc, eventos y temporizadores
#   jsdom_ejecutar_scripts(js, doc, base)       # los <script> en orden (en línea y src)
#   if jsdom_cambios(js) > 0 ...                # cuántas veces lo cambió el JS (para volver a maquetar)
#   seguir = jsdom_clic(js, nodo)               # evento click (sube hasta document); false: preventDefault
#   espera = jsdom_temporizadores(js)           # los setTimeout/setInterval que tocan; ms al siguiente, -1 si no hay
#   js_liberar(js)                              # suelta también los nodos que tenía el JS
#
# Cada nodo tiene un solo objeto JS (a === b funciona); el objeto sujeta su Nodo hasta js_liberar.
# Los textos van en Latin-1 hacia Dash y en UTF-8 hacia el JS, como en lib/js.dash.

import "js.dash"
import "estilo.dash"
import "formularios.dash"
import "html5.dash"
import "jsdom_preludio.dash"
import "lienzo.dash"
import "traza.dash"

# === La parte en Dash (la llaman las funciones de C de abajo) ===

@export func jsdom_por_id(doc: Nodo, id: String) -> Nodo
    return dom_por_id(doc, id)
end

# Los elementos de dentro de raiz (sin ella) que cumplen el selector (con comas); el primero solo
# si no son todos. Un selector que no se entiende no da ninguno.
@export func jsdom_selector(raiz: Nodo, texto: String, todos: Bool) -> [Nodo]
    var r: [Nodo] = []
    var sels: [Selector] = []
    for t in css_partir(texto, 44)
        if str_trim(t) != ""
            # (uno que no se entiende no casa con nada: getElementsByClassName("\u212a") llega como ".?" y era un
            # selector nil que tiraba el programa; WPT dom/nodes/getElementsByClassName-14)
            sel = css_selector(t)
            if sel != nil
                sels.push(sel)
            end
        end
    end
    for h in raiz.hijos
        if _jsdom_buscar(h, sels, todos, r)
            return r
        end
    end
    return r
end

# true cuando ya no hace falta seguir (encontró uno y no se buscan todos)
func _jsdom_buscar(n: Nodo, sels: [Selector], todos: Bool, r: [Nodo]) -> Bool
    if n.tipo != DOM_ELEMENTO
        return false
    end
    for s in sels
        if estilo_cumple(n, s)
            r.push(n)
            if not todos
                return true
            end
            break
        end
    end
    for h in n.hijos
        if _jsdom_buscar(h, sels, todos, r)
            return true
        end
    end
    return false
end

@export func jsdom_texto(n: Nodo) -> String
    # (el de un comentario o una instrucción, sus datos: DOM)
    if n.tipo == DOM_COMENTARIO or n.tipo == DOM_INSTRUCCION
        return n.texto
    end
    return dom_texto(n)
end

# textContent = t: los hijos se cambian por un texto
@export func jsdom_poner_texto(n: Nodo, t: String)
    if n.tipo == DOM_TEXTO or n.tipo == DOM_COMENTARIO or n.tipo == DOM_INSTRUCCION
        n.texto = t
        # su elemento cambia de contenido (un reloj de React: sin estilo entero, y si no cambia de forma, sin maqueta;
        # lo medido en él y en los de fuera ya no vale: tarea 37e6)
        dom_tocar(n)
        if n.tipo == DOM_TEXTO and n.padre != nil and n.padre.tipo == DOM_ELEMENTO
            dom_apuntar(n.padre, TOQUE_CONTENIDO, "#texto", "", "")
        end
        return
    end
    solo_texto = _jsdom_sin_elementos(n)
    _jsdom_vaciar(n)
    if t != ""
        dom_agregar(n, dom_nodo(DOM_TEXTO, "", t))
    end
    dom_apuntar(n, TOQUE_CONTENIDO, _jsdom_marca_texto(solo_texto), "", "")
end

# (un TOQUE_CONTENIDO en un elemento que no tenía elementos dentro lleva "#texto": no salió ninguno, y los que entran
# se apuntan aparte; a lib/estilo.dash le dice que ningún :has() puede cambiar por él)
func _jsdom_sin_elementos(n: Nodo) -> Bool
    for h in n.hijos
        if h.tipo == DOM_ELEMENTO
            return false
        end
    end
    return true
end

func _jsdom_marca_texto(solo: Bool) -> String
    if solo
        return "#texto"
    end
    return ""
end

# Sin hijos (los que quedan vivos, por ejemplo en el JS, ya no tienen padre)
func _jsdom_vaciar(n: Nodo)
    var nadie: Nodo = nil
    for h in n.hijos
        h.padre = nadie
    end
    n.hijos.clear()
    dom_cambio()
end

@export func jsdom_atributo(n: Nodo, nombre: String) -> String
    return dom_atributo(n, str_lower(nombre))
end

@export func jsdom_tiene_atributo(n: Nodo, nombre: String) -> Bool
    return dom_tiene_atributo(n, str_lower(nombre))
end

@export func jsdom_poner_atributo(n: Nodo, nombre: String, valor: String)
    dom_olvidar_atributos(n)
    clave = str_lower(nombre)
    for a in n.atributos
        if a.nombre == clave
            if a.valor != valor
                dom_apuntar(n, TOQUE_ATRIBUTO, clave, a.valor, valor)
            end
            a.valor = valor
            return
        end
    end
    n.atributos.push(Atributo(clave, valor))
    dom_apuntar(n, TOQUE_ATRIBUTO, clave, "", valor)
end

@export func jsdom_quitar_atributo(n: Nodo, nombre: String)
    dom_olvidar_atributos(n)
    clave = str_lower(nombre)
    i = 0
    while i < n.atributos.length
        a = n.atributos[i]
        if a.nombre == clave
            dom_apuntar(n, TOQUE_ATRIBUTO, clave, a.valor, "")
            n.atributos.remove(i)
            return
        end
        i = i + 1
    end
end

@export func jsdom_valor(n: Nodo) -> String
    return formulario_valor(n)
end

@export func jsdom_poner_valor(n: Nodo, v: String)
    formulario_poner_valor(n, v)
    dom_apuntar(n, TOQUE_ATRIBUTO, "value", "", v)
end

# checked (input) y selected (option): el estado, no el atributo (tarea 41c)
@export func jsdom_marcado(n: Nodo) -> Bool
    return dom_marcado(n)
end

@export func jsdom_marcar(n: Nodo, si: Bool)
    formulario_marcar(n, si)
    dom_apuntar(n, TOQUE_ATRIBUTO, "checked", "", "")
end

@export func jsdom_crear(nombre: String) -> Nodo
    return dom_nodo(DOM_ELEMENTO, str_lower(nombre), "")
end

@export func jsdom_crear_texto(t: String) -> Nodo
    return dom_nodo(DOM_TEXTO, "", t)
end

# hijo pasa al final de padre (si estaba en otro sitio, sale de allí); false si hijo contiene a padre
# (un fragmento mete sus hijos)
@export func jsdom_agregar(padre: Nodo, hijo: Nodo) -> Bool
    var nadie: Nodo = nil
    return jsdom_insertar_antes(padre, hijo, nadie)
end

@export func jsdom_quitar(padre: Nodo, hijo: Nodo) -> Bool
    i = 0
    while i < padre.hijos.length
        if padre.hijos[i] == hijo
            if hijo.tipo == DOM_ELEMENTO
                dom_apuntar_salida(padre, hijo)
                dom_apuntar(dom_hermano_elemento(hijo, false), TOQUE_VECINO, "", "", "")
                dom_apuntar(dom_hermano_elemento(hijo, true), TOQUE_VECINO, "", "", "")
            else
                # (un texto que sale cambia lo de dentro del padre, como uno que entra: :empty; Acid3 38)
                dom_apuntar(padre, TOQUE_CONTENIDO, "#texto", "", "")
            end
            var nadie: Nodo = nil
            hijo.padre = nadie
            padre.hijos.remove(i)
            dom_cambio()
            return true
        end
        i = i + 1
    end
    return false
end

@export func jsdom_padre(n: Nodo) -> Nodo
    return n.padre
end

# Los hijos (solo los elementos, o todos)
@export func jsdom_hijos(n: Nodo, solo_elementos: Bool) -> [Nodo]
    var r: [Nodo] = []
    for h in n.hijos
        if not solo_elementos or h.tipo == DOM_ELEMENTO
            r.push(h)
        end
    end
    return r
end

# innerHTML: el HTML de los hijos
@export func jsdom_html(n: Nodo) -> String
    r = ""
    for h in n.hijos
        r = r + _jsdom_html_nodo(h)
    end
    return r
end

func _jsdom_html_nodo(n: Nodo) -> String
    if n.tipo == DOM_TEXTO
        if n.padre != nil and (n.padre.nombre == "script" or n.padre.nombre == "style")
            return n.texto
        end
        return _jsdom_escapar(n.texto, false)
    elif n.tipo == DOM_COMENTARIO
        return "<!--" + n.texto + "-->"
    elif n.tipo == DOM_TIPO_DOC
        return "<!DOCTYPE " + n.nombre + ">"
    elif n.tipo == DOM_INSTRUCCION
        return "<?" + n.nombre + " " + n.texto + ">"
    elif n.tipo != DOM_ELEMENTO
        return ""
    end
    r = "<" + n.nombre
    for a in n.atributos
        r = r + " " + a.nombre + "=\"" + _jsdom_escapar(a.valor, true) + "\""
    end
    r = r + ">"
    if dom_es_vacio(n.nombre)
        return r
    end
    return r + jsdom_html(n) + "</" + n.nombre + ">"
end

func _jsdom_escapar(t: String, atributo: Bool) -> String
    r = str_replace(str_replace(str_replace(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
    if atributo
        r = str_replace(r, "\"", "&quot;")
    end
    return r
end

# innerHTML = html: los hijos se cambian por lo que da ese HTML (leído como el cuerpo de una página)
@export func jsdom_poner_html(n: Nodo, html: String)
    solo_texto = _jsdom_sin_elementos(n)
    _jsdom_vaciar(n)
    dom_apuntar(n, TOQUE_CONTENIDO, _jsdom_marca_texto(solo_texto), "", "")
    # (con las reglas de HTML5, como una página: <table><tr> lleva su <tbody>, Acid3 29; dentro de una tabla o un
    # select, donde el contexto cambia las reglas, con el lector sencillo)
    var trozo: Nodo = nil
    if n.nombre == "table" or n.nombre == "thead" or n.nombre == "tbody" or n.nombre == "tfoot" or n.nombre == "tr" or n.nombre == "colgroup" or n.nombre == "select" or n.nombre == "optgroup" or n.nombre == "html" or n.nombre == "head" or n.nombre == "template"
        trozo = dom_desde_html("<body>" + html)
    else
        trozo = dom_desde_html5("<body>" + html)
    end
    cuerpo = dom_buscar(trozo, "body")
    if cuerpo == nil
        return
    end
    for h in jsdom_hijos(cuerpo, false)
        jsdom_agregar(n, h)
    end
end

# === Más DOM (tarea 25: lo que necesita jQuery) ===

# El hermano de al lado (después o antes; solo elementos o cualquier nodo); nil si no hay
@export func jsdom_hermano(n: Nodo, despues: Bool, solo_elementos: Bool) -> Nodo
    var nada: Nodo = nil
    p = n.padre
    if p == nil
        return nada
    end
    k = p.hijos.length
    i = 0
    while i < k and p.hijos[i] != n
        i = i + 1
    end
    paso = -1
    if despues
        paso = 1
    end
    j = i + paso
    while j >= 0 and j < k
        h = p.hijos[j]
        if not solo_elementos or h.tipo == DOM_ELEMENTO
            return h
        end
        j = j + paso
    end
    return nada
end

# nuevo entra en padre antes de ref (al final si ref es nil); un fragmento mete sus hijos. false si
# ref no es hijo de padre o nuevo contiene a padre.
@export func jsdom_insertar_antes(padre: Nodo, nuevo: Nodo, ref: Nodo) -> Bool
    if nuevo.tipo == DOM_FRAGMENTO
        for h in jsdom_hijos(nuevo, false)
            if not jsdom_insertar_antes(padre, h, ref)
                return false
            end
        end
        return true
    end
    p = padre
    while p != nil
        if p == nuevo
            return false
        end
        p = p.padre
    end
    if ref == nuevo
        return true
    end
    if nuevo.padre != nil
        jsdom_quitar(nuevo.padre, nuevo)
    end
    if ref == nil
        dom_agregar(padre, nuevo)
        _jsdom_entra(nuevo)
        return true
    end
    i = 0
    while i < padre.hijos.length
        if padre.hijos[i] == ref
            padre.hijos.insert(i, nuevo)
            dom_cambio()
            nuevo.padre = padre
            _jsdom_entra(nuevo)
            return true
        end
        i = i + 1
    end
    return false
end

# Un nodo que acaba de entrar en el árbol: él y sus vecinos (por + y :first-child...)
func _jsdom_entra(n: Nodo)
    if n.tipo != DOM_ELEMENTO
        if n.padre != nil
            dom_apuntar(n.padre, TOQUE_CONTENIDO, "#texto", "", "")
        end
        return
    end
    dom_apuntar(n, TOQUE_ENTRA, "", "", "")
    dom_apuntar(dom_hermano_elemento(n, false), TOQUE_VECINO, "", "", "")
    dom_apuntar(dom_hermano_elemento(n, true), TOQUE_VECINO, "", "", "")
end

# Una copia de n (con sus hijos si profundo), sin padre
@export func jsdom_clonar(n: Nodo, profundo: Bool) -> Nodo
    c = dom_nodo(n.tipo, n.nombre, n.texto)
    for a in n.atributos
        c.atributos.push(Atributo(a.nombre, a.valor))
    end
    # (con su value y su checked, como en un navegador)
    c.valor = n.valor
    c.marcado = n.marcado
    if profundo
        for h in n.hijos
            dom_agregar(c, jsdom_clonar(h, true))
        end
    end
    return c
end

# ¿b está dentro de a (o es a)?
@export func jsdom_contiene(a: Nodo, b: Nodo) -> Bool
    p = b
    while p != nil
        if p == a
            return true
        end
        p = p.padre
    end
    return false
end

# compareDocumentPosition: 1 sin relación, 2 b va antes, 4 b va después, 8 b contiene a a,
# 16 a contiene a b
@export func jsdom_posicion(a: Nodo, b: Nodo) -> Int
    if a == b
        return 0
    end
    if jsdom_contiene(b, a)
        return 8 + 2
    end
    if jsdom_contiene(a, b)
        return 16 + 4
    end
    ra = _jsdom_raiz_de(a)
    if ra != _jsdom_raiz_de(b)
        return 1 + 32 + 4
    end
    # el primer antepasado común y cuál de sus hijos va antes
    var camino: [Nodo] = []
    p = a
    while p != nil
        camino.push(p)
        p = p.padre
    end
    hb = b
    q = b.padre
    while q != nil
        i = 0
        while i < camino.length and camino[i] != q
            i = i + 1
        end
        if i < camino.length
            ha = camino[i - 1]
            for h in q.hijos
                if h == ha
                    return 4
                end
                if h == hb
                    return 2
                end
            end
            return 1
        end
        hb = q
        q = q.padre
    end
    return 1
end

func _jsdom_raiz_de(n: Nodo) -> Nodo
    p = n
    while p.padre != nil
        p = p.padre
    end
    return p
end

# ¿Se entiende el selector? (si no, querySelector y matches dan un SyntaxError, como en los
# navegadores, y jQuery usa su propio buscador)
@export func jsdom_selector_valido(texto: String) -> Bool
    hay = false
    for t in css_partir(texto, 44)
        if str_trim(t) == ""
            return false
        end
        sel = css_selector(t)
        if sel == nil or not estilo_puede_cumplirse(sel)
            return false
        end
        hay = true
    end
    return hay
end

# matches(): ¿n cumple alguno de los selectores?
@export func jsdom_cumple(n: Nodo, texto: String) -> Bool
    for t in css_partir(texto, 44)
        sel = css_selector(t)
        if sel != nil and estilo_cumple(n, sel)
            return true
        end
    end
    return false
end

@export func jsdom_crear_comentario(t: String) -> Nodo
    return dom_nodo(DOM_COMENTARIO, "", t)
end

# document.createProcessingInstruction()
@export func jsdom_crear_instruccion(destino: String, datos: String) -> Nodo
    return dom_nodo(DOM_INSTRUCCION, destino, datos)
end

# document.implementation.createDocumentType()
@export func jsdom_crear_tipo_doc(nombre: String, publico: String, sistema: String) -> Nodo
    return dom_tipo_doc(nombre, publico, sistema)
end

@export func jsdom_crear_fragmento() -> Nodo
    return dom_nodo(DOM_FRAGMENTO, "", "")
end

# document.implementation.createHTMLDocument(): un documento aparte, vacío
# (con "aparte": su getComputedStyle calcula el estilo con sus propias hojas, _jsdom_estilo_aparte)
@export func jsdom_documento_nuevo(titulo: String) -> Nodo
    d = dom_desde_html("<html><head><title>" + titulo + "</title></head><body></body></html>")
    d.atributos.push(Atributo("aparte", "1"))
    # (con su <!DOCTYPE html> delante, como dice DOM)
    t = dom_tipo_doc("html", "", "")
    t.padre = d
    d.hijos.insert(0, t)
    return d
end

# El documento de un <iframe> u <object> con el HTML que trajo (tarea 41c), con las reglas de HTML5 como una página
@export func jsdom_documento_html(html: String) -> Nodo
    d = dom_desde_html5(html)
    d.atributos.push(Atributo("aparte", "1"))
    return d
end

# El estilo de un documento aparte (el de un <iframe> u <object>, el de createHTMLDocument), que no tiene hojas
# apuntadas ni maqueta: se calcula entero con sus <style> cuando cambió algo o aún no se calculó. Acid3 mete en el
# documento de su iframe un <style> con cada selector y mira el z-index de lo de dentro (tarea 41c).
func _jsdom_estilo_aparte(n: Nodo)
    doc = n
    while doc.padre != nil
        doc = doc.padre
    end
    if doc.tipo != DOM_DOCUMENTO or dom_atributo(doc, "aparte") != "1"
        return
    end
    var raiz: Nodo = nil
    for h in doc.hijos
        if h.tipo == DOM_ELEMENTO
            raiz = h
            break
        end
    end
    if raiz == nil or (raiz.estilo != nil and (doc.toques == nil or doc.toques.length == 0))
        return
    end
    # (con la ventana del marco: su ancho y alto, que pone el JavaScript en "vista"; para @media, vw y vh)
    aw = css_vista_ancho()
    ah = css_alto_vista()
    vista = str_split(dom_atributo(doc, "vista"), " ")
    if vista.length == 2
        css_vista(Int(vista[0]), Int(vista[1]))
    end
    var traidas: {String: String} = {}
    hojas = estilo_hojas_con(doc, "", traidas)
    estilo_aplicar(doc, hojas)
    css_vista(aw, ah)
    var nada: [Toque] = nil
    doc.toques = nada
end

# outerHTML
@export func jsdom_html_fuera(n: Nodo) -> String
    return _jsdom_html_nodo(n)
end

@export func jsdom_cabeza(doc: Nodo) -> Nodo
    return dom_buscar(doc, "head")
end

# getComputedStyle: lo calculado por lib/estilo.dash; si el elemento es nuevo (sin estilo aún),
# display según la etiqueta
@export func jsdom_estilo_calculado(n: Nodo, propiedad: String) -> String
    _jsdom_estilo_aparte(n)
    e = n.estilo
    fresco = _jsdom_estilo_fresco(n)
    if fresco != nil
        e = fresco
    end
    if e != nil and e.has(propiedad)
        return e[propiedad]
    end
    if propiedad == "display" and n.tipo == DOM_ELEMENTO
        if jsdom_cumple(n, "html, body, div, p, h1, h2, h3, h4, h5, h6, ul, ol, dl, pre, blockquote, form, table, header, footer, nav, section, article, aside, main, figure, fieldset, address, hr")
            return "block"
        elif n.nombre == "li"
            return "list-item"
        elif jsdom_cumple(n, "head, script, style, title, meta, link, template")
            return "none"
        end
        return "inline"
    end
    # lo que no dice ninguna regla: su valor inicial, como en un navegador (iron-fit-behavior de Polymer, en el diálogo de
    # cookies de YouTube, mira top !== 'auto' para saber si ya está colocado: con "" no se ponía position: fixed y el
    # diálogo quedaba debajo de su fondo; tarea 38c5)
    if _jsdom_iniciales == nil
        var d: {String: String} = {}
        for par in css_partir(JSDOM_INICIALES, 32)
            dos = css_partir(par, 61)
            if dos.length == 2
                d[dos[0]] = dos[1]
            end
        end
        _jsdom_iniciales = d
    end
    if _jsdom_iniciales.has(propiedad)
        return _jsdom_iniciales[propiedad]
    end
    return ""
end

var _jsdom_iniciales: {String: String} = nil

# Las hojas de cada documento con JavaScript (lib/documento.dash las apunta y las quita): con ellas, getComputedStyle
# calcula al momento el estilo de un elemento que tiene cambios sin estilo aún, él o uno de arriba (como un navegador;
# estilo_calcular_uno, tarea 38c5)
var _jsdom_docs: [Nodo] = []
var _jsdom_hojas: [Hojas] = []
# (el último calculado así, mientras no haya más cambios: iron-fit pide top, left, bottom, right... seguidos)
var _jsdom_fresco_nodo: Nodo = nil
var _jsdom_fresco_ultimo: Toque = nil
var _jsdom_fresco_cuantos: Int = 0
var _jsdom_fresco: {String: String} = nil

func jsdom_poner_hojas(doc: Nodo, h: Hojas)
    i = 0
    while i < _jsdom_docs.length
        if _jsdom_docs[i] == doc
            _jsdom_hojas[i] = h
            return
        end
        i = i + 1
    end
    _jsdom_docs.push(doc)
    _jsdom_hojas.push(h)
end

func jsdom_quitar_hojas(doc: Nodo)
    var docs: [Nodo] = []
    var hojas: [Hojas] = []
    i = 0
    while i < _jsdom_docs.length
        if _jsdom_docs[i] != doc
            docs.push(_jsdom_docs[i])
            hojas.push(_jsdom_hojas[i])
        end
        i = i + 1
    end
    _jsdom_docs = docs
    _jsdom_hojas = hojas
    var nadie: Nodo = nil
    _jsdom_fresco_nodo = nadie
    var ninguno: Toque = nil
    _jsdom_fresco_ultimo = ninguno
    var nada: {String: String} = nil
    _jsdom_fresco = nada
end

# El estilo de n al momento si él o uno de arriba tiene cambios del JavaScript sin estilo aún; nil si no
func _jsdom_estilo_fresco(n: Nodo) -> {String: String}
    var nada: {String: String} = nil
    if n.tipo != DOM_ELEMENTO
        return nada
    end
    doc = n
    while doc.padre != nil
        doc = doc.padre
    end
    if doc.tipo != DOM_DOCUMENTO or doc.toques == nil or doc.toques.length == 0
        return nada
    end
    ultimo = doc.toques[doc.toques.length - 1]
    if n == _jsdom_fresco_nodo and ultimo == _jsdom_fresco_ultimo and doc.toques.length == _jsdom_fresco_cuantos
        return _jsdom_fresco
    end
    var hojas: Hojas = nil
    i = 0
    while i < _jsdom_docs.length
        if _jsdom_docs[i] == doc
            hojas = _jsdom_hojas[i]
        end
        i = i + 1
    end
    if hojas == nil
        return nada
    end
    # el de más arriba con cambios (con demasiados para apuntarlos, todos)
    var cadena: [Nodo] = []
    p = n
    while p != nil and p.tipo == DOM_ELEMENTO
        cadena.push(p)
        p = p.padre
    end
    alto = -1
    for t in doc.toques
        if t.tipo == TOQUE_TODO
            alto = cadena.length - 1
            break
        end
        k = cadena.length - 1
        while k > alto
            if t.nodo == cadena[k]
                alto = k
            end
            k = k - 1
        end
    end
    # (<html> no se calcula así: el de debajo)
    if alto > cadena.length - 2
        alto = cadena.length - 2
    end
    if alto < 0
        return nada
    end
    _jsdom_fresco = estilo_calcular_uno(n, cadena[alto], hojas)
    _jsdom_fresco_nodo = n
    _jsdom_fresco_ultimo = ultimo
    _jsdom_fresco_cuantos = doc.toques.length
    return _jsdom_fresco
end
const JSDOM_INICIALES = "top=auto right=auto bottom=auto left=auto z-index=auto position=static float=none clear=none max-width=none max-height=none min-width=0px min-height=0px margin-top=0px margin-right=0px margin-bottom=0px margin-left=0px padding-top=0px padding-right=0px padding-bottom=0px padding-left=0px border-top-width=0px border-right-width=0px border-bottom-width=0px border-left-width=0px opacity=1 visibility=visible transform=none overflow=visible overflow-x=visible overflow-y=visible box-sizing=content-box flex-grow=0 flex-shrink=1 flex-basis=auto pointer-events=auto direction=ltr animation-name=none transition-duration=0s cursor=auto white-space=normal text-transform=none visibility=visible"

# === XMLHttpRequest y fetch (tarea 37e2) ===
# Las peticiones del JavaScript de cada motor van sin esperar (lib/http.dash); jsdom_peticiones_avanzar, en cada
# tic de dashweb, las avanza y da al JavaScript las que acaban (__dashweb_respuesta)

struct PeticionJS
    js: Int
    id: Int
    carga: Carga
    # (en cola: aún sin carga, con lo que hace falta para empezarla)
    en_cola: Bool = false
    metodo: String = ""
    url: String = ""
    cuerpo: String = ""
    tipo: String = ""
    extra: String = ""
end

# Las que van a la vez por motor; las demás esperan en cola (YouTube lanza decenas y llenaba la tabla de 48
# conexiones de la red: "demasiadas conexiones" al ir a otra página). Chrome hace 6 por servidor.
const JSDOM_PETICIONES_A_LA_VEZ = 6

func _jsdom_peticiones_activas(js: Int) -> Int
    n = 0
    for p in jsdom_peticiones
        if p.js == js and p.carga != nil
            n = n + 1
        end
    end
    return n
end

# Empieza las de la cola de ese motor mientras haya sitio
func _jsdom_peticiones_empezar(js: Int)
    activas = _jsdom_peticiones_activas(js)
    for p in jsdom_peticiones
        if activas >= JSDOM_PETICIONES_A_LA_VEZ
            return
        end
        if p.js == js and p.en_cola
            p.en_cola = false
            p.carga = http_empezar_metodo(p.url, p.metodo, p.cuerpo, p.tipo, p.extra, 20000)
            activas = activas + 1
        end
    end
end

var jsdom_peticiones: [PeticionJS] = []

# (desde __dashweb_pedir) cabeceras: "Nombre: valor" por línea; las que pone el navegador no se dejan cambiar
@export func jsdom_pedir(js: Int, id: Int, metodo: String, url: String, cabeceras: String, cuerpo: String)
    tipo = ""
    extra = ""
    for linea in str_split(cabeceras, "\n")
        p = str_find(linea, ":")
        if p <= 0
            continue
        end
        nombre = str_lower(str_trim(linea[:p]))
        valor = str_trim(linea[p + 1:])
        if nombre == "content-type"
            tipo = valor
        elif nombre == "host" or nombre == "content-length" or nombre == "cookie" or nombre == "connection" or nombre == "user-agent" or nombre == "accept-encoding" or str_starts(nombre, "sec-") or str_starts(nombre, "proxy-")
            continue
        else
            if extra != ""
                extra = extra + "\r\n"
            end
            extra = extra + str_trim(linea[:p]) + ": " + valor
        end
    end
    if tipo == "" and cuerpo != "" and metodo != "GET"
        tipo = "text/plain;charset=UTF-8"
    end
    if URL_RASTREO_BLOQUEAR and url_rastreador(url)
        # (un rastreador: no se pide; en el siguiente avance, un error de red; también los <script> que mete el
        # JavaScript, que van por aquí)
        var sin: Carga = nil
        jsdom_peticiones.push(PeticionJS(js, id, sin))
        return
    end
    var nada: Carga = nil
    p = PeticionJS(js, id, nada)
    p.en_cola = true
    p.metodo = metodo
    p.url = url
    p.cuerpo = cuerpo
    p.tipo = tipo
    p.extra = extra
    jsdom_peticiones.push(p)
    _jsdom_peticiones_empezar(js)
end

# Avanza las peticiones de ese motor; cuántas acabaron (ya entregadas al JavaScript)
func jsdom_peticiones_avanzar(js: Int) -> Int
    hechas = 0
    i = 0
    while i < jsdom_peticiones.length
        p = jsdom_peticiones[i]
        if p.js == js and p.en_cola
            i = i + 1
            continue
        end
        if p.js == js and p.carga == nil
            jsdom_peticiones.remove(i)
            _jsdom_responder(js, p.id, 0, "", "", "", "", "bloqueado (rastreo)")
            hechas = hechas + 1
            continue
        end
        if p.js == js and http_avanzar(p.carga)
            r = p.carga.respuesta
            cab = ""
            for k in r.cabeceras.keys()
                cab = cab + k + ": " + r.cabeceras[k] + "\r\n"
            end
            jsdom_peticiones.remove(i)
            _jsdom_responder(js, p.id, r.estado, r.razon, cab, r.url, r.cuerpo, r.error)
            hechas = hechas + 1
            continue
        end
        i = i + 1
    end
    if hechas > 0
        _jsdom_peticiones_empezar(js)
    end
    return hechas
end

func jsdom_peticiones_pendientes(js: Int) -> Int
    n = 0
    for p in jsdom_peticiones
        if p.js == js
            n = n + 1
        end
    end
    return n
end

# Las de un motor que se va (antes de js_liberar: su respuesta ya no tiene a quién ir)
func jsdom_peticiones_cancelar(js: Int)
    i = 0
    while i < jsdom_peticiones.length
        if jsdom_peticiones[i].js == js
            if jsdom_peticiones[i].carga != nil
                http_cancelar(jsdom_peticiones[i].carga)
            end
            jsdom_peticiones.remove(i)
            continue
        end
        i = i + 1
    end
end

# ¿Tiene n una caja de la última maqueta de doc? (lib/maqueta.dash la pone en sus campos caja_*)
@export func jsdom_caja_valida(n: Nodo, doc: Nodo) -> Bool
    return doc != nil and doc.caja_pase != 0 and n.caja_pase == doc.caja_pase
end

# ¿Se ve? (offsetWidth/offsetHeight: sin posiciones de la maqueta, 0 si él o un antepasado tiene
# display: none, en su estilo o en el atributo style; 1 si no; 0 fuera del documento)
@export func jsdom_visible(n: Nodo) -> Bool
    p = n
    while p != nil and p.tipo == DOM_ELEMENTO
        # el atributo style manda sobre lo calculado (puede haberlo cambiado el JS después)
        s = str_replace(str_lower(dom_atributo(p, "style")), " ", "")
        k = str_find(s, "display:")
        if k >= 0
            v = s[k + 8:]
            fin = str_find(v, ";")
            if fin >= 0
                v = v[:fin]
            end
            if v == "none"
                return false
            end
        elif p.estilo.has("display") and p.estilo["display"] == "none"
            return false
        end
        p = p.padre
    end
    return p != nil and p.tipo == DOM_DOCUMENTO
end

@export func jsdom_cuerpo(doc: Nodo) -> Nodo
    return dom_buscar(doc, "body")
end

@export func jsdom_raiz(doc: Nodo) -> Nodo
    return dom_buscar(doc, "html")
end

# location.assign, replace, href = ... (y window.location = ...) del JavaScript de la página (tarea 51; la página de
# salto de DuckDuckGo hace window.parent.location.replace(destino)): la dirección y si sustituye a la de la página en
# el historial, en el documento (sus atributos "ir" e "ir_sustituir"); dashweb la abre en el siguiente tic
@export func jsdom_navegar(doc: Nodo, u: String, sustituir: Bool)
    _jsdom_doc_atributo(doc, "ir", u)
    s = ""
    if sustituir
        s = "1"
    end
    _jsdom_doc_atributo(doc, "ir_sustituir", s)
end

func _jsdom_doc_atributo(doc: Nodo, nombre: String, valor: String)
    for a in doc.atributos
        if a.nombre == nombre
            a.valor = valor
            return
        end
    end
    doc.atributos.push(Atributo(nombre, valor))
end

@export func jsdom_titulo(doc: Nodo) -> String
    t = dom_buscar(doc, "title")
    if t == nil
        return ""
    end
    return str_trim(dom_texto(t))
end

# El <script> que se está ejecutando (document.currentScript; nil entre uno y otro)
var jsdom_script_actual: Nodo = nil

@export func jsdom_script_en_curso() -> Nodo
    return jsdom_script_actual
end

# Ejecuta los <script> del documento en orden: los de dentro y los de src (http(s) o fichero,
# relativo a base). Solo JavaScript (sin type, o type text/javascript, module no). Un error se
# escribe en la salida y se sigue con el siguiente. Cuántos se ejecutaron.
func jsdom_ejecutar_scripts(js: Int, doc: Nodo, base: String) -> Int
    var traidos: {String: String} = {}
    var cuerpos: {String: Respuesta} = {}
    return jsdom_ejecutar_scripts_con(js, doc, base, traidos, cuerpos)
end

# Lo mismo con los src ya traídos (dirección -> texto, o en cuerpos su respuesta en UTF-8; lib/recursos.dash); los que
# falten se piden
func jsdom_ejecutar_scripts_con(js: Int, doc: Nodo, base: String, traidos: {String: String}, cuerpos: {String: Respuesta}) -> Int
    var scripts: [Nodo] = []
    _jsdom_scripts(doc, scripts)
    hechos = 0
    u = url_parse(base)
    js_evaluar(js, "__dashweb_lugar('" + str_replace(str_replace(base, "\\", "\\\\"), "'", "\\'") + "')", "dashweb")
    for s in scripts
        tipo = str_lower(str_trim(dom_atributo(s, "type")))
        if tipo == "" or tipo == "text/javascript" or tipo == "application/javascript"
            nombre = base
            traido = false
            if dom_tiene_atributo(s, "src")
                nombre = url_text(url_resolve(u, dom_atributo(s, "src")))
                if url_es_data(str_trim(dom_atributo(s, "src")))
                    nombre = str_trim(dom_atributo(s, "src"))
                end
                traido = traidos.has(nombre)
            end
            jsdom_script_actual = s
            t0 = time_ms()
            largo = 0
            if traido
                # el traído, sin copiarlo a una variable (Dash copia el texto: el de YouTube son 10,8 MB, y tras otra
                # página no había dos huecos así; tarea 38c8) y fuera en cuanto se ha ejecutado
                if cuerpos.has(nombre)
                    # (la respuesta en una variable: su cuerpo va prestado, sin copia)
                    rc = cuerpos[nombre]
                    cuerpos.remove(nombre)
                    largo = rc.cuerpo.length
                    js_evaluar_utf8(js, rc.cuerpo, nombre)
                    rc.cuerpo = ""
                else
                    largo = traidos[nombre].length
                    js_evaluar(js, traidos[nombre], nombre)
                end
                traidos.remove(nombre)
            else
                codigo = dom_texto(s)
                if nombre != base
                    codigo = _jsdom_traer(nombre)
                end
                largo = codigo.length
                js_evaluar(js, codigo, nombre)
            end
            if traza_activa and time_ms() - t0 >= 1000
                traza("script de " + largo + " bytes en " + (time_ms() - t0) + " ms (compilar " + js_ms_compilar() + "): " + nombre)
            end
            if traza_activa and nombre != base and largo == 0
                traza("script vacío: " + nombre)
            end
            var ninguno: Nodo = nil
            jsdom_script_actual = ninguno
            if js_error(js) != ""
                registro_decir("JS: " + str_replace(js_error(js), "\n    ", " | "))
            end
            hechos = hechos + 1
        end
    end
    # DOMContentLoaded y load, como un navegador al acabar la página
    js_evaluar(js, "__dashweb_cargado()", "dashweb")
    # con QuickJS y dashweb compilados con -DJS_PERFIL, el perfil del JavaScript de la página (si no, nada)
    js_perfil_volcar(js, 40)
    if js_error(js) != ""
        registro_decir("JS: " + str_replace(js_error(js), "\n    ", " | "))
    end
    return hechos
end

func _jsdom_scripts(n: Nodo, r: [Nodo])
    if n.tipo == DOM_ELEMENTO and n.nombre == "script"
        r.push(n)
    end
    for h in n.hijos
        _jsdom_scripts(h, r)
    end
end

func _jsdom_traer(direccion: String) -> String
    if url_es_data(direccion)
        return _jsdom_data(direccion)
    end
    u = url_parse(direccion)
    if URL_RASTREO_BLOQUEAR and url_rastreador(direccion)
        return URL_RASTREO_SUSTITUTO
    end
    if u.esquema == "http" or u.esquema == "https"
        r = http_get(direccion, 15000)
        if r.error != "" or r.estado != 200
            return ""
        end
        return texto_decodificar_js(r.cuerpo, r.juego)
    end
    ruta = url_fichero(direccion)
    t = file_read_text(ruta)
    if t == nil
        return ""
    end
    return utf8_a_js_ascii(t)
end

# Lo de dentro de una dirección data: (un <script src="data:text/javascript,...">, en claro o en base64, con escapes %
# y blancos; Acid3 97): el base64, por un fichero de T: (base64_to_file, como las imágenes)
func _jsdom_data(direccion: String) -> String
    coma = str_find(direccion, ",")
    if coma < 0
        return ""
    end
    cabecera = str_lower(direccion[5:coma])
    datos = url_deshacer(direccion[coma + 1:])
    if not str_ends(cabecera, ";base64")
        return utf8_a_js_ascii(datos)
    end
    fichero = "T:tachyon_data.js"
    if base64_to_file(datos, fichero) < 0
        return ""
    end
    t = file_read_text(fichero)
    file_delete(fichero)
    if t == nil
        return ""
    end
    return utf8_a_js_ascii(t)
end

# === La parte en C: los objetos JS de los nodos ===


# === CanvasRenderingContext2D (tarea 48a): lo que pide el JavaScript, al dibujo de lib/lienzo.dash ===

# document = doc en el motor js (una sola vez por motor); jsdom_preparar pone además el preludio
@extern("jsdom") func jsdom_motor_dom(js: Int, doc: Nodo)

# Lo que se ve de la página en la ventana, para el JavaScript (innerWidth/innerHeight, scrollY, el alto de la
# página): dashweb lo pone al pintar y al desplazar
@extern("jsdom") func jsdom_vista(js: Int, ancho: Int, alto: Int, desde: Int, total: Int)

# El desplazamiento que pidió el JavaScript (scrollTo, scrollIntoView, scrollTop...), en px desde arriba de la
# página; -1 si ninguno. Lo olvida.
@extern("jsdom") func jsdom_desplazamiento(js: Int) -> Int

# La vista se ha movido: el evento scroll en document (y window) para el JavaScript
@extern("jsdom") func jsdom_desplazado(js: Int)

# Los IntersectionObserver de la página (tarea 37e): con todo, todos (tras maquetar o desplazar); si no, solo si
# alguien llamó a observe desde la última vez
@extern("jsdom") func jsdom_intersecciones(js: Int, todo: Bool)

# __dashweb_respuesta(id, estado, razón, cabeceras, url, texto, bytes, error): el cuerpo como texto (sus bytes
# tal cual, que QuickJS lee como UTF-8) y como ArrayBuffer
@extern("jsdom") func _jsdom_responder(js: Int, id: Int, estado: Int, razon: String, cabeceras: String, url: String, cuerpo: String, error: String)

# Cuántas veces cambió el JS el documento desde jsdom_preparar
@extern("jsdom") func jsdom_cambios(js: Int) -> Int

var _jsdom_preludio: String = ""

# navigator.language de las páginas ("es-ES"): lo pone el programa con el idioma de Locale
var jsdom_idioma: String = "en-US"

# document = doc en el motor js, con eventos y temporizadores (una sola vez por motor)
func jsdom_preparar(js: Int, doc: Nodo)
    jsdom_motor_dom(js, doc)
    js_evaluar(js, "var __dashweb_idioma = '" + jsdom_idioma + "';", "dashweb")
    # (el texto, hecho una vez: son 2272 líneas juntadas)
    if _jsdom_preludio == ""
        _jsdom_preludio = jsdom_preludio_js()
    end
    js_evaluar_guardado(js, _jsdom_preludio, "dashweb")
    if js_error(js) != ""
        registro_decir("JS: " + js_error(js))
    end
end

# document.cookie (lib/cookies.dash, sin las HttpOnly)
@export func jsdom_galletas(direccion: String) -> String
    return cookies_js(url_parse(direccion))
end

@export func jsdom_galleta(direccion: String, v: String)
    cookies_poner(url_parse(direccion), v, false)
end

# Un clic en n: el evento click sube de n hasta document. false si alguien llamó a preventDefault
# (o devolvió false en onclick): entonces no se sigue el enlace.
@extern("jsdom") func jsdom_clic(js: Int, n: Nodo) -> Bool

# El ratón sobre la página (tarea 37f3): nuevo es el elemento de debajo (nil: fuera), viejo el de antes; x, y en
# coordenadas de la vista. Lanza out/leave, over/enter y move (pointer* y mouse*), como los navegadores.
@extern("jsdom") func jsdom_raton(js: Int, nuevo: Nodo, viejo: Nodo, x: Int, y: Int)

# Ejecuta los setTimeout/setInterval que ya tocan; los ms que faltan para el siguiente, o -1
@extern("jsdom") func jsdom_temporizadores(js: Int) -> Int

# Un evento de ese tipo en n (sube hasta document); false si se paró (preventDefault, "return false")
@extern("jsdom") func jsdom_evento(js: Int, n: Nodo, tipo: String) -> Bool

# El formulario que el JavaScript mandó enviar con form.submit() (y lo olvida), o nil
@extern("jsdom") func jsdom_envio(js: Int) -> Nodo

