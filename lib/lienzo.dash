# Canvas 2D (tarea 48a): el dibujo de un <canvas>, en C y pensado para un Amiga. Cada lienzo es un búfer RGB de 24
# bits (el formato de gfx_rgb_draw_scaled, el mismo del vídeo); el JavaScript de la página dibuja en él con
# CanvasRenderingContext2D (lib/jsdom.dash, que llama a esto) y el pintor lo vuelca escalado a su caja.
#
# Para que vaya en un 68k:
# - Un lienzo grande (más de LZ_GRANDE píxeles) se dibuja a la mitad de su tamaño y se vuelca al doble (4 veces menos
#   píxeles que mezclar; en una pantalla de 16 bits, gfx_rgb_draw_scaled tiene un camino rápido para el doble).
# - Los colores (fillStyle = "rgba(...)"), leídos una vez: una caché de los últimos LZ_CACHE textos.
# - fillRect sin giro va por filas (opaco: copiando; translúcido: una mezcla por canal con enteros).
# - Las líneas de hasta 1,5 px son de un píxel (DDA con mezcla); las más gruesas, un polígono.
# - Los rellenos, por líneas horizontales (par-impar) sobre los tramos ya en coordenadas del búfer.
# - Lo transparente se aproxima con el color de detrás del lienzo (fondo): clearRect lo pone.
# - Cada lienzo sabe qué zona suya cambió (sucio): se repinta solo esa parte de la página.

const LZ_GRANDE = 90000


# El lienzo de un elemento <canvas> (0 si su JavaScript no pidió getContext("2d"))
@extern("lienzo") func lienzo_de(n: Nodo) -> Int

@extern("lienzo") func lienzo_rgb(l: Int) -> Int

@extern("lienzo") func lienzo_bw(l: Int) -> Int

@extern("lienzo") func lienzo_bh(l: Int) -> Int

# Si cambió desde la última vez (y lo olvida): el pintor repinta su zona
@extern("lienzo") func lienzo_sucio(l: Int) -> Bool

# Cuántos lienzos cambiaron (sin olvidarlo): para saber si hay que mirar la página
@extern("lienzo") func lienzos_cambiados() -> Int

# El color de un píxel del búfer (0xRRGGBB; -1 fuera): para las pruebas
@extern("lienzo") func lienzo_pixel(l: Int, x: Int, y: Int) -> Int
