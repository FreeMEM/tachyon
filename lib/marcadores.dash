# Marcadores y preferencias del navegador en ficheros de texto (Latin-1, una entrada por línea):
#   marcadores:   direccion<TAB>título
#   preferencias: clave=valor
#
#   marcadores_agregar("PROGDIR:dashweb.marcadores", url, titulo)
#   html = marcadores_html("PROGDIR:dashweb.marcadores")   # una página con un enlace por marcador
#   preferencia_poner("PROGDIR:dashweb.prefs", "inicio", url)
#   inicio = preferencia("PROGDIR:dashweb.prefs", "inicio")   # "" si no está

import "texto.dash"
import "idioma.dash"

func _lineas_de(fichero: String) -> [String]
    var r: [String] = []
    t = file_read_text(fichero)
    if t == nil
        return r
    end
    inicio = 0
    p = str_find(t, "\n")
    while p >= 0
        if p > inicio
            r.push(t[inicio:p])
        end
        inicio = p + 1
        p = str_find_from(t, "\n", inicio)
    end
    if inicio < t.length
        r.push(t[inicio:])
    end
    return r
end

func _escribir_lineas(fichero: String, lineas: [String]) -> Bool
    t = ""
    for l in lineas
        t = t + l + "\n"
    end
    return file_write_text(fichero, t)
end

# Las direcciones y títulos guardados (dos listas del mismo largo)
func marcadores_direcciones(fichero: String) -> [String]
    var r: [String] = []
    for l in _lineas_de(fichero)
        p = str_find(l, "\t")
        if p < 0
            r.push(l)
        else
            r.push(l[:p])
        end
    end
    return r
end

func marcadores_titulos(fichero: String) -> [String]
    var r: [String] = []
    for l in _lineas_de(fichero)
        p = str_find(l, "\t")
        if p < 0
            r.push(l)
        else
            r.push(l[p + 1:])
        end
    end
    return r
end

# Añade la dirección si no estaba; false si no se pudo escribir
func marcadores_agregar(fichero: String, direccion: String, titulo: String) -> Bool
    lineas = _lineas_de(fichero)
    for l in lineas
        if l == direccion or str_starts(l, direccion + "\t")
            return true
        end
    end
    t = str_replace(str_replace(titulo, "\t", " "), "\n", " ")
    lineas.push(direccion + "\t" + t)
    return _escribir_lineas(fichero, lineas)
end

func _html_escapar(t: String) -> String
    return str_replace(str_replace(str_replace(t, "&", "&amp;"), "<", "&lt;"), "\"", "&quot;")
end

# Una página con los marcadores como enlaces, cada uno con su dirección y un enlace para quitarlo
# (tachyon:marcadores?quitar=dirección)
func marcadores_html(fichero: String) -> String
    h = "<html><head><title>" + tr(340, "Bookmarks") + "</title><style>body { font-family: sans-serif; margin: 16px 24px; color: #222 } "
    h = h + "h1 { color: #1d3557 } .e { margin: 8px 0; padding: 6px 10px; background: #f3f5f9; border-radius: 6px } "
    h = h + ".dir { color: #2a7a3a; font-size: 12px } a { color: #1a4fa0 } .quitar { float: right; font-size: 12px; "
    h = h + "color: #a33 }</style></head><body><h1>" + tr(340, "Bookmarks") + "</h1>"
    direcciones = marcadores_direcciones(fichero)
    titulos = marcadores_titulos(fichero)
    if direcciones.length == 0
        h = h + "<p>" + tr(341, "No bookmarks yet: the star next to the address, or menu Bookmarks, Add.") + "</p>"
    else
        for i in (0..direcciones.length - 1)
            d = _html_escapar(direcciones[i])
            t = _html_escapar(titulos[i])
            if t == ""
                t = d
            end
            h = h + "<div class=e><a class=quitar href=\"tachyon:marcadores?quitar=" + d + "\">" + tr(331, "remove") + "</a>"
            h = h + "<a href=\"" + d + "\">" + t + "</a><div class=dir>" + d + "</div></div>"
        end
    end
    return h + "</body></html>"
end

func preferencia(fichero: String, clave: String) -> String
    for l in _lineas_de(fichero)
        if str_starts(l, clave + "=")
            return l[clave.length + 1:]
        end
    end
    return ""
end

func preferencia_poner(fichero: String, clave: String, valor: String) -> Bool
    var nuevas: [String] = []
    for l in _lineas_de(fichero)
        if not str_starts(l, clave + "=")
            nuevas.push(l)
        end
    end
    nuevas.push(clave + "=" + valor)
    return _escribir_lineas(fichero, nuevas)
end

# Si la dirección está en marcadores
func marcadores_tiene(fichero: String, direccion: String) -> Bool
    for d in marcadores_direcciones(fichero)
        if d == direccion
            return true
        end
    end
    return false
end

# La quita de marcadores; false si no se pudo escribir
func marcadores_quitar(fichero: String, direccion: String) -> Bool
    var quedan: [String] = []
    for l in _lineas_de(fichero)
        if l != direccion and not str_starts(l, direccion + "\t")
            quedan.push(l)
        end
    end
    return _escribir_lineas(fichero, quedan)
end

# === El historial (tarea 45) ===
# Lo visto en todas las ventanas, en un fichero: "minuto<TAB>dirección<TAB>título" por línea, lo último al final,
# como mucho HISTORIAL_MAX. El minuto cuenta desde el 1-1-1978 (el de AmigaDOS: días * 1440 + minutos del día).

const HISTORIAL_MAX = 300

func historial_ahora() -> Int
    return (time_unix() - 252460800) / 60      # (los minutos desde 1978: DateStamp)
end

# Apunta una página vista (la misma que la última: solo su hora y su título)
func historial_agregar(fichero: String, direccion: String, titulo: String, minuto: Int) -> Bool
    lineas = _lineas_de(fichero)
    t = str_replace(str_replace(titulo, "\t", " "), "\n", " ")
    if lineas.length > 0
        ultima = lineas[lineas.length - 1]
        p = str_find(ultima, "\t")
        if p >= 0 and str_starts(ultima[p + 1:], direccion + "\t")
            lineas.remove(lineas.length - 1)
        end
    end
    lineas.push("" + minuto + "\t" + direccion + "\t" + t)
    while lineas.length > HISTORIAL_MAX
        lineas.remove(0)
    end
    return _escribir_lineas(fichero, lineas)
end

func historial_borrar(fichero: String) -> Bool
    var nada: [String] = []
    return _escribir_lineas(fichero, nada)
end

# Quita del historial todas las visitas a una dirección (tachyon:historial?quitar=, como en Amelinium)
func historial_quitar(fichero: String, direccion: String) -> Bool
    lineas = _lineas_de(fichero)
    var quedan: [String] = []
    for l in lineas
        p = str_find(l, "\t")
        if p >= 0 and (str_starts(l[p + 1:], direccion + "\t") or l[p + 1:] == direccion)
            continue
        end
        quedan.push(l)
    end
    return _escribir_lineas(fichero, quedan)
end

# Lo buscado, para volver a ponerlo en una dirección (tachyon:historial?buscar=...): lo que partiría la consulta
func _hist_codificar(t: String) -> String
    return str_replace(str_replace(str_replace(str_replace(str_replace(t, "%", "%25"), "&", "%26"), "#", "%23"), "\"", "%22"), " ", "+")
end

# "Hoy 12:30", "Ayer 09:05" o "23/10/2026 18:00" de un minuto del historial
func _hist_cuando(minuto: Int, ahora: Int) -> String
    dia = minuto / 1440
    hoy = ahora / 1440
    f = _fecha(dia)
    if dia == hoy
        f = tr(345, "Today")
    elif dia == hoy - 1
        f = tr(346, "Yesterday")
    end
    return f + " " + _dos_cifras((minuto % 1440) / 60) + ":" + _dos_cifras(minuto % 60)
end

func _dos_cifras(n: Int) -> String
    if n < 10
        return "0" + n
    end
    return "" + n
end

# "23/10/2026" de los días desde el 1-1-1978
func _fecha(dias: Int) -> String
    anio = 1978
    d = dias
    while true
        largo = 365
        if (anio % 4 == 0 and anio % 100 != 0) or anio % 400 == 0
            largo = 366
        end
        if d < largo
            break
        end
        d = d - largo
        anio = anio + 1
    end
    var meses: [Int] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if (anio % 4 == 0 and anio % 100 != 0) or anio % 400 == 0
        meses[1] = 29
    end
    mes = 0
    while d >= meses[mes]
        d = d - meses[mes]
        mes = mes + 1
    end
    return _dos_cifras(d + 1) + "/" + _dos_cifras(mes + 1) + "/" + anio
end

# Una página con lo visto, lo último arriba, por días (Hoy, Ayer, la fecha), con la hora, el título, la dirección y
# el enlace para quitarla; arriba, la caja de buscar. Con buscar, lo que lo tiene en la dirección o el título (sin
# mirar mayúsculas), una vez por dirección con su última visita y cuántas (como en Amelinium)
func historial_html(fichero: String, ahora: Int, buscar: String) -> String
    h = "<html><head><title>" + tr(342, "History") + "</title><style>body { font-family: sans-serif; margin: 16px 24px; color: #222 } "
    h = h + "h1 { color: #1d3557; margin-bottom: 4px } h2 { color: #1d3557; font-size: 15px; border-bottom: 1px solid #ccd; "
    h = h + "padding-bottom: 3px; margin-top: 18px } .e { margin: 6px 0 } .hora { color: #888; display: inline-block; "
    h = h + "width: 48px } .dir { color: #2a7a3a; font-size: 12px; margin-left: 48px } a { color: #1a4fa0 } "
    h = h + ".borrar { font-size: 13px } .quitar { float: right; font-size: 12px; color: #a33 } "
    h = h + ".veces { color: #666; font-size: 12px; margin-left: 48px }</style></head><body><h1>" + tr(342, "History") + "</h1>"
    lineas = _lineas_de(fichero)
    if lineas.length == 0
        return h + "<p>" + tr(343, "You haven't seen any page yet.") + "</p></body></html>"
    end
    h = h + "<form action=\"tachyon:historial\"><input name=buscar size=30 value=\"" + _html_escapar(buscar) + "\"> "
    h = h + "<input type=submit value=\"" + tr(347, "Search") + "\"></form>"
    if buscar != ""
        return h + _historial_buscado(lineas, ahora, buscar) + "</body></html>"
    end
    h = h + "<p class=borrar><a href=\"tachyon:historial?borrar\">" + tr(344, "Clear the history") + "</a></p>"
    hoy = ahora / 1440
    dia = -1
    i = lineas.length - 1
    while i >= 0
        linea = lineas[i]
        partes = str_split(linea, "\t")
        i = i - 1
        if partes.length < 2
            continue
        end
        minuto = str_to_int(partes[0], 10)
        if minuto / 1440 != dia
            dia = minuto / 1440
            if dia == hoy
                h = h + "<h2>" + tr(345, "Today") + "</h2>"
            elif dia == hoy - 1
                h = h + "<h2>" + tr(346, "Yesterday") + "</h2>"
            else
                h = h + "<h2>" + _fecha(dia) + "</h2>"
            end
        end
        d = _html_escapar(partes[1])
        t = d
        if partes.length > 2 and partes[2] != ""
            t = _html_escapar(partes[2])
        end
        h = h + "<div class=e><a class=quitar href=\"tachyon:historial?quitar=" + d + "\">" + tr(331, "remove") + "</a>"
        h = h + "<span class=hora>" + _dos_cifras((minuto % 1440) / 60) + ":" + _dos_cifras(minuto % 60) + "</span>"
        h = h + "<a href=\"" + d + "\">" + t + "</a><div class=dir>" + d + "</div></div>"
    end
    return h + "</body></html>"
end

# Lo del historial que tiene lo buscado, una vez por dirección (lo último arriba), con su última visita y cuántas
func _historial_buscado(lineas: [String], ahora: Int, buscar: String) -> String
    b = str_lower(buscar)
    var sitio: {String: Int} = {}
    var dirs: [String] = []
    var titulos: [String] = []
    var ultimas: [Int] = []
    var veces: [Int] = []
    i = lineas.length - 1
    while i >= 0
        partes = str_split(lineas[i], "\t")
        i = i - 1
        if partes.length < 2
            continue
        end
        t = ""
        if partes.length > 2
            t = partes[2]
        end
        if sitio.has(partes[1])
            k = sitio[partes[1]]
            veces[k] = veces[k] + 1
            continue
        end
        if str_find(str_lower(partes[1]), b) < 0 and str_find(str_lower(t), b) < 0
            continue
        end
        sitio[partes[1]] = dirs.length
        dirs.push(partes[1])
        titulos.push(t)
        ultimas.push(str_to_int(partes[0], 10))
        veces.push(1)
    end
    if dirs.length == 0
        return "<p>" + hueco(tr(348, "Nothing in the history matches: %1"), _html_escapar(buscar)) + "</p>"
    end
    h = ""
    q = _html_escapar(_hist_codificar(buscar))
    for k in (0..dirs.length - 1)
        d = _html_escapar(dirs[k])
        t = d
        if titulos[k] != ""
            t = _html_escapar(titulos[k])
        end
        h = h + "<div class=e><a class=quitar href=\"tachyon:historial?buscar=" + q + "&amp;quitar=" + d + "\">" + tr(331, "remove") + "</a>"
        h = h + "<a href=\"" + d + "\">" + t + "</a><div class=dir>" + d + "</div>"
        h = h + "<div class=veces>" + hueco2(tr(349, "Last visit: %1. Visits: %2."), _hist_cuando(ultimas[k], ahora), "" + veces[k]) + "</div></div>"
    end
    return h
end
