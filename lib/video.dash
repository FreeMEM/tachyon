# Vídeo (tarea 30): el núcleo de MintVID (third_party/mintvid: H.264 con libavc, MPEG-1, MPEG-4, MJPEG,
# Cinepak...; MP4/MOV, AVI, MKV, MPEG-TS) por la interfaz de third_party/mintvid/dashweb_video.c, en
# build/video-lib/libvideo.a (tools/build_video.sh). Imagen a imagen, en RGB24; el sonido por Paula
# (video_con_sonido, video_reloj).
#
#   v = video_abrir("T:clip.mp4")         # 0 si no se puede
#   while video_siguiente(v) == 1
#       pixeles = video_rgb(v)            # video_ancho(v) x video_alto(v), video_paso(v) bytes por fila
#       ... video_ms(v): su instante
#   end
#   video_cerrar(v)

@link "../build/video-lib/libvideo.a"
# MintVID pide 320 KB de pila (su mr_decode: Stack 320000)
@stack 400000
# (Dash 2.0: las funciones de C de dashweb_video.h, con @extern)
@extern("dashweb_video.h") func dwv_abrir(fichero: String) -> Int
@extern("dashweb_video.h") func dwv_abrir_bajando(datos: Int, listos: Int, total: Int) -> Int
@extern("dashweb_video.h") func dwv_bajado(v: Int, datos: Int, listos: Int)
@extern("dashweb_video.h") func dwv_bajado_fichero(v: Int, fichero: String)
@extern("dashweb_video.h") func dwv_ancho(v: Int) -> Int
@extern("dashweb_video.h") func dwv_alto(v: Int) -> Int
@extern("dashweb_video.h") func dwv_fps_mil(v: Int) -> Int
@extern("dashweb_video.h") func dwv_codecs(v: Int) -> String
@extern("dashweb_video.h") func dwv_siguiente(v: Int) -> Int
@extern("dashweb_video.h") func dwv_rgb(v: Int) -> Int
@extern("dashweb_video.h") func dwv_paso(v: Int) -> Int
@extern("dashweb_video.h") func dwv_ms(v: Int) -> Int
@extern("dashweb_video.h") func dwv_rapido(v: Int, modo: Int) -> Bool
@extern("dashweb_video.h") func dwv_cerrar(v: Int)
@extern("dashweb_video.h") func dwv_reloj(v: Int) -> Int
@extern("dashweb_video.h") func dwv_servicio(v: Int)
@extern("dashweb_video.h") func dwv_pausa(v: Int, pausa: Bool)
@extern("dashweb_video.h") func dwv_con_sonido(v: Int) -> Bool
@extern("dashweb_video.h") func dwv_ir(v: Int, ms: Int) -> Int
@extern("dashweb_video.h") func dwv_duracion(v: Int) -> Int
@extern("dashweb_video.h") func dwv_trozos_nuevos(total: Int) -> Int
@extern("dashweb_video.h") func dwv_trozos_poner(t: Int, i: Int, trozo: Int)
@extern("dashweb_video.h") func dwv_trozos_listos(t: Int, listos: Int)
@extern("dashweb_video.h") func dwv_abrir_trozos(t: Int) -> Int
@extern("dashweb_video.h") func dwv_trozos_soltar(t: Int)


func video_abrir(fichero: String) -> Int
    return dwv_abrir(fichero)
end

# Un vídeo que aún se baja (lib/http.dash, http_parcial): los listos primeros bytes de total están en datos.
# 0 si aún no se puede abrir (el índice del MP4 no ha llegado): probar luego con más
func video_abrir_bajando(datos: Int, listos: Int, total: Int) -> Int
    return dwv_abrir_bajando(datos, listos, total)
end

# Lo que ya ha llegado y dónde está (el búfer de la carga se mueve al crecer: después de cada http_avanzar)
func video_bajado(v: Int, datos: Int, listos: Int)
    dwv_bajado(v, datos, listos)
end

# Un vídeo en trozos (lib/http.dash http_volcar_en_trozos; tarea 64g): una tabla para total bytes, sus trozos según
# llegan (el i-ésimo, de HTTP_TROZO bytes) y cuánto hay; abrirlo (0: aún no se puede, probar con más) y, con el vídeo
# ya cerrado, soltar la tabla (los trozos los suelta http_trozos_soltar)
func video_trozos_nuevos(total: Int) -> Int
    return dwv_trozos_nuevos(total)
end

func video_trozos_poner(t: Int, i: Int, trozo: Int)
    dwv_trozos_poner(t, i, trozo)
end

func video_trozos_listos(t: Int, listos: Int)
    dwv_trozos_listos(t, listos)
end

func video_abrir_trozos(t: Int) -> Int
    return dwv_abrir_trozos(t)
end

func video_trozos_soltar(t: Int)
    dwv_trozos_soltar(t)
end

# Ya ha llegado entero y está en fichero (la memoria de la carga se ha liberado)
func video_bajado_fichero(v: Int, fichero: String)
    dwv_bajado_fichero(v, fichero)
end

func video_ancho(v: Int) -> Int
    return dwv_ancho(v)
end

func video_alto(v: Int) -> Int
    return dwv_alto(v)
end

# Imágenes por segundo x 1000 (0 si el fichero no lo dice)
func video_fps_mil(v: Int) -> Int
    return dwv_fps_mil(v)
end

func video_codecs(v: Int) -> String
    return dwv_codecs(v)
end

# 1: hay una imagen nueva; 0: se acabó; -1: error; 2: la siguiente aún no ha llegado (se baja): esperar
func video_siguiente(v: Int) -> Int
    return dwv_siguiente(v)
end

# La imagen: RGB24, video_paso(v) bytes por fila (vale hasta el siguiente video_siguiente)
func video_rgb(v: Int) -> Int
    return dwv_rgb(v)
end

func video_paso(v: Int) -> Int
    return dwv_paso(v)
end

# Su instante en ms (-1 si no se sabe)
func video_ms(v: Int) -> Int
    return dwv_ms(v)
end

# H.264: 0 calidad, 1 equilibrado, 2 rápido, 3 turbo (una de cada dos), 4 turbo+ (solo las clave)
func video_rapido(v: Int, modo: Int) -> Bool
    return dwv_rapido(v, modo)
end

func video_cerrar(v: Int)
    dwv_cerrar(v)
end

# Lo que ya ha sonado, en ms: el reloj que manda cuando el vídeo tiene sonido; -1 si no tiene o aún no empezó
func video_reloj(v: Int) -> Int
    return dwv_reloj(v)
end

# Atender la salida de sonido (llenar los búferes de Paula): a menudo mientras suena
func video_servicio(v: Int)
    dwv_servicio(v)
end

func video_pausa(v: Int, pausa: Bool)
    dwv_pausa(v, pausa)
end

func video_con_sonido(v: Int) -> Bool
    return dwv_con_sonido(v)
end

# Lo que dura el vídeo en ms (del índice de un MP4), o -1 si no se sabe
func video_duracion(v: Int) -> Int
    return dwv_duracion(v)
end

# Salta a ms del vídeo (al fotograma clave de antes más cercano): el ms al que llegó, o -1 si no se puede
func video_ir(v: Int, ms: Int) -> Int
    return dwv_ir(v, ms)
end
