# Una ventana del navegador y lo que tiene
struct Ventana
    v: Navegador
    numero: Int
    abierta: Bool = true
    titulo_puesto: String = ""   # el título de la ventana (poner_titulo): el JavaScript puede cambiar el de la página
    actual: Documento = nil
    desde: Int = 0
    desde_volver: Int = -1    # una pestaña descartada vuelve a su sitio cuando su página llega hasta ahí (-1: no)
    pasos: [String] = nil    # las direcciones de esta ventana, para atrás y adelante
    visto: Int = -1          # la de pasos que se ve
    carga: Carga = nil       # la página que está llegando (sin congelar la ventana)
    carga_dir: String = ""
    preparando: Documento = nil   # la página ya llegó; sus hojas y scripts están llegando
    js_cuando: Int = -1      # time_ms del siguiente temporizador del JavaScript, -1 si no hay
    zona: Bool = false       # el repintado pedido es solo de la zona que cambió el JavaScript (tarea 37e7)
    estado_video: Int = 0    # time_ms de la última vez que la barra de estado dijo cómo va el vídeo
    foco: Nodo = nil         # el campo de formulario donde se escribe
    giro: Int = -1           # el led de la barra de estado: -1 apagado, 0 y 1 parpadeando (algo llega), 2 rojo (error)
    candado: Int = -1        # el candado junto a la dirección: 0 sin él (tachyon:), 1 HTTPS, 2 HTTP
    estrella: Int = -1       # la estrella: 1 la página está en marcadores, 0 no
    cargando: Bool = false   # la barra en modo carga: "parar" en vez de "recargar" y el progreso a la vista
    barra_imagenes: Bool = false   # la barra de progreso a la vista por las imágenes que faltan (la página ya está)
    valor_barra: Int = -1
    con_atras: Bool = false     # los iconos de atrás y adelante, encendidos o apagados
    con_adelante: Bool = false
    empezada: Int = 0        # time_ms de cuando se pidió la página (para medir la carga entera)
    aviso_scroll: Bool = false   # la vista se movió: el evento scroll del JavaScript, en el siguiente tic
    animando: Bool = false       # alguna animación de CSS viva: un fotograma en cada tic (unos 15 por segundo)
    fotograma: Int = 0           # time_ms del último fotograma pintado
    io_pagina: Pagina = nil      # la maqueta de la última vez que se miraron los IntersectionObserver
    # el <meta http-equiv="refresh"> de la página (tarea 51): de qué documento, cuándo y adónde ("": nada)
    refresco_doc: Documento = nil
    refresco_en: Int = 0
    refresco_url: String = ""
    # sus pestañas (tarea 46): los campos de arriba son los de la de delante; las de detrás, guardados en la suya
    pestanas: [Pestana] = nil
    pestana: Int = 0
end

# Lo de una pestaña de detrás (lo mismo que en Ventana para la de delante); quieta: sin temporizadores ni carga
struct Pestana
    actual: Documento = nil
    desde: Int = 0
    pasos: [String] = nil
    visto: Int = -1
    carga: Carga = nil
    carga_dir: String = ""
    preparando: Documento = nil
    js_cuando: Int = -1
    foco: Nodo = nil
    empezada: Int = 0
    io_pagina: Pagina = nil
    animando: Bool = false
    fotograma: Int = 0
    url: String = ""          # lo escrito en la barra de la dirección
    estado: String = ""       # lo que decía la barra de estado
    descartada: Bool = false  # sin su página por falta de memoria (como Chrome): se carga otra vez al volver
    titulo: String = ""       # el de su página, para su botón aunque esté descartada
end

# Con un mayor bloque libre por debajo de esto (bytes), al cargar otra página la de antes se suelta entera
const POCO_SEGUIDO = 16777216
# Con menos memoria libre que esto (KB), al cargar otra página la de antes se suelta entera
const MEMORIA_PARA_DOS = 65536
# Por debajo de esta memoria libre (KB), el JavaScript de la página se suelta (js_sin_memoria; JSMINIMA=KB lo cambia)
var dw_js_minima: Int = 24576
# Por debajo de esta memoria libre (KB), las pestañas de detrás se descartan (POCAMEMORIA=KB lo cambia, para probarlo)
var dw_poca_memoria: Int = 4096

var dw_ventanas: [Ventana] = []
# El informe de depuración (tarea 54): el que enseña tachyon:informe (se manda ese) y la última página que se abrió
var dw_informe: String = ""
var dw_ultima_pagina: String = ""
# DIBUJOS=y0-y1 (argumento): los dibujos de la página entre esas alturas, por la salida al acabar (-1: no)
var dw_dibujos_y0: Int = -1
var dw_dibujos_y1: Int = -1
# CAJAS=texto (argumento): al acabar, la caja y el estilo de maqueta de los elementos con ese texto en su class (o
# con ese nombre de etiqueta), por la salida ("": no)
var dw_cajas: String = ""
# CAJASEN=ms (argumento): lo mismo, una vez, a esos ms de empezar la página aunque no acabe (-1: no)
var dw_cajas_en: Int = -1
# JS=expresión (con los %XX de una dirección) y JSEN=ms: a esos ms de arrancar, la expresión evaluada en la página
# por la salida (para depurar: la nota y los fallos de Acid3)
var dw_js: String = ""
var dw_js_en: Int = -1
var dw_js_t0: Int = 0
# cuándo se devolvieron al sistema los bloques pequeños libres (memoria_recortar)
var dw_recorte: Int = 0

func cajas_volcar(n: Nodo, hondo: Int)
    if n.tipo == DOM_ELEMENTO and (n.nombre == dw_cajas or str_find(dom_atributo(n, "class"), dw_cajas) >= 0)
        l = "caja " + hondo + " " + n.nombre + "." + dom_atributo(n, "class") + " [" + n.caja_x + "," + n.caja_y + " " + n.caja_w + "x" + n.caja_h + "]"
        if n.estilo != nil
            for k in ["display", "position", "top", "left", "z-index", "opacity", "width", "min-width", "max-width", "flex", "flex-grow", "flex-shrink", "flex-basis", "flex-wrap", "flex-direction", "order", "font-size", "grid-template-columns", "grid-column", "box-sizing", "padding", "margin"]
                if n.estilo.has(k)
                    l = l + " " + k + "=" + n.estilo[k]
                end
            end
        end
        if dom_atributo(n, "style") != ""
            l = l + " | style=" + dom_atributo(n, "style")
        end
        Print l
    end
    for h in n.hijos
        cajas_volcar(h, hondo + 1)
    end
end

# === Versiones nuevas (tarea 44, lib/actualizar.dash) ===
# Al arrancar sin argumentos, como mucho una vez al día ("avisar_versiones=no" en las preferencias lo apaga), y con
# "Buscar actualizaciones" del menú. Una versión nueva enseña el icono verde de actualizar en cada ventana, como Chrome:
# solo al pulsarlo se baja y se instala; después el icono pasa a reiniciar y abre la nueva al cerrar esta.
var dw_act_carga: Carga = nil       # la lista de versiones que está llegando
var dw_act_manual: Bool = false     # la pidió el usuario: decir también si no hay nada o si falló
var dw_act_nueva: Novedad = nil
var dw_act_bajada: Carga = nil
# los catálogos de la versión nueva, tras instalarla: el que se baja, adónde, y cuál toca (tarea 45g)
var dw_act_cat: Carga = nil
var dw_act_cat_cajon: String = ""
var dw_act_cat_i: Int = 0
# el catálogo de esta versión en el idioma del usuario, si no tiene ninguno (llegó sin él: una 0.5.0 o 0.6.0 que se
# actualizó sola no baja catálogos), de GitHub y una sola vez por versión e idioma
var dw_cat_propio: Carga = nil
var dw_cat_propio_url: String = ""
var dw_act_lista: Bool = false      # ya instalada: el botón reinicia
var dw_reiniciar: Bool = false
# Su propia pantalla (preferencia "pantalla=si", como Forja): un clon público del Workbench con este nombre, abierto
# al empezar; sus ventanas se abren en ella. "" si va en la del Workbench
const PANTALLA = "TACHYON"
var dw_pantalla: String = ""

func versiones_mirar(manual: Bool)
    if dw_act_carga != nil or dw_act_bajada != nil or dw_act_lista
        return
    end
    dw_act_manual = manual
    dw_act_carga = actualizar_empezar()
end

func versiones_estado(texto: String)
    for t in dw_ventanas
        if t.abierta
            dw_estado(t, texto)
        end
    end
end

# El icono de una ventana como toca: escondido sin versión nueva, actualizar o (ya instalada) reiniciar, con su ayuda
func versiones_boton(t: Ventana)
    if dw_act_nueva == nil
        return
    end
    mui_help(t.v.actualizar, hueco(tr(127, "There is a new version, %1: click to install it"), dw_act_nueva.version))
    mui_help(t.v.reiniciar, hueco(tr(128, "%1 installed: click to restart Tachyon with it"), dw_act_nueva.version))
    mui_set_visible(t.v.actualizar, not dw_act_lista)
    mui_set_visible(t.v.reiniciar, dw_act_lista)
end

# En cada tic: la lista de versiones o el ejecutable nuevo, si ya llegaron
func versiones_avanzar()
    var nada: Carga = nil
    if dw_act_carga != nil and http_avanzar(dw_act_carga)
        r = dw_act_carga.respuesta
        dw_act_carga = nada
        if r.error != "" or r.estado != 200
            if dw_act_manual
                porque = r.error
                if porque == ""
                    porque = "HTTP " + r.estado
                end
                versiones_estado(tr(129, "Could not check for new versions") + " (" + porque + ")")
            end
            return
        end
        preferencia_poner(FICHERO_PREFERENCIAS, "versiones_visto", "" + actualizar_hoy())
        dw_act_nueva = actualizar_leer(http_texto(r), DASHWEB_VERSION)
        if dw_act_nueva != nil
            for t in dw_ventanas
                if t.abierta
                    versiones_boton(t)
                end
            end
            versiones_estado(hueco(tr(130, "There is a new version: %1"), dw_act_nueva.version))
        elif dw_act_manual
            versiones_estado(hueco(tr(131, "Tachyon is up to date (%1)"), DASHWEB_VERSION))
        end
    end
    if dw_act_bajada != nil and http_avanzar(dw_act_bajada)
        r = dw_act_bajada.respuesta
        dw_act_bajada = nada
        if r.error != "" or r.estado != 200
            # (con el porqué: el error de la red o el código HTTP; el usuario lo vio sin más en la 0.9.2)
            porque = r.error
            if porque == ""
                porque = "HTTP " + r.estado
            end
            versiones_estado(tr(132, "Could not download the new version") + " (" + porque + ")")
            return
        end
        error = actualizar_instalar(actualizar_programa())
        if error != ""
            versiones_estado(hueco(tr(133, "Not installed: %1"), error))
            return
        end
        dw_act_lista = true
        for t in dw_ventanas
            if t.abierta
                versiones_boton(t)
            end
        end
        versiones_estado(hueco(tr(134, "%1 installed: click the green icon"), dw_act_nueva.version))
        dw_act_cat_i = 0
        versiones_catalogo()
    end
    # sus catálogos, uno tras otro y sin avisar (si falla uno, se queda el de antes)
    if dw_act_cat != nil and http_avanzar(dw_act_cat)
        actualizar_catalogo_poner(dw_act_cat, dw_act_nueva.catalogos[dw_act_cat_i], dw_act_cat_cajon)
        dw_act_cat = nada
        dw_act_cat_i = dw_act_cat_i + 1
        versiones_catalogo()
    end
    if dw_cat_propio != nil and http_avanzar(dw_cat_propio)
        r = dw_cat_propio.respuesta
        # (sin red, se prueba otra vez al volver a abrirlo; si no lo hay en ese idioma, no)
        if r.error == "" and (r.estado == 200 or r.estado == 404)
            preferencia_poner(FICHERO_PREFERENCIAS, "catalogo_pedido", DASHWEB_VERSION + " " + actualizar_idioma_preferido())
        end
        idioma = actualizar_catalogo_poner(dw_cat_propio, dw_cat_propio_url, actualizar_catalogos(actualizar_programa()))
        dw_cat_propio = nada
        if idioma != "" and catalog_open("Tachyon.catalog", 1)
            versiones_estado(tr(162, "Tachyon in your language: the menus too when you open it again"))
        end
    end
end

# Si no hay catálogo en el idioma del usuario, el de esta versión de GitHub (sin esperar: versiones_avanzar)
func catalogo_propio()
    idioma = actualizar_idioma_preferido()
    if catalog_language() != "" or idioma == "" or idioma == "english" or dw_cat_propio != nil
        return
    end
    if preferencia(FICHERO_PREFERENCIAS, "catalogo_pedido") == DASHWEB_VERSION + " " + idioma
        return
    end
    dw_cat_propio_url = actualizar_catalogo_url(DASHWEB_VERSION, idioma)
    dw_cat_propio = actualizar_catalogo_bajar(dw_cat_propio_url, actualizar_catalogos(actualizar_programa()))
end

# El siguiente catálogo de la versión nueva, si queda alguno
func versiones_catalogo()
    if dw_act_nueva == nil or dw_act_nueva.catalogos == nil or dw_act_cat_i >= dw_act_nueva.catalogos.length
        return
    end
    url = dw_act_nueva.catalogos[dw_act_cat_i]
    dw_act_cat_cajon = actualizar_catalogos(actualizar_programa())
    dw_act_cat = actualizar_catalogo_bajar(url, dw_act_cat_cajon)
end

# El botón: bajar e instalar, o (ya instalada) reiniciar
func versiones_clic()
    if dw_act_lista
        dw_reiniciar = true
        return
    end
    if dw_act_nueva == nil or dw_act_bajada != nil
        return
    end
    dw_act_bajada = actualizar_bajar(dw_act_nueva)
    versiones_estado(hueco(tr(135, "Downloading Tachyon %1..."), dw_act_nueva.version))
end

# El logo de la página de inicio: docs/logo/tachyon.svg a 540 de ancho sobre blanco (rsvg-convert), recortado y en
# 32 colores (PIL), en PNG de 366x65 (1,8 KB)
const LOGO_INICIO = "data:image/png;base64,"

func dw_inicio() -> String
    h = "<html><head><title>Tachyon</title><style>"
    h = h + "body { margin: 0; font-family: sans-serif; background: #eef2fb; color: #0b1736 }"
    h = h + ".cab { background: #fff; border-bottom: 1px solid #d5ddef; padding: 40px 16px 28px; text-align: center }"
    h = h + ".lema { color: #4a5878; margin: 10px 0 0 }"
    h = h + "form { display: flex; max-width: 520px; margin: 24px auto 0 }"
    h = h + "form input { flex: 1; width: 400px; padding: 8px 10px; border: 2px solid #2e5bff; border-radius: 6px 0 0 6px; font-size: 16px }"
    h = h + "form button { padding: 8px 18px; background: #2e5bff; color: #fff; border: 0; border-radius: 0 6px 6px 0; font-weight: bold; font-size: 16px }"
    h = h + ".rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; max-width: 720px; margin: 28px auto; padding: 0 16px }"
    h = h + ".rejilla a { display: block; background: #fff; border: 1px solid #d5ddef; border-radius: 8px; padding: 12px; text-decoration: none; color: #4a5878; font-size: 12px; box-shadow: 0 2px 4px rgba(11, 23, 54, 0.12) }"
    h = h + ".rejilla b { display: block; color: #2e5bff; font-size: 15px; margin-bottom: 4px }"
    h = h + ".pie { text-align: center; font-size: 12px; color: #6b7898; margin: 8px 0 20px }"
    h = h + "</style></head><body><div class=cab>"
    h = h + "<img src=\"" + LOGO_INICIO + "\" width=366 height=65 alt=Tachyon>"
    h = h + "<p class=lema>" + tr(140, "A web browser for <b>AmigaOS</b>, written in <i>Dash</i>") + "</p>"
    h = h + "<form action=\"tachyon:buscar\" method=get><input type=text name=q placeholder=\"" + hueco(tr(141, "Search with %1"), buscador_de(buscador_elegido()).nombre) + "\">"
    h = h + "<button type=submit>" + tr(142, "Search") + "</button></form></div>"
    h = h + "<div class=rejilla>"
    h = h + "<a href=\"tachyon:marcadores\"><b>" + tr(143, "Bookmarks") + "</b>" + tr(144, "Your saved pages") + "</a>"
    h = h + "<a href=\"tachyon:cookies\"><b>Cookies</b>" + tr(145, "What each site stores") + "</a>"
    h = h + "<a href=\"tachyon:historial\"><b>" + tr(146, "History") + "</b>" + tr(147, "What you have seen") + "</a>"
    h = h + "<a href=\"tachyon:buscadores\"><b>" + tr(148, "Search engine") + "</b>" + tr(149, "Which one to search with") + "</a>"
    h = h + "<a href=\"https://aminet.net/\"><b>Aminet</b>" + tr(150, "Software for the Amiga") + "</a>"
    h = h + "<a href=\"https://amigaworld.net/\"><b>AmigaWorld.net</b>" + tr(151, "News and forums") + "</a>"
    h = h + "<a href=\"" + tr(158, "https://en.wikipedia.org/") + "\"><b>Wikipedia</b>" + tr(152, "The free encyclopedia") + "</a>"
    h = h + "<a href=\"https://github.com/FreeMEM/tachyon\"><b>Tachyon</b>" + tr(153, "The code and what's new") + "</a>"
    h = h + "</div><p class=pie>Tachyon " + DASHWEB_VERSION + " · " + tr(154, "HTML, CSS, JavaScript (QuickJS) and HTTPS (AmiSSL)") + "</p></body></html>"
    return h
end

# Mientras la página llega, el botón de recargar se cambia por el de parar y se ve el progreso
func modo_carga(w: Ventana, cargando: Bool)
    if cargando == w.cargando
        return
    end
    w.cargando = cargando
    w.barra_imagenes = false
    w.valor_barra = -1
    mui_set_visible(w.v.recargar, not cargando)
    mui_set_visible(w.v.parar, cargando)
    mui_set_visible(w.v.progreso, cargando)
end

# El candado (cerrado con HTTPS, abierto con HTTP, sin él en las páginas tachyon:) y la estrella (llena si la página
# está en marcadores) de la barra de la dirección; solo se tocan si cambian
func indicadores(w: Ventana)
    dir = ""
    if w.actual != nil
        dir = w.actual.direccion
    end
    candado = 0
    if str_starts(dir, "https:")
        candado = 1
    elif str_starts(dir, "http:")
        candado = 2
    end
    # (un botón por estado: MUI 3.8 no cambia la imagen de un botón ya hecho)
    if candado != w.candado
        w.candado = candado
        mui_set_visible(w.v.candado, candado == 1)
        mui_set_visible(w.v.candado_abierto, candado == 2)
    end
    estrella = 0
    if dir != "" and not str_starts(dir, "tachyon:") and marcadores_tiene(FICHERO_MARCADORES, dir)
        estrella = 1
    end
    if estrella != w.estrella
        w.estrella = estrella
        mui_set_visible(w.v.estrella_llena, estrella == 1)
        mui_set_visible(w.v.estrella, estrella != 1)
    end
end

# La estrella o el menú: la página a marcadores, o fuera si ya estaba
func marcador_alternar(w: Ventana)
    dir = w.actual.direccion
    if dir == "" or str_starts(dir, "tachyon:")
        dw_estado(w, tr(100, "This page can't be bookmarked"))
        return
    end
    if marcadores_tiene(FICHERO_MARCADORES, dir)
        if marcadores_quitar(FICHERO_MARCADORES, dir)
            dw_estado(w, tr(101, "Removed from bookmarks"))
        end
    elif marcadores_agregar(FICHERO_MARCADORES, dir, w.actual.titulo)
        dw_estado(w, hueco(tr(102, "In bookmarks: %1"), w.actual.titulo))
    else
        dw_estado(w, tr(103, "Could not save the bookmark"))
    end
    indicadores(w)
end

# Lo escrito por la salida (los errores del JavaScript, la traza), al fichero o la consola ya: si el navegador no
# acaba (una página que no termina de llegar), no se pierde en el búfer de AmigaDOS
# Las teclas modificadoras pulsadas ahora (PeekQualifier de input.device: IEQUALIFIER_*): Mayúsculas o Amiga con un
# clic en un enlace lo abren en una pestaña nueva (tarea 46). input.device se abre la primera vez y queda abierto
func modificadoras() -> Int
    return input_qualifiers()
end

func con_mayusculas_o_amiga() -> Bool
    q = modificadoras()
    # IEQUALIFIER_LSHIFT 1, RSHIFT 2, LCOMMAND 0x40, RCOMMAND 0x80
    return (q & 0xC3) != 0
end

# La FPU con precisión extendida (FPCR, bits 6-7 a 0). En el CoffinOS del usuario (Amiberry, 68040) Tachyon empezaba
# con precisión simple (FPCR 0x40): todo el JavaScript contaba con 24 bits (0.1 + 0.2 = 0.30000001192092896,
# Date.now() a saltos de 131 s) y React tiraba la página al hidratar (tarea 49). Un 68040 o 68060 de verdad también
# respeta esa precisión
func fpu_precision_extendida()
    # (Dash 2.0: lo hace el runtime de --fpu al arrancar)
end

func vaciar_salida()
    console_flush()
end

# El cursor al campo de la dirección (Amiga-L)
func activar(ventana: Int, objeto: Int)
    if ventana != 0 and objeto != 0
        mui_set_active(ventana, objeto)
    end
end

# La barra de estado: un texto largo ensancharía la ventana entera (MUI le da el ancho de su texto)
func dw_estado(w: Ventana, texto: String)
    t = texto
    if t.length > 48
        t = t[:45] + "..."
    end
    mui_set_text(w.v.estado, t)
end

# === Vídeo a pantalla completa ===
# Una ventana del tamaño de la pantalla con un lienzo negro y el vídeo con su proporción. Un clic o Esc la
# cierra; la barra espaciadora para o sigue.

var dw_completa_win: Int = 0
var dw_completa_lienzo: Int = 0
var dw_completa: Reproductor = nil
var dw_completa_de: Ventana = nil

func pantalla_completa(w: Ventana, r: Reproductor)
    if r == nil
        return
    end
    if dw_completa_win == 0
        dw_completa_win = mui_window_begin(tr(138, "Tachyon: video"), 0)
        dw_completa_lienzo = mui_canvas(320, 200)
        mui_window_end()
        mui_canvas_on_draw(dw_completa_lienzo, pinta_completa)
        mui_canvas_on_input(dw_completa_lienzo, ID_COMPLETA)
        mui_on_close(dw_completa_win, ID_COMPLETA_CERRADA)
        mui_window_fullscreen(dw_completa_win)
    end
    dw_completa = r
    dw_completa_de = w
    mui_window_open(dw_completa_win)
end

func salir_completa()
    if dw_completa_win != 0
        mui_window_close(dw_completa_win)
    end
    dw_completa = nil
    if dw_completa_de != nil and dw_completa_de.abierta
        mui_canvas_redraw(dw_completa_de.v.pagina)
    end
    dw_completa_de = nil
end

func pinta_completa(x: Int, y: Int, ancho: Int, alto: Int)
    if not mui_canvas_updating()
        gfx_pen(color_pen(0, 0, 0))
        gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    end
    if dw_completa != nil
        videos_pintar_r(dw_completa, x, y, ancho, alto)
        videos_barra(dw_completa, x, y, ancho, alto)
    end
end

# La zona de dibujo de cada ventana (MUI llama a una función sin decir de qué zona: una por ventana)
func pinta0(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(0, x, y, ancho, alto)
end

func pinta1(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(1, x, y, ancho, alto)
end

func pinta2(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(2, x, y, ancho, alto)
end

func pinta3(x: Int, y: Int, ancho: Int, alto: Int)
    pinta_en(3, x, y, ancho, alto)
end

# El led de actividad de cada ventana, en la barra de estado (como la página: una función por ventana)
func led0(x: Int, y: Int, ancho: Int, alto: Int)
    led_en(0, x, y, ancho, alto)
end

func led1(x: Int, y: Int, ancho: Int, alto: Int)
    led_en(1, x, y, ancho, alto)
end

func led2(x: Int, y: Int, ancho: Int, alto: Int)
    led_en(2, x, y, ancho, alto)
end

func led3(x: Int, y: Int, ancho: Int, alto: Int)
    led_en(3, x, y, ancho, alto)
end

# Un led redondo con su brillo: verde que parpadea mientras algo llega, rojo si la página falló, apagado si no. Un
# lienzo de 14x12: repintarlo tres veces por segundo no cuesta (antes, un punto arriba que se veía poco y mal)
func led_en(k: Int, x: Int, y: Int, ancho: Int, alto: Int)
    gfx_pen(0)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    estado = -1
    if k < dw_ventanas.length
        estado = dw_ventanas[k].giro
    end
    cx = x + ancho / 2
    cy = y + alto / 2
    gfx_pen(color_pen(50, 50, 50))
    gfx_circle_fill(cx, cy, 5)
    if estado == 1
        gfx_pen(color_pen(70, 225, 90))
    elif estado == 0
        gfx_pen(color_pen(30, 100, 40))
    elif estado == 2
        gfx_pen(color_pen(225, 50, 40))
    else
        gfx_pen(color_pen(105, 105, 105))
    end
    gfx_circle_fill(cx, cy, 4)
    if estado == 1
        gfx_pen(color_pen(215, 255, 215))
    elif estado == 2
        gfx_pen(color_pen(255, 200, 190))
    else
        gfx_pen(color_pen(150, 150, 150))
    end
    gfx_circle_fill(cx - 1, cy - 2, 1)
end

# Mueve el indicador si algo está llegando (página, hojas, scripts, imágenes); si no, lo para
func actualizar_giro(w: Ventana)
    nuevo = -1
    if w.carga != nil or w.preparando != nil or descargas_activas() > 0 or (w.actual != nil and imagenes_pendientes(w.actual.im) > 0)
        # (el tic va cada 50 ms mientras algo llega: el led cambia cada 300)
        nuevo = (time_ms() / 300) % 2
    elif w.actual != nil and w.actual.error != ""
        nuevo = 2
    end
    if nuevo != w.giro
        w.giro = nuevo
        mui_canvas_redraw(w.v.led)
    end
    # con la página ya puesta, la barra de progreso sigue a la vista mientras faltan imágenes: las llegadas
    # de todas las pedidas
    if not w.cargando
        faltan = 0
        if w.actual != nil and w.carga == nil and w.preparando == nil
            faltan = imagenes_pendientes(w.actual.im)
        end
        if faltan > 0
            total = w.actual.im.por_src.length
            valor = 100
            if total > 0
                valor = (total - faltan) * 100 / total
            end
            if valor != w.valor_barra
                w.valor_barra = valor
                mui_set_value(w.v.progreso, valor)
            end
        end
        if (faltan > 0) != w.barra_imagenes
            w.barra_imagenes = faltan > 0
            mui_set_visible(w.v.progreso, w.barra_imagenes)
        end
    end
end

# La página desde "desde"; si el ancho cambió, se maqueta otra vez
func pinta_en(k: Int, x: Int, y: Int, ancho: Int, alto: Int)
    if k >= dw_ventanas.length
        return
    end
    w = dw_ventanas[k]
    if w.actual == nil
        gfx_pen(color_pen(255, 255, 255))
        gfx_rect(x, y, x + ancho - 1, y + alto - 1)
        return
    end
    # (vh: el alto de donde se ve la página; con otro alto, otra maqueta: un fijo con top: 0 y bottom: 0, como el aviso
    # de cookies de xataka.com, se quedaba del alto de antes y no tapaba la página de abajo)
    estilo_vh = alto
    if w.actual.pagina == nil or w.actual.ancho != ancho or w.actual.vh != alto
        w.actual.vh = alto
        documento_maquetar(w.actual, ancho)
        mui_timer(1, ID_RANGO)
    end
    imagenes_hasta(w.actual.im, w.desde, alto)
    # lo que se ve, para el JavaScript (innerWidth/innerHeight, scrollY, getBoundingClientRect)
    if w.actual.js != 0 and w.actual.pagina != nil
        documento_vista(w.actual, ancho, alto, w.desde)
    end
    pintor_foco = w.foco
    pintor_videos = w.actual.videos
    t0 = time_ms()
    if mui_canvas_updating() and w.zona
        # solo lo que cambió el JavaScript (documento_al_dia: d.zona, en coordenadas de página)
        w.zona = false
        d = w.actual
        pintor_zona = true
        pintor_zx0 = x + d.zx0
        pintor_zy0 = y + d.zy0
        pintor_zx1 = x + d.zx1 - 1
        pintor_zy1 = y + d.zy1 - 1
        pintar(d.pagina, d.im, w.desde, x, y, ancho, alto)
        pintor_zona = false
        traza("pintada la zona " + d.zx0 + "," + d.zy0 + " " + (d.zx1 - d.zx0) + "x" + (d.zy1 - d.zy0) + " en " + (time_ms() - t0) + " ms")
        return
    end
    if mui_canvas_updating()
        # una imagen nueva de un vídeo (mui_canvas_update: MUI no borra el lienzo): solo los vídeos
        pintar_videos(w.actual.pagina, w.actual.im, w.desde, x, y, ancho, alto)
        return
    end
    pintar(w.actual.pagina, w.actual.im, w.desde, x, y, ancho, alto)
    traza("pintada en " + (time_ms() - t0) + " ms")
end

# Barra de desplazamiento: total de la página y lo que se ve
func ajustar_barra(w: Ventana)
    if w.actual == nil or w.actual.pagina == nil
        return
    end
    alto = mui_height(w.v.pagina)
    if w.desde_volver >= 0 and w.actual.pagina.alto - alto >= w.desde_volver
        w.desde = w.desde_volver
        w.desde_volver = -1
    end
    mui_set_range(w.v.barra, w.actual.pagina.alto, alto)
    if w.desde > w.actual.pagina.alto - alto
        w.desde = w.actual.pagina.alto - alto
    end
    if w.desde < 0
        w.desde = 0
    end
    mui_set_value(w.v.barra, w.desde)
end

# Los @media de CSS y matchMedia miran el tamaño de la zona de dibujo de la ventana (con la barra)
func vista(w: Ventana)
    ancho = mui_width(w.v.pagina)
    if ancho > 0
        css_vista(ancho + DOC_BARRA, mui_height(w.v.pagina))
    end
end

# Abre la dirección en la ventana (direccion "" = la página de inicio). Por http(s) empieza la carga y
# vuelve: la página llega en los tics (la ventana sigue respondiendo y se puede parar).
func abrir(w: Ventana, direccion: String)
    parar_carga(w)
    w.desde_volver = -1
    # (las direcciones internas de antes del nombre Tachyon: dashweb:marcadores...)
    if str_starts(str_lower(direccion), "dashweb:")
        direccion = "tachyon:" + direccion[8:]
    end
    # tachyon:buscar?q=...: el buscador de la página de inicio, con el buscador elegido (la barra y atrás ya llevan a
    # la de sus resultados)
    if str_starts(direccion, "tachyon:buscar?")
        q = ""
        p = str_find(direccion, "q=")
        if p >= 0
            q = direccion[p + 2:]
            f = str_find(q, "&")
            if f >= 0
                q = q[:f]
            end
            q = url_deshacer(str_replace(q, "+", " "))
        end
        resultados = buscar_url(buscador_elegido(), q)
        if w.visto >= 0 and w.visto < w.pasos.length and w.pasos[w.visto] == direccion
            w.pasos[w.visto] = resultados
        end
        direccion = resultados
        mui_set_text(w.v.url, direccion)
    end
    if not str_starts(direccion, "tachyon:")
        registro_anotar("open " + informe_sin_parametros(direccion))
        dw_ultima_pagina = direccion
    end
    if str_starts(direccion, "http://") or str_starts(direccion, "https://")
        dw_estado(w, hueco(tr(104, "Connecting to %1..."), direccion))
        mui_set_value(w.v.progreso, 5)
        w.carga = http_empezar(direccion, 20000)
        w.carga_dir = direccion
        w.empezada = time_ms()
        modo_carga(w, true)
        actualizar_giro(w)
        programar()
        return
    end
    dw_estado(w, hueco(tr(105, "Opening %1..."), direccion))
    vista(w)
    var d: Documento = nil
    if direccion == "" or direccion == "tachyon:inicio"
        d = documento_html("tachyon:inicio", dw_inicio())
    elif str_starts(direccion, "tachyon:marcadores")
        # tachyon:marcadores?quitar=dirección: el enlace "quitar" de cada uno
        p = str_find(direccion, "?quitar=")
        if p >= 0
            marcadores_quitar(FICHERO_MARCADORES, direccion[p + 8:])
        end
        d = documento_html("tachyon:marcadores", marcadores_html(FICHERO_MARCADORES))
    elif str_starts(direccion, "tachyon:descargas")
        # tachyon:descargas?parar=3 (y reintentar, quitar, abrir): los enlaces de cada una
        p = str_find(direccion, "?")
        if p >= 0
            q = str_find(direccion, "=")
            if q > p
                aviso = descargas_accion(direccion[p + 1:q], str_to_int(direccion[q + 1:], 10))
                if aviso != ""
                    dw_estado(w, aviso)
                end
            end
        end
        d = documento_html("tachyon:descargas", descargas_html())
    elif str_starts(direccion, "tachyon:buscadores")
        p = str_find(direccion, "?usar=")
        if p >= 0
            preferencia_poner(FICHERO_PREFERENCIAS, "buscador", direccion[p + 6:])
        end
        d = documento_html("tachyon:buscadores", buscadores_html(buscador_elegido()))
    elif str_starts(direccion, "tachyon:archivo")
        # tachyon:archivo?extraer=ruta: el enlace de la página de un comprimido (lib/archivos.dash, tarea 63d). Dónde
        # (el diálogo de guardar con su nombre: se extrae en un cajón nuevo con ese nombre) y luego ese cajón
        p = str_find(direccion, "?extraer=")
        h = "<title>" + tr(480, "Extract...") + "</title><p>" + tr(483, "Nothing was extracted.") + "</p>"
        if p >= 0
            ruta = url_deshacer(direccion[p + 9:])
            nombre = ruta[dialog_cajon(ruta).length:]
            if str_starts(nombre, "/")
                nombre = nombre[1:]
            end
            q = str_find(nombre, ".")
            if q > 0
                nombre = nombre[:q]
            end
            destino = dialog_file_at(tr(484, "Extract into a new drawer"), "", true, dialog_cajon(ruta), nombre)
            if destino != ""
                dw_estado(w, hueco(tr(485, "Extracting %1..."), ruta))
                e = archivo_extraer(ruta, destino)
                if e == ""
                    direccion = url_de_ruta(destino + "/")
                    mui_set_text(w.v.url, direccion)
                    if w.visto >= 0 and w.visto < w.pasos.length
                        w.pasos[w.visto] = direccion
                    end
                    h = documento_cajon(destino + "/")
                else
                    h = "<title>" + tr(480, "Extract...") + "</title><p>" + hueco2(tr(486, "Couldn't extract %1: %2"), ruta, e) + "</p>"
                end
            end
        end
        d = documento_html(direccion, h)
    elif direccion == "tachyon:lectura"
        # el modo lectura de la página de antes (leer_pagina); vuelto a abrir sin ella (adelante, otra ventana), un aviso
        h = dw_lectura_html
        if h == ""
            h = "<html><head><title>" + tr(170, "Reader view") + "</title></head><body><p>" + tr(171, "Open a page and choose Reader view in the Navigate menu.") + "</p></body></html>"
        end
        d = documento_html("tachyon:lectura", h)
    elif str_starts(direccion, "tachyon:historial")
        # ?borrar (todo), ?quitar=dirección (todas sus visitas; va la última, con lo que lleve) y ?buscar=texto
        if str_starts(direccion, "tachyon:historial?borrar")
            historial_borrar(FICHERO_HISTORIAL)
        end
        p = str_find(direccion, "quitar=")
        if p >= 0
            historial_quitar(FICHERO_HISTORIAL, direccion[p + 7:])
        end
        buscar = ""
        p = str_find(direccion, "buscar=")
        if p >= 0
            buscar = direccion[p + 7:]
            f = str_find(buscar, "&")
            if f >= 0
                buscar = buscar[:f]
            end
            buscar = str_trim(url_deshacer(str_replace(buscar, "+", " ")))
        end
        d = documento_html(tachyon_sin_accion(direccion), historial_html(FICHERO_HISTORIAL, historial_ahora(), buscar))
    elif str_starts(direccion, "tachyon:cookies")
        # dashweb:cookies?borrar (todas) o ?borrar=dominio
        if str_starts(direccion, "tachyon:cookies?borrar")
            dominio = ""
            if str_starts(direccion, "tachyon:cookies?borrar=")
                dominio = direccion[23:]
            end
            cookies_borrar(dominio)
            cookies_guardar(FICHERO_COOKIES)
            # (y su localStorage: borrar los datos de un sitio es borrarlo todo)
            if dominio == ""
                almacen_borrar("")
            else
                almacen_borrar("https://" + dominio)
                almacen_borrar("http://" + dominio)
            end
            almacen_guardar(FICHERO_ALMACEN)
        end
        d = documento_html("tachyon:cookies", cookies_html())
    elif str_starts(direccion, "tachyon:inspeccionar")
        d = documento_html("tachyon:inspeccionar", inspeccionar_pedido(direccion))
    elif str_starts(direccion, "tachyon:informe")
        # tachyon:informe?enviar=1: el botón de la página; manda lo que la página enseñaba
        if str_starts(direccion, "tachyon:informe?enviar")
            if dw_informe == ""
                dw_informe = informe_texto(DASHWEB_VERSION, http_idiomas, dw_ultima_pagina)
            end
            abrir_post(w, INFORME_DIRECCION, "informe=" + url_codificar(dw_informe))
            return
        end
        dw_informe = informe_texto(DASHWEB_VERSION, http_idiomas, dw_ultima_pagina)
        d = documento_html("tachyon:informe", informe_html(dw_informe))
    else
        d = documento_abrir(direccion)
    end
    mostrar(w, d, direccion)
end

# POST: como abrir, pero la carga manda el cuerpo
func abrir_post(w: Ventana, direccion: String, cuerpo: String)
    parar_carga(w)
    dw_estado(w, hueco(tr(106, "Sending to %1..."), direccion))
    mui_set_value(w.v.progreso, 5)
    mui_set_text(w.v.url, direccion)
    w.carga = http_empezar_post(direccion, cuerpo, "", 20000)
    w.carga_dir = direccion
    modo_carga(w, true)
    actualizar_giro(w)
    programar()
end

# La carga en curso: lo que haya llegado; al acabar, sus hojas y scripts; después la página
func avanzar_carga(w: Ventana)
    if w.carga != nil
        if not http_avanzar(w.carga)
            fase = http_fase(w.carga)
            if fase != "recibiendo"
                host = url_parse(w.carga_dir).host
                if fase == "esperando" and w.actual != nil and w.actual.js != 0
                    # (la tabla de conexiones llena: las del JavaScript de la página que se deja no avanzan
                    # mientras se carga la nueva y no se cerrarían; se cancelan, como al llegar la nueva)
                    jsdom_peticiones_cancelar(w.actual.js)
                end
                if fase == "buscando"
                    dw_estado(w, hueco(tr(107, "Looking up %1..."), host))
                elif fase == "conectando" or fase == "esperando"
                    dw_estado(w, hueco(tr(104, "Connecting to %1..."), host))
                else
                    dw_estado(w, hueco(tr(108, "Secure connection to %1..."), host))
                end
                return
            end
            # si es algo para guardar, en cuanto se sabe: se corta y se baja directamente al fichero
            cab = http_cabeceras_ya(w.carga)
            if cab != nil and documento_es_descarga(cab)
                http_cancelar(w.carga)
                var ninguna: Carga = nil
                w.carga = ninguna
                empezar_descarga(w, cab)
                return
            end
            total = http_total(w.carga)
            if total > 0
                mui_set_value(w.v.progreso, 10 + http_recibidos(w.carga) * 80 / total)
            else
                mui_set_value(w.v.progreso, 10 + (http_recibidos(w.carga) / 1024) % 80)
            end
            dw_estado(w, hueco2(tr(109, "Receiving %1: %2 KB"), w.carga_dir, "" + http_recibidos(w.carga) / 1024))
            return
        end
        c = w.carga
        var nada: Carga = nil
        w.carga = nada
        if documento_es_descarga(c.respuesta)
            empezar_descarga(w, c.respuesta)
            return
        end
        mui_set_value(w.v.progreso, 90)
        dw_estado(w, tr(110, "Fetching style sheets and scripts..."))
        traza("llegó la página (" + c.respuesta.cuerpo.length + " bytes): se suelta la de antes")
        vista(w)
        # la de antes se queda pintada, pero sin su JavaScript: así no suma su memoria a la de la nueva
        if w.actual != nil
            documento_soltar_js(w.actual)
            w.js_cuando = -1
            # sin un hueco grande seguido, fuera también lo demás (árbol, estilo, maqueta, imágenes), de vuelta al sistema:
            # la portada de YouTube tras "Accept all" pide 10,5 MB seguidos para su script, y con 128 MB lo que quedaba
            # de la de antes la partía en trozos de 10 MB (tarea 38c8)
            # (y con poca memoria libre en total: la de los resultados de YouTube y la del vídeo no caben las dos en
            # 256 MB, y Tachyon se caía al abrir un vídeo; tarea 64)
            if memoria_mayor_bloque() < POCO_SEGUIDO or mem_total() / 1024 < MEMORIA_PARA_DOS
                documento_liberar(w.actual)
                var ninguna: Documento = nil
                w.actual = ninguna
                n = mem_trim()
                traza("la página de antes, fuera por falta de memoria seguida: devueltos " + n / 1024 + " KB; mayor bloque libre " + memoria_mayor_bloque() / 1024 + " KB")
                mui_canvas_redraw(w.v.pagina)
            end
        end
        traza("leyendo el HTML")
        w.preparando = documento_empezar(w.carga_dir, c.respuesta)
        w.preparando.t_red = time_ms() - w.empezada - w.preparando.t_html
        traza("HTML leído en " + w.preparando.t_html + " ms: " + recursos_pendientes(w.preparando.recursos) + " hojas y scripts por traer")
    end
    if w.preparando == nil
        return
    end
    if not documento_avanzar(w.preparando)
        dw_estado(w, hueco(tr(111, "Fetching style sheets and scripts: %1 left"), "" + recursos_pendientes(w.preparando.recursos)))
        return
    end
    d = w.preparando
    var ninguno: Documento = nil
    w.preparando = ninguno
    modo_carga(w, false)
    mostrar(w, d, w.carga_dir)
end

# Lo que no es una página se guarda: el selector de ficheros y luego se baja tal cual a ese fichero (la primera
# respuesta llegó como texto, que cambia los bytes 0: se pide otra vez); la página de antes se queda. La bajada va al
# gestor de descargas (lib/descargas.dash): sigue aunque se cambie de página, con otras a la vez
func empezar_descarga(w: Ventana, r: Respuesta)
    modo_carga(w, false)
    mui_set_value(w.v.progreso, 0)
    nombre = documento_nombre_descarga(r)
    # (la pedida, no la de después de las redirecciones: la de GitHub caduca y reintentar fallaría)
    direccion = w.carga_dir
    if direccion == ""
        direccion = r.url
    end
    if w.actual != nil
        mui_set_text(w.v.url, w.actual.direccion)
    end
    # un PDF: a T: y, al acabar, con el visor del sistema, sin preguntar dónde (como en Amelinium; tarea 63h)
    if documento_es_pdf(r)
        descargas_empezar_abriendo(direccion, "T:" + url_fichero_nombre(nombre), nombre)
        dw_estado(w, hueco(tr(530, "Opening %1 with the system's viewer..."), nombre))
        descargas_tic()
        actualizar_giro(w)
        programar()
        return
    end
    ruta = pedir_ruta(nombre)
    if ruta == ""
        dw_estado(w, hueco(tr(113, "Download cancelled: %1"), nombre))
        actualizar_giro(w)
        return
    end
    descargas_empezar(direccion, ruta, nombre)
    # (si la ventana no tenía página, ésta: no se queda en blanco y se ve cómo va)
    if w.actual == nil
        mui_set_text(w.v.url, "tachyon:descargas")
        abrir(w, "tachyon:descargas")
    end
    dw_estado(w, hueco(tr(114, "Downloading %1 (Amiga-J: downloads)"), nombre))
    descargas_tic()
    actualizar_giro(w)
    programar()
end

# Dónde guardar nombre: el selector de ficheros con el nombre ya puesto, en el cajón de la última vez (RAM: la
# primera), que se recuerda; "" si se cancela
func pedir_ruta(nombre: String) -> String
    cajon = preferencia(FICHERO_PREFERENCIAS, "cajon_descargas")
    if cajon == ""
        cajon = "RAM:"
    end
    ruta = descargas_pedir_ruta(hueco(tr(112, "Save %1"), nombre), cajon, nombre)
    if ruta != "" and dialog_cajon(ruta) != cajon
        preferencia_poner(FICHERO_PREFERENCIAS, "cajon_descargas", dialog_cajon(ruta))
    end
    return ruta
end

# "Abrir fichero..." (tarea 60; Ferrán García: una web guardada, documentación en HTML): el selector de ficheros,
# en el cajón de la última vez, y la página con su dirección file: (así sus enlaces relativos van a su cajón)
func abrir_fichero(w: Ventana)
    cajon = preferencia(FICHERO_PREFERENCIAS, "cajon_abrir")
    ruta = dialog_file_at(tr(476, "Open file"), "", false, cajon, "")
    if ruta == ""
        return
    end
    if dialog_cajon(ruta) != cajon
        preferencia_poner(FICHERO_PREFERENCIAS, "cajon_abrir", dialog_cajon(ruta))
    end
    navegar(w, url_de_ruta(ruta))
end

# Iconos del Workbench soltados en la ventana (tarea 60, D83 de Dash; solo en la pantalla del Workbench): el
# primero se abre en la pestaña que se ve y los demás, cada uno en una nueva (mientras quepan)
func soltado(w: Ventana)
    ruta = app_drop()
    primero = true
    while ruta != ""
        if primero
            navegar(w, url_de_ruta(ruta))
            primero = false
        else
            nueva_pestana(w, url_de_ruta(ruta))
        end
        ruta = app_drop()
    end
end

# "Guardar enlace como..." (tarea 57; Ferrán García lo pidió para bajarse los .readme de Aminet, como AmiFire): el
# enlace donde se pulsó el botón derecho, al gestor de descargas tal cual (sin abrirlo ni interpretarlo)
func guardar_enlace(w: Ventana)
    destino = ""
    if w.actual != nil and w.actual.pagina != nil
        n = maqueta_nodo_en_vista(w.actual.pagina, mui_canvas_mouse_x(w.v.pagina), mui_canvas_mouse_y(w.v.pagina), w.desde)
        if n != nil
            destino = documento_enlace(w.actual, n)
        end
    end
    if destino == ""
        dw_estado(w, tr(163, "There's no link there"))
        return
    end
    if str_starts(destino, "http://") or str_starts(destino, "https://")
        bajar_como(w, destino, descargas_nombre(destino))
        return
    end
    # (un fichero del disco, de una página abierta desde él: se copia)
    f = url_fichero(destino)
    if f == "NIL:" or str_starts(destino, "tachyon:") or not file_exists(f)
        dw_estado(w, hueco(tr(164, "Can't save %1"), destino))
        return
    end
    nombre = descargas_nombre(destino)
    ruta = pedir_ruta(nombre)
    if ruta == ""
        dw_estado(w, hueco(tr(166, "Not saved: %1"), nombre))
    elif file_copy(f, ruta)
        dw_estado(w, hueco(tr(167, "Saved in %1"), ruta))
    else
        dw_estado(w, hueco(tr(164, "Can't save %1"), ruta))
    end
end

# El selector de ficheros y, si se elige uno, al gestor de descargas
func bajar_como(w: Ventana, direccion: String, nombre: String)
    ruta = pedir_ruta(nombre)
    if ruta == ""
        dw_estado(w, hueco(tr(113, "Download cancelled: %1"), nombre))
        return
    end
    descargas_empezar(direccion, ruta, nombre)
    dw_estado(w, hueco(tr(114, "Downloading %1 (Amiga-J: downloads)"), nombre))
    descargas_tic()
    actualizar_giro(w)
    programar()
end

# "Guardar página como..." (tarea 57): la que se ve, tal como llegó (el HTML o el texto, no lo pintado). Una muy
# grande (no se guardó lo que llegó) se baja otra vez con el gestor de descargas
func guardar_pagina(w: Ventana)
    d = w.actual
    if d == nil or d.doc == nil
        dw_estado(w, tr(165, "There's no page to save"))
        return
    end
    nombre = descargas_nombre(d.direccion)
    if str_starts(d.direccion, "tachyon:")
        nombre = d.direccion[8:]
        q = str_find(nombre, "?")
        if q >= 0
            nombre = nombre[:q]
        end
        nombre = nombre + ".html"
    elif str_find(nombre, ".") < 0 and str_starts(str_trim(d.fuente[:200]), "<")
        # (una página sin extensión en su dirección, como https://aminet.net/package/util/arc/lha)
        nombre = nombre + ".html"
    end
    if d.fuente == "" and (str_starts(d.direccion, "http://") or str_starts(d.direccion, "https://"))
        bajar_como(w, d.direccion, nombre)
        return
    end
    ruta = pedir_ruta(nombre)
    if ruta == ""
        dw_estado(w, hueco(tr(166, "Not saved: %1"), nombre))
        return
    end
    if documento_guardar(d, ruta)
        dw_estado(w, hueco(tr(167, "Saved in %1"), ruta))
    else
        dw_estado(w, hueco(tr(164, "Can't save %1"), ruta))
    end
end

# Amiga+V (menú Proyecto, tarea 70; lo contaron Alex Agauser y Ferrán García): el String de MUI 3.8 no pega (mete
# una "v"). Con la barra de direcciones activa, la primera línea del portapapeles donde está el cursor; con la página
# activa y un campo con el foco, en ese campo (como con el puntero sobre la página, tarea 59). Con MUI 3.8, Amiga+V
# en la barra no llega al menú (el String se lo queda y mete la "v"): ahí solo pega eligiendo el menú con el ratón
func pegar(w: Ventana)
    activo = mui_active_object(w.v.window)
    if activo == w.v.url
        texto = utf8_to_latin1(clip_read_text())
        i = str_find(texto, "\n")
        if i >= 0
            texto = texto[:i]
        end
        texto = str_trim(str_replace(str_replace(texto, "\r", ""), "\t", " "))
        if texto == ""
            return
        end
        antes = mui_get_text(w.v.url)
        p = mui_string_pos(w.v.url)
        if p < 0 or p > antes.length
            p = antes.length
        end
        nuevo = antes[:p] + texto + antes[p:]
        if nuevo.length > 1024
            return
        end
        mui_set_text(w.v.url, nuevo)
        mui_set_string_pos(w.v.url, p + texto.length)
    elif (activo == 0 or activo == w.v.pagina) and w.foco != nil
        # (la página no es un objeto activo de MUI: con ella, el de la ventana es 0)
        if formulario_pegar(w.foco, utf8_to_latin1(clip_read_text())) == FORM_CAMBIO
            mui_canvas_redraw(w.v.pagina)
        end
    end
end

# La opción de menú de Amiga+tecla en la página (la letra de cada una en src/navegador.dashui: hay que tenerlas
# iguales); 0 si no es un atajo. Si Intuition ya hizo el atajo, la tecla no llega a la página: nunca va dos veces
func atajo_de_menu(w: Ventana) -> Int
    if mui_canvas_key(w.v.pagina) < 0 or (mui_canvas_qualifiers(w.v.pagina) & 8) == 0
        return 0
    end
    c = mui_canvas_char(w.v.pagina)
    if c == ""
        return 0
    end
    letras = "nktwlosqrhybdj?e"
    eventos = [ID_NUEVA, ID_CERRAR, ID_NUEVA_PESTANA, ID_CERRAR_PESTANA, ID_IR_DIRECCION, ID_ABRIR_FICHERO, ID_GUARDAR_PAGINA, ID_SALIR, ID_RECARGAR, ID_INICIO, ID_VER_HISTORIAL, ID_MARCADORES, ID_ANADIR, ID_DESCARGAS, ID_ACERCA, ID_LECTURA]
    i = str_find(letras, str_lower(c[:1]))
    if i < 0
        return 0
    end
    return eventos[i]
end

# El cajón de una ruta ("Work:a/b.lha" -> "Work:a")
func dialog_cajon(ruta: String) -> String
    i = ruta.length - 1
    while i >= 0
        c = str_code(ruta, i)
        if c == 47
            return ruta[:i]
        end
        if c == 58
            return ruta[:i + 1]
        end
        i = i - 1
    end
    return ""
end

# === Las descargas (tarea 47, lib/descargas.dash) ===
var dw_desc_activas: Int = -1        # las que había en el último tic (para tocar el icono solo si cambia)
var dw_desc_ayuda: String = ""
var dw_desc_pagina: Int = 0          # time_ms de la última vez que se rehízo tachyon:descargas

# En cada tic: lo que llega de cada una, el icono de la barra (con su ayuda: cuántas y cuánto va) y la página
# tachyon:descargas al día (cada segundo, o en cuanto una acaba)
func descargas_tic()
    cambio = descargas_avanzar()
    activas = descargas_activas()
    if activas != dw_desc_activas
        dw_desc_activas = activas
        for t in dw_ventanas
            if t.abierta
                mui_set_visible(t.v.ver_descargas, activas > 0)
            end
        end
    end
    if activas > 0
        ayuda = tr(155, "1 download")
        if activas > 1
            ayuda = hueco(tr(156, "%1 downloads"), "" + activas)
        end
        pc = descargas_porcentaje()
        if pc >= 0
            ayuda = hueco2(tr(157, "%1: %2 %"), ayuda, "" + pc)
        end
        if ayuda != dw_desc_ayuda
            dw_desc_ayuda = ayuda
            for t in dw_ventanas
                if t.abierta
                    mui_help(t.v.ver_descargas, hueco(tr(136, "%1 (click to see them)"), ayuda))
                end
            end
        end
    end
    if cambio
        for d in descargas
            if d.carga == nil and d.estado == DESCARGA_HECHA and d.bytes > 0 and time_ms() - d.empezada < 600000
                versiones_estado(hueco(tr(137, "Download finished: %1"), d.nombre))
                break
            end
        end
    end
    if cambio or (activas > 0 and time_ms() - dw_desc_pagina > 1000)
        dw_desc_pagina = time_ms()
        for t in dw_ventanas
            if t.abierta and t.carga == nil and t.actual != nil and t.actual.direccion == "tachyon:descargas"
                desde = t.desde
                mostrar(t, documento_html("tachyon:descargas", descargas_html()), "")
                t.desde = desde
                ajustar_barra(t)
                mui_canvas_redraw(t.v.pagina)
            end
        end
    end
end

# Para lo que esté llegando (la página o sus recursos)
func parar_carga(w: Ventana)
    if w.carga != nil
        http_cancelar(w.carga)
        var nada: Carga = nil
        w.carga = nada
    end
    if w.preparando != nil
        documento_liberar(w.preparando)
        var ninguno: Documento = nil
        w.preparando = ninguno
    end
end

# El título de la página en la ventana ("... - Tachyon"), si cambió
func poner_titulo(w: Ventana)
    t = ""
    if w.actual != nil
        t = w.actual.titulo
    end
    w.titulo_puesto = t
    if t != "" and t != "Tachyon"
        mui_set_text(w.v.window, t + " - Tachyon")
    else
        mui_set_text(w.v.window, "Tachyon")
    end
end

# Pone el documento nuevo en la ventana
func mostrar(w: Ventana, d: Documento, direccion: String)
    if w.actual != nil
        documento_liberar(w.actual)
    end
    w.actual = d
    w.fotograma = 0
    w.animando = false
    if direccion != ""
        mui_set_text(w.v.url, w.actual.direccion)
    end
    w.js_cuando = -1
    w.desde = 0
    ancho = mui_width(w.v.pagina)
    if ancho > 0
        # (con el alto de la vista, como pinta_en: sin él, pinta_en la veía con otro alto y la maquetaba entera otra
        # vez; cada página nueva se maquetaba dos veces desde el 2026-10-22: tarea 61)
        estilo_vh = mui_height(w.v.pagina)
        w.actual.vh = estilo_vh
        documento_maquetar(w.actual, ancho)
        y = documento_y_de(w.actual, documento_fragmento(direccion))
        if y > 0
            w.desde = y
        end
    end
    var nadie: Nodo = nil
    w.foco = nadie
    poner_titulo(w)
    ajustar_barra(w)
    if w.actual.error != ""
        dw_estado(w, hueco(tr(115, "Error: %1"), w.actual.error))
        registro_anotar("error " + informe_sin_parametros(w.actual.direccion) + ": " + w.actual.error)
    else
        dw_estado(w, hueco2(tr(116, "Ready: %1 bytes in %2 ms"), "" + w.actual.bytes, "" + w.actual.ms))
    end
    mui_set_value(w.v.progreso, 0)
    modo_carga(w, false)
    mui_canvas_redraw(w.v.pagina)
    temporizadores(w)
    actualizar_giro(w)
    indicadores(w)
    pestanas_barra(w)
    descartar_pestanas()
    # al historial (tachyon:historial) lo que llegó bien, no las páginas propias
    if w.actual.error == "" and (str_starts(w.actual.direccion, "http:") or str_starts(w.actual.direccion, "https:"))
        historial_agregar(FICHERO_HISTORIAL, w.actual.direccion, w.actual.titulo, historial_ahora())
    end
end

# El único mui_timer, para todas las ventanas: cada 50 ms mientras algo llega, si no al siguiente
# temporizador del JavaScript
func programar()
    espera = -1
    for w in dw_ventanas
        if w.abierta
            if w.js_cuando >= 0
                e = w.js_cuando - time_ms()
                if e < 1
                    e = 1
                end
                if espera < 0 or e < espera
                    espera = e
                end
            end
            trayendo = w.carga != nil or w.preparando != nil or (w.actual != nil and imagenes_pendientes(w.actual.im) > 0)
            if trayendo and (espera < 0 or espera > 50)
                espera = 50
            end
            if w.aviso_scroll and (espera < 0 or espera > 30)
                espera = 30
            end
            if w.refresco_url != "" and w.refresco_doc == w.actual
                e = w.refresco_en - time_ms()
                if e < 1
                    e = 1
                end
                if espera < 0 or e < espera
                    espera = e
                end
            end
            if w.actual != nil and w.actual.js != 0 and jsdom_peticiones_pendientes(w.actual.js) > 0 and (espera < 0 or espera > 50)
                espera = 50
            end
            # una página con animaciones de CSS vivas (o recién maquetada: aún no se sabe): el siguiente fotograma
            if w.actual != nil and w.carga == nil and documento_animado(w.actual) and (w.animando or w.fotograma == 0)
                e = ANIMACION_MS - (time_ms() - w.fotograma)
                if e < 10
                    e = 10
                end
                if espera < 0 or e < espera
                    espera = e
                end
            end
            # un vídeo sonando: el tic, cuando toca su siguiente imagen
            if w.actual != nil and w.actual.videos != nil
                ev = videos_espera(w.actual.videos)
                if ev > 0 and (espera < 0 or ev < espera)
                    espera = ev
                end
            end
        end
    end
    # (las descargas, de todas las ventanas: lo que llega y la página tachyon:descargas al día)
    if (descargas_activas() > 0 or dw_act_carga != nil or dw_act_bajada != nil or dw_act_cat != nil or dw_cat_propio != nil) and (espera < 0 or espera > 250)
        espera = 250
    end
    if espera > 0
        mui_timer(espera, ID_TIC)
    end
end

# Lo que acaba de cambiar el JavaScript: si documento_al_dia sabe la zona (la ruta ligera), solo esa; si no, todo
# (tarea 37e7). Con la ventana a pantalla completa abierta, todo.
func repintar_cambiado(w: Ventana)
    d = w.actual
    if d.zona and (dw_completa == nil or dw_completa_de != w)
        if d.zx0 >= d.zx1 or d.zy0 >= d.zy1 or d.zy1 <= 0 or d.zy0 >= mui_height(w.v.pagina)
            return
        end
        w.zona = true
        mui_canvas_update_area(w.v.pagina, d.zx0, d.zy0, d.zx1 - d.zx0, d.zy1 - d.zy0)
        w.zona = false
        return
    end
    mui_canvas_redraw(w.v.pagina)
end

# Los setTimeout/setInterval que tocan en esa ventana
# Los <canvas> que el JavaScript dibujó (tarea 48a): solo su zona de la ventana se repinta (con lo que tengan encima)
func lienzos_al_dia(w: Ventana)
    if lienzos_cambiados() == 0 or w.actual == nil or w.actual.pagina == nil
        return
    end
    d = w.actual
    alto = mui_height(w.v.pagina)
    x0 = 1000000000
    y0 = 1000000000
    x1 = -1
    y1 = -1
    for dib in d.pagina.dibujos
        if dib.tipo == D_LIENZO
            lz = lienzo_de(dib.nodo)
            if lz != 0 and lienzo_sucio(lz)
                y = dib.y
                if not dib.fijo
                    y = y - w.desde
                end
                if y < alto and y + dib.alto > 0
                    x0 = mini(x0, dib.x)
                    y0 = mini(y0, y)
                    x1 = maxi(x1, dib.x + dib.ancho)
                    y1 = maxi(y1, y + dib.alto)
                end
            end
        end
    end
    if x1 < 0
        return
    end
    # (la zona del documento, la de un momento: la de los cambios del DOM se queda como estaba)
    zona = d.zona
    zx0 = d.zx0
    zy0 = d.zy0
    zx1 = d.zx1
    zy1 = d.zy1
    d.zona = true
    d.zx0 = maxi(x0, 0)
    d.zy0 = maxi(y0, 0)
    d.zx1 = x1
    d.zy1 = mini(y1, alto)
    repintar_cambiado(w)
    d.zona = zona
    d.zx0 = zx0
    d.zy0 = zy0
    d.zx1 = zx1
    d.zy1 = zy1
end

func mini(a: Int, b: Int) -> Int
    if a < b
        return a
    end
    return b
end

func maxi(a: Int, b: Int) -> Int
    if a > b
        return a
    end
    return b
end

const JS_CON_VIDEO_MS = 250

# ¿Suena algún vídeo en la página de la ventana?
func video_sonando(w: Ventana) -> Bool
    if w.actual == nil or w.actual.videos == nil
        return false
    end
    for r in w.actual.videos.lista
        if r.estado == V_SONANDO
            return true
        end
    end
    return false
end

func temporizadores(w: Ventana)
    cajas_a_su_hora(w)
    memoria_recortar()
    if w.carga == nil and js_sin_memoria(w)
        programar()
        return
    end
    if w.actual != nil and w.actual.js != 0 and w.carga == nil
        t0 = time_ms()
        # (load espera a las imágenes, como en un navegador: el JavaScript sabe cuántas faltan)
        faltan = imagenes_pendientes(w.actual.im)
        if faltan != w.actual.imgs_js
            w.actual.imgs_js = faltan
            js_evaluar(w.actual.js, "__dashweb_imgs = " + faltan, "dashweb")
        end
        documento_resize(w.actual)
        espera = jsdom_temporizadores(w.actual.js)
        w.actual.ms_temporizadores = w.actual.ms_temporizadores + time_ms() - t0
        w.actual.desde = w.desde
        w.actual.alto_vista = mui_height(w.v.pagina)
        if traza_activa
            traza("temporizadores del JavaScript en " + (time_ms() - t0) + " ms; el siguiente en " + espera + " ms")
        end
        if documento_al_dia(w.actual)
            ajustar_barra(w)
            repintar_cambiado(w)
        end
        lienzos_al_dia(w)
        w.js_cuando = -1
        # (con un vídeo sonando, los temporizadores de la página esperan al menos JS_CON_VIDEO_MS: el reproductor
        # decodifica en este bucle y YouTube despierta los suyos cada 50 ms; tarea 64c)
        if espera >= 0 and espera < JS_CON_VIDEO_MS and video_sonando(w)
            espera = JS_CON_VIDEO_MS
        end
        if espera >= 0
            w.js_cuando = time_ms() + espera
        end
        # (una maqueta aplazada por cara: entonces, aunque la página no tenga más temporizadores)
        if w.actual.aplazada >= 0 and (w.js_cuando < 0 or w.actual.aplazada < w.js_cuando)
            w.js_cuando = w.actual.aplazada
        end
        envio_del_js(w)
        desplazamiento_del_js(w)
        intersecciones(w, false)
    end
    programar()
end

# Con poca memoria libre, el JavaScript de la página se suelta entero (sus peticiones y los scripts que le
# faltaban, también) y la página se queda como está, en vez de seguir pidiendo hasta que el Amiga no tenga nada: los
# resultados de YouTube y la página de un vídeo, con 256 MB, se comían hasta el último KB y Tachyon se caía sin decir
# nada (tarea 64g). Pararlo sin soltarlo no bastaba: seguían llegando scripts y respuestas. Antes se sueltan las
# pestañas de detrás
func js_sin_memoria(w: Ventana) -> Bool
    d = w.actual
    if d == nil or d.js == 0 or mem_total() / 1024 >= dw_js_minima
        return false
    end
    descartar_pestanas_bajo(dw_js_minima)
    mem_trim()
    if mem_total() / 1024 >= dw_js_minima
        return false
    end
    antes = mem_total() / 1024
    documento_soltar_js(d)
    d.js_sin_memoria = true
    w.js_cuando = -1
    mem_trim()
    traza("poca memoria (" + antes + " KB libres): fuera el JavaScript de la página; ahora " + mem_total() / 1024 + " KB libres")
    dw_estado(w, tr(528, "Low memory: the page's JavaScript was stopped"))
    return true
end

# Las animaciones de CSS de la página: un fotograma (como mucho cada ANIMACION_MS) y se repinta
const ANIMACION_MS = 66

func animar_ventana(w: Ventana)
    if w.actual == nil or w.carga != nil or not documento_animado(w.actual)
        w.animando = false
        return
    end
    if time_ms() - w.fotograma < ANIMACION_MS
        w.animando = true
        return
    end
    w.fotograma = time_ms()
    w.actual.desde = w.desde
    w.actual.alto_vista = mui_height(w.v.pagina)
    w.animando = documento_animar(w.actual)
    repintar_cambiado(w)
end

# Si el JavaScript pidió desplazar la vista (scrollTo, scrollIntoView...), se desplaza
func desplazamiento_del_js(w: Ventana)
    if w.actual == nil or w.actual.js == 0 or w.actual.pagina == nil
        return
    end
    y = jsdom_desplazamiento(w.actual.js)
    if y >= 0 and y != w.desde
        w.desde = y
        ajustar_barra(w)
        mui_canvas_redraw(w.v.pagina)
        w.aviso_scroll = true
    end
end

# Los IntersectionObserver de la página (todo: todos; si no, solo si hay observe nuevos), con la vista de ahora
func intersecciones(w: Ventana, todo: Bool)
    if w.actual == nil or w.actual.js == 0 or w.actual.pagina == nil or w.carga != nil
        return
    end
    documento_vista(w.actual, mui_width(w.v.pagina), mui_height(w.v.pagina), w.desde)
    w.io_pagina = w.actual.pagina
    jsdom_intersecciones(w.actual.js, todo)
end

# La vista se movió: el evento scroll al JavaScript (uno por tic aunque la barra mande muchos)
func avisar_desplazamiento(w: Ventana)
    w.aviso_scroll = false
    if w.actual == nil or w.actual.js == 0 or w.actual.pagina == nil or w.carga != nil
        return
    end
    documento_vista(w.actual, mui_width(w.v.pagina), mui_height(w.v.pagina), w.desde)
    t0 = time_ms()
    jsdom_desplazado(w.actual.js)
    intersecciones(w, true)
    if documento_al_dia(w.actual)
        ajustar_barra(w)
        mui_canvas_redraw(w.v.pagina)
    end
    if traza_activa
        traza("evento scroll (desde " + w.desde + ") en " + (time_ms() - t0) + " ms")
    end
    desplazamiento_del_js(w)
end

# Un tic: cargas, imágenes y temporizadores de una ventana
# El ratón se movió sobre la página (o salió de ella): :hover y los sucesos del ratón del JavaScript (tarea 37f3)
func raton(w: Ventana)
    if not w.abierta or w.actual == nil or w.carga != nil or w.actual.pagina == nil
        return
    end
    if mui_canvas_pointer_inside(w.v.pagina)
        x = mui_canvas_pointer_x(w.v.pagina)
        y = mui_canvas_pointer_y(w.v.pagina)
        documento_raton(w.actual, x, y + w.desde, y)
        # (sobre un vídeo: su barra de controles se ve un rato; tarea 64f)
        vid = documento_video_en_punto(w.actual, x, y + w.desde)
        if vid != nil and videos_tocar(documento_videos(w.actual), vid)
            mui_canvas_redraw(w.v.pagina)
        end
    else
        documento_raton(w.actual, -1, -1, -1)
    end
    if documento_al_dia(w.actual)
        ajustar_barra(w)
        mui_canvas_redraw(w.v.pagina)
    end
    # (lo que el JavaScript haya programado al moverse el ratón)
    temporizadores(w)
end

# CAJASEN: las cajas una vez, a su hora (desde tic y desde temporizadores: con temporizadores seguidos no hay tic)
func cajas_a_su_hora(w: Ventana)
    # (un temporizador de la página: cuando ya no hace nada, no hay tic que lo mire)
    if dw_js_en >= 0 and dw_js != "" and w.actual != nil and w.actual.js != 0
        resto = dw_js_en - (time_ms() - dw_js_t0)
        if resto < 0
            resto = 0
        end
        dw_js_en = -1
        js_evaluar(w.actual.js, "setTimeout(function () { try { console.log('JS> ' + (" + dw_js + ")); } catch (e) { console.log('JS> ' + e); } }, " + resto + ")", "dashweb")
    end
    if dw_cajas_en >= 0 and w.actual != nil and w.actual.doc != nil and w.carga == nil and w.preparando == nil and time_ms() - w.empezada >= dw_cajas_en
        dw_cajas_en = -1
        cajas_volcar(w.actual.doc, 0)
    end
end

# Los bloques pequeños de Dash que se han quedado libres, de vuelta al sistema cada 2 s (D80): sin esto se quedaban en
# charcos repartidos por la memoria, y con 128 MB el mayor bloque libre no daba para el script principal de YouTube
# (10,5 MB seguidos)
func memoria_recortar()
    if time_ms() - dw_recorte >= 2000
        dw_recorte = time_ms()
        n = mem_trim()
        if n >= 65536
            traza("devueltos al sistema " + (n / 1024) + " KB de bloques pequeños")
        end
    end
end

func tic(w: Ventana)
    cajas_a_su_hora(w)
    memoria_recortar()
    # (también mientras llegan sus scripts y respuestas, sin temporizadores)
    if w.carga == nil and w.preparando == nil
        js_sin_memoria(w)
    end
    avanzar_carga(w)
    pendientes_a_la_traza(w)
    ir_pedido(w)
    # (la pestaña descartada que volvía a su sitio: con la página ya cargada, lo más cerca que se pueda)
    if w.desde_volver >= 0 and w.actual != nil and w.carga == nil and w.preparando == nil and imagenes_pendientes(w.actual.im) == 0
        w.desde = w.desde_volver
        w.desde_volver = -1
        ajustar_barra(w)
        mui_canvas_redraw(w.v.pagina)
    end
    # un script que no acababa (un bucle sin fin): cortado, y se dice (tarea 40c)
    if js_cortado()
        dw_estado(w, tr(117, "A script on the page took too long: stopped"))
        Print "tachyon: un script de la página pasaba de 120 s y se cortó"
        registro_anotar("a script took more than 120 s: stopped")
    end
    if w.actual != nil and documento_imagenes(w.actual) and documento_imagenes_visibles(w.actual, w.desde, estilo_vh)
        ajustar_barra(w)
        mui_canvas_redraw(w.v.pagina)
    end
    if w.actual != nil and w.carga == nil and imagenes_pendientes(w.actual.im) > 0
        dw_estado(w, hueco(tr(118, "Images: %1 left"), "" + imagenes_pendientes(w.actual.im)))
    elif w.actual != nil and w.carga == nil and str_starts(mui_get_text(w.v.estado), str_split(tr(118, "Images: %1 left"), "%1")[0])
        dw_estado(w, tr(40, "Ready"))
        # (en la salida: para medir la página entera, con sus imágenes)
        kb_js = 0
        if w.actual.js != 0
            kb_js = js_memoria(w.actual.js) / 1024
        end
        if dw_dibujos_y0 >= 0 and w.actual.pagina != nil
            for d in w.actual.pagina.dibujos
                if d.y + d.alto >= dw_dibujos_y0 and d.y <= dw_dibujos_y1
                    nodo = ""
                    if d.nodo != nil
                        nodo = d.nodo.nombre + "." + dom_atributo(d.nodo, "class")
                    end
                    t = d.texto
                    if t.length > 40
                        t = t[:40]
                    end
                    rec = ""
                    if d.recorte
                        rec = " recorte " + d.rx0 + "," + d.ry0 + "-" + d.rx1 + "," + d.ry1
                    end
                    Print "dibujo " + d.tipo + " [" + d.x + "," + d.y + " " + d.ancho + "x" + d.alto + "] " + d.color + " capa " + d.capa + " velado " + d.velado + rec + " " + t + " <" + nodo + ">"
                end
            end
        end
        if dw_cajas != "" and w.actual.doc != nil
            cajas_volcar(w.actual.doc, 0)
        end
        w.actual.t_entera = time_ms() - w.empezada
        Print "tachyon: " + w.actual.direccion + " entera en " + (time_ms() - w.empezada) + " ms; memoria libre " + mem_total() / 1024 + " KB (JavaScript " + kb_js + " KB, " + imagenes_kb(w.actual.im) + ")"
        registro_anotar("complete " + informe_sin_parametros(w.actual.direccion) + " in " + (time_ms() - w.empezada) + " ms; free memory " + mem_total() / 1024 + " KB (JavaScript " + kb_js + " KB)")
    end
    if w.aviso_scroll
        avisar_desplazamiento(w)
    end
    # las respuestas a los XMLHttpRequest y fetch del JavaScript (tarea 37e2)
    if w.actual != nil and w.actual.js != 0 and w.carga == nil and jsdom_peticiones_avanzar(w.actual.js) > 0
        if documento_al_dia(w.actual)
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
        temporizadores(w)
    end
    # una maqueta nueva: los IntersectionObserver otra vez
    if w.actual != nil and w.actual.pagina != nil and w.io_pagina != w.actual.pagina
        intersecciones(w, true)
        if documento_al_dia(w.actual)
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
    end
    videos_pila_traza()
    animar_ventana(w)
    if w.js_cuando >= 0 and time_ms() >= w.js_cuando
        temporizadores(w)
    end
    if w.actual != nil and w.actual.videos != nil
        # cada vuelta por el bucle de eventos cuesta unos 27 ms en la máquina RTG emulada: si la imagen
        # siguiente ya toca, se enseña aquí mismo (hasta 4 seguidas: la ventana sigue respondiendo)
        vueltas = 0
        while vueltas < 4
            if videos_avanzar(w.actual.videos)
                mui_canvas_update(w.v.pagina)
                if dw_completa != nil and dw_completa_de == w
                    mui_canvas_update(dw_completa_lienzo)
                end
            end
            if videos_adelantar(w.actual.videos)
                mui_canvas_update(w.v.pagina)
                if dw_completa != nil and dw_completa_de == w
                    mui_canvas_update(dw_completa_lienzo)
                end
            end
            vueltas = vueltas + 1
            if videos_espera(w.actual.videos) != 1
                break
            end
        end
    end
    if w.actual != nil and w.actual.videos != nil and time_ms() - w.estado_video > 1000
        e = videos_estado(w.actual.videos)
        if e != ""
            dw_estado(w, e)
            w.estado_video = time_ms()
        end
    end
    actualizar_giro(w)
end

func clic(w: Ventana)
    if w.actual == nil or w.actual.pagina == nil
        return
    end
    n = maqueta_nodo_en_vista(w.actual.pagina, mui_canvas_mouse_x(w.v.pagina), mui_canvas_mouse_y(w.v.pagina), w.desde)
    if n == nil
        return
    end
    seguir = true
    if w.actual.js != 0
        seguir = jsdom_clic(w.actual.js, n)
        if documento_al_dia(w.actual)
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
        temporizadores(w)
        envio_del_js(w)
    end
    # (el vídeo de la página de YouTube va con el reproductor de Tachyon aunque el JavaScript del suyo cancele el clic)
    de_pagina = documento_video_en(w.actual, mui_canvas_mouse_x(w.v.pagina), mui_canvas_mouse_y(w.v.pagina) + w.desde)
    if not seguir and de_pagina == nil
        return
    end
    # un <video>: reproducir o parar; en su esquina, a pantalla completa
    vid = documento_video_de(n)
    if de_pagina != nil
        vid = de_pagina
    end
    if vid != nil
        dib = documento_video_dibujo(w.actual, vid)
        if dib != nil
            dx = mui_canvas_mouse_x(w.v.pagina) - dib.x
            dy = mui_canvas_mouse_y(w.v.pagina) + w.desde - dib.y
            # la barra de controles: reproducir o parar, y saltar en la línea de tiempo (tarea 64f)
            k = videos_en_barra(documento_videos(w.actual), vid, dx, dy, dib.ancho, dib.alto)
            if k >= 2
                mui_canvas_redraw(w.v.pagina)
                programar()
                return
            end
            if videos_en_completa(documento_videos(w.actual), vid, dx, dy, dib.ancho, dib.alto)
                pantalla_completa(w, videos_de(documento_videos(w.actual), vid))
                return
            end
        end
        videos_alternar(documento_videos(w.actual), vid, w.actual.direccion)
        mui_canvas_redraw(w.v.pagina)
        programar()
        return
    end
    # el formulario: foco, marcar, elegir, enviar
    r = formulario_clic(n)
    var nadie: Nodo = nil
    foco = nadie
    if r == FORM_FOCO
        foco = n
    end
    if foco != w.foco
        w.foco = foco
        mui_canvas_redraw(w.v.pagina)
    end
    if r == FORM_CAMBIO
        mui_canvas_redraw(w.v.pagina)
    elif r == FORM_ENVIAR
        enviar(w, n)
    elif r == FORM_NADA
        destino = documento_enlace(w.actual, n)
        if destino != ""
            # con Mayúsculas o Amiga, en una pestaña nueva (como Ctrl-clic en los navegadores de hoy)
            if con_mayusculas_o_amiga()
                nueva_pestana(w, destino)
            else
                navegar(w, destino)
            end
        end
    end
end

# Envía el formulario de desde (un botón, el campo donde se pulsó Return o el form de form.submit()):
# antes el evento submit (onsubmit puede pararlo), después GET o POST según su method
func enviar(w: Ventana, desde: Nodo)
    form = formulario_de(desde)
    if form == nil
        return
    end
    if w.actual.js != 0 and not jsdom_evento(w.actual.js, form, "submit")
        return
    end
    enviar_formulario(w, desde)
end

func enviar_formulario(w: Ventana, desde: Nodo)
    e = formulario_envio(desde, w.actual.direccion)
    if e.metodo == "POST"
        abrir_post(w, e.direccion, e.cuerpo)
        apuntar(w, e.direccion)
    elif e.direccion != ""
        navegar(w, e.direccion)
    end
end

# Si el JavaScript llamó a form.submit(), se envía
func envio_del_js(w: Ventana)
    if w.actual == nil or w.actual.js == 0
        return
    end
    f = jsdom_envio(w.actual.js)
    if f != nil
        enviar_formulario(w, f)
    end
end

# Una página propia sin lo que hace algo (borrar, quitar, usar, enviar...): lo que queda en atrás y adelante, para
# que volver no lo haga otra vez; las búsquedas (tachyon:buscar?q=, tachyon:historial?buscar=) se quedan
func tachyon_sin_accion(d: String) -> String
    p = str_find(d, "?")
    if not str_starts(d, "tachyon:") or p < 0 or str_starts(d, "tachyon:buscar?")
        return d
    end
    if str_starts(d, "tachyon:historial?buscar=")
        f = str_find(d, "&")
        if f >= 0
            return d[:f]
        end
        return d
    end
    return d[:p]
end

# Lo que pide hacer algo en una página propia solo vale desde otra página propia: una web no puede
# borrar el historial, las cookies o los marcadores con un enlace (ni con location ni un refresh)
func destino_permitido(w: Ventana, destino: String) -> String
    if tachyon_sin_accion(destino) == destino or (w.actual != nil and str_starts(w.actual.direccion, "tachyon:"))
        return destino
    end
    # (extraer un comprimido: desde su página, que es file:; pide dónde con el diálogo, así que no hace nada solo)
    if str_starts(destino, "tachyon:archivo?extraer=") and w.actual != nil and str_starts(w.actual.direccion, "file:")
        return destino
    end
    return tachyon_sin_accion(destino)
end

# Ir a una dirección nueva: lo que había delante en el historial se descarta. Un enlace a otra parte
# de la misma página solo desplaza.
func navegar(w: Ventana, destino: String)
    if w.actual != nil and documento_sin_fragmento(destino) == documento_sin_fragmento(w.actual.direccion) and documento_fragmento(destino) != ""
        y = documento_y_de(w.actual, documento_fragmento(destino))
        if y >= 0
            w.desde = y
            ajustar_barra(w)
            mui_canvas_redraw(w.v.pagina)
        end
        return
    end
    destino = destino_permitido(w, destino)
    mui_set_text(w.v.url, tachyon_sin_accion(destino))
    abrir(w, destino)
    apuntar(w, tachyon_sin_accion(destino))
end

# history.pushState, replaceState y go de la página (tarea 64d; lib/jsdom.dash jsdom_historia): la dirección nueva
# en la barra y en el historial de la ventana, sin cargar nada
func historia_del_js(w: Ventana)
    d = w.actual
    if d == nil or d.doc == nil or d.js == 0
        return
    end
    t = jsdom_historia_tomar(d.doc)
    if t == ""
        return
    end
    for linea in str_split(t, "\n")
        sp = str_find(linea, " ")
        if sp <= 0
            continue
        end
        op = linea[:sp]
        arg = linea[sp + 1:]
        if op == "push"
            if youtube_a_video(d.direccion, arg)
                navegar(w, arg)
                return
            end
            if d.paso0 < 0
                d.paso0 = w.visto
            end
            d.direccion = arg
            mui_set_text(w.v.url, arg)
            apuntar(w, arg)
            d.pason = w.visto
        elif op == "replace"
            d.direccion = arg
            mui_set_text(w.v.url, arg)
            if w.visto >= 0 and w.visto < w.pasos.length
                w.pasos[w.visto] = arg
            end
        elif op == "go"
            v = w.visto + Int(arg)
            if v >= 0 and v < w.pasos.length
                w.visto = v
                d.direccion = w.pasos[v]
                mui_set_text(w.v.url, d.direccion)
                botones(w)
            end
        elif op == "fuera"
            paso_historial(w, Int(arg), false)
        end
    end
end

# YouTube navega sin recargar de los resultados (o la portada) a un vídeo, pero su reproductor no llega a crearse así en
# Tachyon (la página del vídeo se quedaba con un recuadro negro, sin título, más de 15 minutos en la máquina RTG):
# ese paso se hace cargando la página del vídeo entera, que sí sale y suena (tarea 64d)
func youtube_a_video(antes: String, despues: String) -> Bool
    return dom_es_youtube(despues) and str_find(str_lower(despues), "youtube.com/watch") >= 0 and dom_youtube_id(despues) != "" and dom_youtube_id(despues) != dom_youtube_id(antes)
end

# Inspeccionar (tarea 65): la página de la ventana w en otra ventana, tachyon:inspeccionar (lib/inspeccionar.dash).
# Se mira la página que tenga esa ventana cada vez que se refresca; lo evaluado en su consola se va juntando
var dw_insp: Ventana = nil
var dw_insp_consola: String = ""

func inspeccionar(w: Ventana)
    if w.actual == nil or str_starts(w.actual.direccion, "tachyon:inspeccionar")
        return
    end
    if dw_insp != w
        dw_insp_consola = ""
    end
    dw_insp = w
    for v in dw_ventanas
        if v.abierta and v.actual != nil and str_starts(v.actual.direccion, "tachyon:inspeccionar")
            # (ya hay una: se refresca con esta)
            abrir(v, "tachyon:inspeccionar")
            return
        end
    end
    if nueva_ventana("tachyon:inspeccionar") == nil
        dw_estado(w, tr(515, "No room for another window"))
    end
end

# La página de Inspeccionar para tachyon:inspeccionar[?nodo=ruta][&js=expresión]
func inspeccionar_pedido(direccion: String) -> String
    if dw_insp == nil or not dw_insp.abierta or dw_insp.actual == nil
        return "<html><head><title>" + tr(506, "Inspect") + "</title></head><body><p>" + tr(516, "The window that was inspected is closed.") + "</p></body></html>"
    end
    d = dw_insp.actual
    nodo = ""
    q = str_find(direccion, "?")
    if q >= 0
        for par in str_split(direccion[q + 1:], "&")
            p = str_find(par, "=")
            if p > 0
                k = par[:p]
                v = url_deshacer(str_replace(par[p + 1:], "+", " "))
                if k == "nodo"
                    nodo = v
                elif k == "js" and v != "" and d.js != 0
                    r = js_evaluar(d.js, v, "consola")
                    e = js_error(d.js)
                    clase = ""
                    if e != ""
                        r = e
                        clase = " class=error"
                    end
                    dw_insp_consola = dw_insp_consola + "<div>&gt; " + inspeccionar_escapar(v) + "</div><div" + clase + ">&lt; " + inspeccionar_escapar(r) + "</div>"
                    documento_al_dia(d)
                end
            end
        end
    end
    return inspeccionar_html(d, nodo, dw_insp_consola)
end

# Un clic a pantalla completa en la barra de controles del vídeo: lo que hizo (videos_en_barra; 0 si no cayó en ella)
func barra_completa() -> Int
    if dw_completa == nil or dw_completa_de == nil or dw_completa_de.actual == nil
        return 0
    end
    vs = documento_videos(dw_completa_de.actual)
    k = videos_en_barra(vs, dw_completa.nodo, mui_canvas_mouse_x(dw_completa_lienzo), mui_canvas_mouse_y(dw_completa_lienzo), mui_width(dw_completa_lienzo), mui_height(dw_completa_lienzo))
    if k == 1
        videos_alternar(vs, dw_completa.nodo, dw_completa_de.actual.direccion)
    end
    return k
end

# El registro de depuración de red, encendido o apagado (tarea 67): la traza a DEPURACION_FICHERO, empezado de nuevo
# con lo que es el Amiga (lo del informe de depuración: versiones, CPU, memoria, red y AmiSSL)
func depuracion(si: Bool)
    if si
        traza_activa = true
        traza_t0 = time_ms()
        traza_a_fichero(DEPURACION_FICHERO, "Tachyon network debug log\n" + informe_texto(DASHWEB_VERSION, http_idiomas, dw_ultima_pagina) + "\n--- trace ---\n")
    else
        traza_a_fichero("", "")
        traza_activa = false
    end
end

# Depuración de red (tarea 67; lo pidió Oskis R.P): mientras una página se carga, cada 10 s, a la traza lo que queda
# pendiente y en qué está (la página, sus hojas y scripts, las peticiones de su JavaScript, las imágenes)
var dw_pendientes_t: Int = 0

func pendientes_a_la_traza(w: Ventana)
    if not traza_activa or time_ms() - dw_pendientes_t < 10000
        return
    end
    if w.carga == nil and w.preparando == nil
        return
    end
    dw_pendientes_t = time_ms()
    traza("pendiente (" + (time_ms() - w.empezada) / 1000 + " s desde que se pidió " + w.carga_dir + "):")
    if w.carga != nil
        traza("  la página: " + http_estado(w.carga))
    end
    if w.preparando != nil and w.preparando.recursos != nil
        for p in w.preparando.recursos.cola
            if p.carga == nil
                traza("  " + p.direccion + ": en cola")
            else
                traza("  " + p.direccion + ": " + http_estado(p.carga))
            end
        end
    end
    d = w.actual
    if w.preparando != nil
        d = w.preparando
    end
    if d != nil and d.js != 0
        traza("  peticiones del JavaScript: " + jsdom_peticiones_pendientes(d.js))
    end
end

# ¿n sigue colgando del documento doc?
func nodo_en_documento(doc: Nodo, n: Nodo) -> Bool
    m = n
    while m != nil
        if m == doc
            return true
        end
        m = m.padre
    end
    return false
end

# ¿La entrada i del historial de la ventana es de la página que se ve (de su history.pushState)?
func del_mismo_documento(w: Ventana, i: Int) -> Bool
    d = w.actual
    return d != nil and d.js != 0 and d.paso0 >= 0 and i >= d.paso0 and i <= d.pason
end

# Atrás (-1) o adelante (+1) en el historial de la ventana; entre entradas de la misma página (con_js), por su
# history.go: popstate, y la página cambia sola
func paso_historial(w: Ventana, n: Int, con_js: Bool)
    v = w.visto + n
    if v < 0 or v >= w.pasos.length
        return
    end
    if con_js and del_mismo_documento(w, v) and del_mismo_documento(w, w.visto)
        js_evaluar(w.actual.js, "history.go(" + n + ")", "dashweb")
        temporizadores(w)
        return
    end
    w.visto = v
    direccion = w.pasos[w.visto]
    mui_set_text(w.v.url, direccion)
    abrir(w, direccion)
    botones(w)
end

# La página pide ir a otra (tarea 51): su JavaScript (location.replace...; la de salto de DuckDuckGo) o su
# <meta http-equiv="refresh">, cuando toca
func ir_pedido(w: Ventana)
    historia_del_js(w)
    var d: Documento = w.actual
    if w.preparando != nil
        d = w.preparando
    end
    if d == nil or d.doc == nil
        return
    end
    u = dom_atributo(d.doc, "ir")
    if u != ""
        sustituir = dom_atributo(d.doc, "ir_sustituir") == "1"
        jsdom_navegar(d.doc, "", false)
        ir_a(w, u, sustituir)
        return
    end
    if w.carga == nil and w.preparando == nil and w.actual != nil and w.refresco_doc != w.actual
        w.refresco_doc = w.actual
        w.refresco_url = ""
        r = documento_refresco(w.actual)
        espacio = str_find(r, " ")
        if espacio > 0
            w.refresco_en = time_ms() + Int(r[:espacio]) * 1000
            w.refresco_url = r[espacio + 1:]
        end
    end
    if w.refresco_url != "" and w.refresco_doc == w.actual and w.carga == nil and time_ms() >= w.refresco_en
        u = w.refresco_url
        w.refresco_url = ""
        ir_a(w, u, true)
    end
end

# Abrir lo que pidió la página; sustituir: en lugar de ella en el historial (location.replace, el refresh), que atrás
# no vuelva a la que salta
func ir_a(w: Ventana, destino: String, sustituir: Bool)
    if not sustituir or w.visto < 0 or w.visto >= w.pasos.length
        navegar(w, destino)
        return
    end
    if w.actual != nil and documento_sin_fragmento(destino) == documento_sin_fragmento(w.actual.direccion) and documento_fragmento(destino) != ""
        navegar(w, destino)
        return
    end
    destino = destino_permitido(w, destino)
    mui_set_text(w.v.url, tachyon_sin_accion(destino))
    abrir(w, destino)
    w.pasos[w.visto] = tachyon_sin_accion(destino)
    botones(w)
end

# Una entrada nueva en el historial (lo que había delante se descarta)
func apuntar(w: Ventana, destino: String)
    while w.pasos.length > w.visto + 1
        w.pasos.remove(w.pasos.length - 1)
    end
    w.pasos.push(destino)      # la pedida: la página aún está llegando
    w.visto = w.pasos.length - 1
    botones(w)
end

# Atrás y adelante: con su flecha azul si llevan a algún sitio y en gris si no (un botón
# desactivado de MUI sale tapado por una trama); pulsar uno apagado no hace nada
func botones(w: Ventana)
    atras = w.visto > 0
    adelante = w.visto < w.pasos.length - 1
    # (un botón encendido y otro apagado de cada uno: MUI 3.8 no cambia la imagen de un botón ya hecho)
    if atras != w.con_atras
        w.con_atras = atras
        mui_set_visible(w.v.atras, atras)
        mui_set_visible(w.v.atras_no, not atras)
    end
    if adelante != w.con_adelante
        w.con_adelante = adelante
        mui_set_visible(w.v.adelante, adelante)
        mui_set_visible(w.v.adelante_no, not adelante)
    end
end

# Desplaza la página n píxeles (la barra avisa con ID_SCROLL y se repinta)
func desplazar(w: Ventana, n: Int)
    mui_set_value(w.v.barra, mui_get_value(w.v.barra) + n)
end

# La versión, en "Acerca de..." (menú Proyecto) con la fecha en que se compiló; y para el comando Version del Amiga,
# la cadena $VER del ejecutable (@version, con la fecha en que se compila: las dos versiones van juntas)
const DASHWEB_VERSION = "0.9.5-alfa"
@version "Tachyon 0.9.5-alfa"

func texto_version(v: String) -> String
    esc = str_char(27)
    return esc + "c" + esc + "bTachyon " + v + esc + "n\n" + esc + "c"
end

# La fecha y la hora en que se compiló ("Oct 24 2026", "02:26:47"), para Acerca de
func compilado_fecha() -> String
    return build_date()
end

func compilado_hora() -> String
    return build_time()
end

# Corre la ventana (las del mismo .dashui salen en el mismo sitio)
func mover_ventana(win: Int, dx: Int, dy: Int)
    mui_window_move(win, dx, dy)
end

# Una ventana nueva con esa dirección ("" = la página de inicio); nil si ya hay MAX_VENTANAS
# === Pestañas (tarea 46) ===
# Una fila de botones encima de la página, escondida con una sola: Dash no añade objetos MUI mientras corre, así que
# son MAX_PESTANAS botones hechos de antes que se enseñan con el título de su página (la de delante, en negrita).

func _pestanas(w: Ventana) -> [Pestana]
    if w.pestanas == nil
        var ps: [Pestana] = []
        ps.push(Pestana())
        w.pestanas = ps
        w.pestana = 0
    end
    return w.pestanas
end

# La de delante, a su Pestana
func pestana_guardar(w: Ventana)
    p = _pestanas(w)[w.pestana]
    p.actual = w.actual
    p.desde = w.desde
    if w.desde_volver >= 0
        p.desde = w.desde_volver
        w.desde_volver = -1
    end
    p.pasos = w.pasos
    p.visto = w.visto
    p.carga = w.carga
    p.carga_dir = w.carga_dir
    p.preparando = w.preparando
    p.js_cuando = w.js_cuando
    p.foco = w.foco
    p.empezada = w.empezada
    p.io_pagina = w.io_pagina
    p.animando = w.animando
    p.fotograma = w.fotograma
    p.url = mui_get_text(w.v.url)
    p.estado = mui_get_text(w.v.estado)
    # (detrás, sin sus imágenes decodificadas: se quedan sus ficheros y se decodifican otra vez al volver)
    if w.actual != nil
        imagenes_dormir(w.actual.im)
    end
end

# La pestaña i, delante (su página, su dirección, sus botones y su barra de estado)
func pestana_traer(w: Ventana, i: Int)
    p = _pestanas(w)[i]
    w.pestana = i
    w.actual = p.actual
    w.desde = p.desde
    w.pasos = p.pasos
    w.visto = p.visto
    w.carga = p.carga
    w.carga_dir = p.carga_dir
    w.preparando = p.preparando
    w.js_cuando = p.js_cuando
    w.foco = p.foco
    w.empezada = p.empezada
    w.io_pagina = p.io_pagina
    w.animando = p.animando
    w.fotograma = p.fotograma
    if w.actual != nil
        imagenes_despertar(w.actual.im)
    end
    mui_set_text(w.v.url, p.url)
    poner_titulo(w)
    dw_estado(w, p.estado)
    modo_carga(w, w.carga != nil or w.preparando != nil)
    botones(w)
    indicadores(w)
    ajustar_barra(w)
    actualizar_giro(w)
    pestanas_barra(w)
    mui_canvas_redraw(w.v.pagina)
    # (descartada por falta de memoria: su página otra vez)
    if p.descartada
        p.descartada = false
        if w.visto >= 0 and w.visto < w.pasos.length
            # (sin página: la barra a cero, que su aviso no parezca un desplazamiento de quien mira)
            w.desde = 0
            mui_set_value(w.v.barra, 0)
            abrir(w, w.pasos[w.visto])
            w.desde_volver = p.desde
        end
    end
    programar()
end

func _pestana_boton(w: Ventana, i: Int) -> Int
    if i == 0
        return w.v.pest0
    elif i == 1
        return w.v.pest1
    elif i == 2
        return w.v.pest2
    elif i == 3
        return w.v.pest3
    elif i == 4
        return w.v.pest4
    elif i == 5
        return w.v.pest5
    elif i == 6
        return w.v.pest6
    end
    return w.v.pest7
end

# El nombre de la pestaña i en su botón: el título de su página (o su dirección), cortado
func _pestana_nombre(w: Ventana, i: Int) -> String
    d = w.actual
    url = mui_get_text(w.v.url)
    if i != w.pestana
        d = w.pestanas[i].actual
        url = w.pestanas[i].url
    end
    t = url
    if d != nil and d.titulo != ""
        t = d.titulo
    elif d == nil and i != w.pestana and w.pestanas[i].titulo != ""
        t = w.pestanas[i].titulo
    end
    if t == ""
        t = tr(160, "New tab")
    end
    if t.length > 18
        t = t[:16] + "..."
    end
    return t
end

# La barra de pestañas al día: escondida con una sola; cada botón con su nombre, el de delante en negrita
func pestanas_barra(w: Ventana)
    ps = _pestanas(w)
    mui_set_visible(w.v.pestanas, ps.length > 1)
    if ps.length <= 1
        return
    end
    for i in (0..MAX_PESTANAS - 1)
        b = _pestana_boton(w, i)
        if i < ps.length
            nombre = _pestana_nombre(w, i)
            if i == w.pestana
                nombre = "\eb" + nombre
            end
            mui_set_text(b, nombre)
        end
        mui_set_visible(b, i < ps.length)
    end
end

# Una pestaña nueva, delante, con direccion (o la página de inicio)
func nueva_pestana(w: Ventana, direccion: String)
    ps = _pestanas(w)
    if ps.length >= MAX_PESTANAS
        dw_estado(w, hueco(tr(161, "At most %1 tabs per window"), "" + MAX_PESTANAS))
        return
    end
    pestana_guardar(w)
    descartar_pestanas()
    ps.push(Pestana())
    var nada: Documento = nil
    var sin_carga: Carga = nil
    var nadie: Nodo = nil
    var sin_pagina: Pagina = nil
    var sin_pasos: [String] = []
    w.actual = nada
    w.preparando = nada
    w.carga = sin_carga
    w.foco = nadie
    w.io_pagina = sin_pagina
    w.pasos = sin_pasos
    w.visto = -1
    w.desde = 0
    w.js_cuando = -1
    w.animando = false
    w.fotograma = 0
    w.pestana = ps.length - 1
    mui_set_text(w.v.url, "")
    botones(w)
    pestanas_barra(w)
    if direccion != ""
        navegar(w, direccion)
    else
        abrir(w, "")
    end
    pestanas_barra(w)
end

# Cierra la de delante (la última, la ventana) y trae la de al lado
func cerrar_pestana(w: Ventana)
    ps = _pestanas(w)
    if ps.length <= 1
        cerrar_ventana(w)
        return
    end
    parar_carga(w)
    if w.actual != nil
        documento_liberar(w.actual)
    end
    ps.remove(w.pestana)
    i = w.pestana
    if i >= ps.length
        i = ps.length - 1
    end
    pestana_traer(w, i)
end

# Con poca memoria libre, las pestañas de detrás de todas las ventanas sueltan su página (se quedan su dirección, su
# historial y su título) hasta que vuelve a haber; se cargan al traerlas
func descartar_pestanas()
    descartar_pestanas_bajo(dw_poca_memoria)
end

func descartar_pestanas_bajo(kb: Int)
    for w in dw_ventanas
        if w.abierta and w.pestanas != nil
            for i in (0..w.pestanas.length - 1)
                if mem_total() / 1024 >= kb
                    return
                end
                p = w.pestanas[i]
                if i != w.pestana and p.actual != nil
                    if p.carga != nil
                        http_cancelar(p.carga)
                        var sin_carga: Carga = nil
                        p.carga = sin_carga
                    end
                    p.titulo = p.actual.titulo
                    documento_liberar(p.actual)
                    var nada: Documento = nil
                    p.actual = nada
                    if p.preparando != nil
                        documento_liberar(p.preparando)
                        p.preparando = nada
                    end
                    p.descartada = true
                end
            end
        end
    end
end

# Un botón de la barra: esa pestaña, delante
func elegir_pestana(w: Ventana, i: Int)
    if w.pestanas == nil or i >= w.pestanas.length or i == w.pestana
        return
    end
    pestana_guardar(w)
    pestana_traer(w, i)
end

func nueva_ventana(direccion: String) -> Ventana
    var nada: Ventana = nil
    k = dw_ventanas.length
    if k >= MAX_VENTANAS
        return nada
    end
    v = Navegador_create()
    if dw_pantalla != ""
        mui_window_screen(v.window, dw_pantalla)
    end
    mui_set_value(v.propia_pantalla, preferencia(FICHERO_PREFERENCIAS, "pantalla") == "si")
    mui_set_value(v.depuracion_red, traza_fichero != "")
    w = Ventana(v, k)
    var sin_pasos: [String] = []
    w.pasos = sin_pasos
    dw_ventanas.push(w)
    if k == 0
        mui_canvas_on_draw(v.pagina, pinta0)
        mui_canvas_on_draw(v.led, led0)
    elif k == 1
        mui_canvas_on_draw(v.pagina, pinta1)
        mui_canvas_on_draw(v.led, led1)
    elif k == 2
        mui_canvas_on_draw(v.pagina, pinta2)
        mui_canvas_on_draw(v.led, led2)
    else
        mui_canvas_on_draw(v.pagina, pinta3)
        mui_canvas_on_draw(v.led, led3)
    end
    mui_canvas_on_input(v.pagina, ID_PAGINA)
    mui_canvas_on_move(v.pagina, ID_RATON + k)
    # la página se pinta aparte y llega a la ventana de una vez: no se ve redibujarse
    mui_canvas_buffered(v.pagina, true)
    mui_on_close(v.window, ID_CERRADA + k)
    mui_on_drop(v.window, ID_SOLTADO + k)
    mui_window_open(v.window)
    if k > 0
        mover_ventana(v.window, k * 24, k * 16)
    end
    versiones_boton(w)
    if direccion != ""
        navegar(w, direccion)
    else
        abrir(w, "")
    end
    return w
end

func cerrar_ventana(w: Ventana)
    parar_carga(w)
    if w.actual != nil
        documento_liberar(w.actual)
        var ninguno: Documento = nil
        w.actual = ninguno
    end
    # (las pestañas de detrás: sus páginas y lo que estuviera llegando)
    if w.pestanas != nil
        for i in (0..w.pestanas.length - 1)
            p = w.pestanas[i]
            if i != w.pestana
                if p.carga != nil
                    http_cancelar(p.carga)
                end
                if p.actual != nil
                    documento_liberar(p.actual)
                end
            end
        end
    end
    w.abierta = false
    mui_window_close(w.v.window)
end

func abiertas() -> Int
    n = 0
    for w in dw_ventanas
        if w.abierta
            n = n + 1
        end
    end
    return n
end

# La ventana que está usando el usuario (la activa); si no hay, la primera abierta
# El puerto ARexx (tarea 63b, como en Amelinium): ADDRESS TACHYON. Órdenes, sin mirar mayúsculas: OPEN dirección
# (también OPENURL y GOTOURL), NEWTAB [dirección], GETURL, GETTITLE, BACK, FORWARD, RELOAD, STOP, HOME, READER (el
# modo lectura), VERSION y QUIT.
# GETURL, GETTITLE y VERSION dan RESULT (OPTIONS RESULTS en el script); lo que no conoce, RC 10. Van a la ventana
# activa; su señal (rexx_signal, D84) despierta el bucle aunque Tachyon esté quieto. (MUI abre también el suyo,
# TACHYON.1, con sus órdenes de serie: QUIT, HIDE, SHOW, INFO...)
const PUERTO_AREXX = "TACHYON"
var dw_rexx_evento: Int = 0     # el botón que pidió una orden (atrás, recargar...): el bucle lo hace como si se pulsara

# El modo lectura (tarea 63c, como en Amelinium): lib/lectura.dash saca el artículo de la página que se ve y se abre
# como tachyon:lectura (atrás vuelve a la página); en ella, otra vez el menú vuelve atrás. Sin artículo, un aviso.
var dw_lectura_html: String = ""

func leer_pagina(w: Ventana)
    if w.actual == nil or w.actual.doc == nil
        return
    end
    if w.actual.direccion == "tachyon:lectura"
        if w.visto > 0
            w.visto = w.visto - 1
            mui_set_text(w.v.url, w.pasos[w.visto])
            abrir(w, w.pasos[w.visto])
            botones(w)
        end
        return
    end
    h = lectura_html(w.actual.doc, w.actual.direccion, w.actual.titulo)
    if h == ""
        dw_estado(w, tr(172, "There is no article to read on this page."))
        return
    end
    dw_lectura_html = h
    navegar(w, "tachyon:lectura")
end

# Una dirección escrita sin esquema ("amiga.org", o con su puerto "localhost:8080", "127.0.0.1:8080/x"), con http://;
# las que llevan esquema o son una ruta del Amiga ("Work:pagina.html"), tal cual
func con_esquema(d: String) -> String
    p = str_find(d, ":")
    if p < 0
        return "http://" + d
    end
    k = p + 1
    while k < d.length and str_code(d, k) >= 48 and str_code(d, k) <= 57
        k = k + 1
    end
    if k > p + 1 and (k == d.length or str_code(d, k) == 47)
        return "http://" + d
    end
    return d
end

func arexx_atender()
    o = str_trim(rexx_get())
    if o == ""
        return
    end
    verbo = str_upper(o)
    resto = ""
    p = str_find(o, " ")
    if p > 0
        verbo = str_upper(o[:p])
        resto = str_trim(o[p + 1:])
    end
    if resto.length >= 2 and str_starts(resto, "\"") and str_ends(resto, "\"")
        resto = resto[1:resto.length - 1]
    end
    w = activa()
    if w == nil
        rexx_reply(20, "")
        return
    end
    if resto != ""
        resto = con_esquema(resto)
    end
    if verbo == "OPEN" or verbo == "OPENURL" or verbo == "GOTOURL"
        if resto == ""
            rexx_reply(10, "")
            return
        end
        navegar(w, resto)
    elif verbo == "NEWTAB"
        nueva_pestana(w, resto)
    elif verbo == "GETURL"
        u = ""
        if w.actual != nil
            u = w.actual.direccion
        end
        rexx_reply(0, u)
        return
    elif verbo == "GETTITLE"
        t = ""
        if w.actual != nil
            t = w.actual.titulo
        end
        rexx_reply(0, t)
        return
    elif verbo == "VERSION"
        rexx_reply(0, "Tachyon " + DASHWEB_VERSION)
        return
    elif verbo == "READER"
        leer_pagina(w)
    elif verbo == "BACK"
        dw_rexx_evento = ID_ATRAS
    elif verbo == "FORWARD"
        dw_rexx_evento = ID_ADELANTE
    elif verbo == "RELOAD"
        dw_rexx_evento = ID_RECARGAR
    elif verbo == "STOP"
        dw_rexx_evento = ID_PARAR
    elif verbo == "HOME"
        dw_rexx_evento = ID_INICIO
    elif verbo == "QUIT"
        dw_rexx_evento = ID_SALIR
    else
        rexx_reply(10, "")
        return
    end
    rexx_reply(0, "")
end

func activa() -> Ventana
    var primera: Ventana = nil
    for w in dw_ventanas
        if w.abierta
            if mui_window_active(w.v.window)
                return w
            end
            if primera == nil
                primera = w
            end
        end
    end
    return primera
end

# El buscador elegido (tachyon:buscadores; DuckDuckGo si no se eligió ninguno)
func buscador_elegido() -> String
    b = preferencia(FICHERO_PREFERENCIAS, "buscador")
    if b == ""
        return BUSCADOR_POR_DEFECTO
    end
    return b
end

func pagina_inicio() -> String
    inicio = preferencia(FICHERO_PREFERENCIAS, "inicio")
    if inicio == ""
        inicio = "tachyon:inicio"
    end
    return inicio
end

# Los marcadores, preferencias y cookies de cuando el navegador se llamaba dashweb (2026-10-21) pasan a su nombre
# nuevo la primera vez (se renombran: los de antes no se pierden)
func ficheros_de_antes()
    for par in [["PROGDIR:dashweb.marcadores", FICHERO_MARCADORES], ["PROGDIR:dashweb.prefs", FICHERO_PREFERENCIAS], ["PROGDIR:dashweb.cookies", FICHERO_COOKIES]]
        if not file_exists(par[1]) and file_exists(par[0])
            file_rename(par[0], par[1])
        end
    end
end

Main
    fpu_precision_extendida()
    ficheros_de_antes()
    # las conexiones siguen abiertas para los recursos del mismo servidor (sin volver a negociar TLS)
    http_seguir = true
    # la tarea de la red (lib/red.dash) sigue 30 s sin conexiones: guarda las sesiones TLS y los nombres entre páginas
    red_ociosa_ms = 60000
    # las maquetas caras por el JavaScript, como mucho un tercio del tiempo (lib/documento.dash)
    documento_aplazar = true
    cookies_cargar(FICHERO_COOKIES)
    almacen_cargar(FICHERO_ALMACEN)
    descargas_cargar(FICHERO_DESCARGAS)
    # el idioma de Locale para las webs: Accept-Language y navigator.language
    jsdom_idioma = actualizar_idioma_web(actualizar_idioma_preferido())
    http_idiomas = actualizar_idioma_cabecera(jsdom_idioma)
    # sin requesters de AmigaOS ("Inserte el volumen..."): una dirección que no existe falla sin más (D68)
    dos_requesters(false)
    rexx_port(PUERTO_AREXX)
    if mui_app_begin("Tachyon", "TACHYON") == 0
        Print "Tachyon necesita MUI (3.8 o 5) y un 68020"
    else
        # en su propia pantalla (preferencia): antes de abrir ninguna ventana. No pasa a ser la pública por defecto:
        # un navegador no lanza programas que deban salir en ella (Forja sí)
        if preferencia(FICHERO_PREFERENCIAS, "pantalla") == "si" and screen_clone_wb(PANTALLA)
            dw_pantalla = PANTALLA
        end
        a = Acerca_create()
        if dw_pantalla != ""
            mui_window_screen(a.window, dw_pantalla)
        end
        mui_set_text(a.version, texto_version(DASHWEB_VERSION) + hueco2(tr(159, "built on %1 at %2"), compilado_fecha(), compilado_hora()))
        # cada argumento en su ventana (hasta 4); sin argumentos, la página de inicio
        # TRAZA: la línea de tiempo de las cargas por la salida (lib/traza.dash)
        paginas = 0
        # (el registro de depuración de red, si se dejó encendido en el menú Herramientas; tarea 67)
        if preferencia(FICHERO_PREFERENCIAS, "depuracion") == "si"
            depuracion(true)
        end
        for i in (0..arg_count() - 1)
            if arg(i) == "TRAZA"
                traza_activa = true
                traza_t0 = time_ms()
                traza("memoria libre al empezar " + mem_total() / 1024 + " KB; pila " + video_pila_total() / 1024 + " KB")
                video_pila_pintar()
            elif str_starts(arg(i), "TRAZA=")
                # TRAZA=fichero: lo mismo, a ese fichero (lo que se escribe ahí sigue aunque se cuelgue el Amiga)
                traza_activa = true
                traza_t0 = time_ms()
                traza_a_fichero(arg(i)[6:], "Tachyon trace\n" + informe_texto(DASHWEB_VERSION, http_idiomas, "") + "\n--- trace ---\n")
                video_trampa_poner(arg(i)[6:])
                tachyon_traza_c(arg(i)[6:])
                traza("memoria libre al empezar " + mem_total() / 1024 + " KB; pila " + video_pila_total() / 1024 + " KB")
                video_pila_pintar()
            elif arg(i) == "TRAMPAPROBAR"
                # (diagnóstico de la tarea 66: una instrucción ilegal, para ver la trampa de TRAZA=fichero)
                video_trampa_probar()
            elif arg(i) == "GCSIEMPRE"
                js_gc_siempre(true)
            elif str_starts(arg(i), "JSMINIMA=")
                # JSMINIMA=KB: por debajo de esa memoria libre se suelta el JavaScript de la página (para probarlo)
                dw_js_minima = Int(arg(i)[9:])
            elif str_starts(arg(i), "POCAMEMORIA=")
                # POCAMEMORIA=KB: por debajo de esa memoria libre se descartan las pestañas de detrás (para probarlo)
                dw_poca_memoria = Int(arg(i)[12:])
            elif str_starts(arg(i), "VERSIONES=")
                # VERSIONES=dirección: la lista de versiones de ahí y no de GitHub, mirada ya (para probarlo)
                actualizar_api = arg(i)[10:]
            elif str_starts(arg(i), "DESCARGAS=")
                # DESCARGAS=dirección: los ficheros de las versiones (el catálogo propio) de ahí, pedido ya (para probarlo)
                actualizar_descargas = arg(i)[10:]
            elif str_starts(arg(i), "CAJASEN=")
                dw_cajas_en = Int(arg(i)[8:])
            elif str_starts(arg(i), "JSEN=")
                dw_js_en = Int(arg(i)[5:])
                dw_js_t0 = time_ms()
            elif str_starts(arg(i), "JS=")
                dw_js = url_deshacer(arg(i)[3:])
            elif str_starts(arg(i), "CAJAS=")
                dw_cajas = arg(i)[6:]
            elif str_starts(arg(i), "DIBUJOS=")
                # DIBUJOS=y0-y1: al acabar la página, sus dibujos de entre esas alturas por la salida (para depurar)
                trozos = css_partir(arg(i)[8:], 45)
                if trozos.length == 2
                    dw_dibujos_y0 = Int(trozos[0])
                    dw_dibujos_y1 = Int(trozos[1])
                end
            else
                paginas = paginas + 1
            end
        end
        if paginas == 0
            nueva_ventana(preferencia(FICHERO_PREFERENCIAS, "inicio"))
        end
        for i in (0..arg_count() - 1)
            if arg(i) != "TRAZA" and not str_starts(arg(i), "TRAZA=") and arg(i) != "GCSIEMPRE" and not str_starts(arg(i), "DIBUJOS=") and not str_starts(arg(i), "VERSIONES=") and not str_starts(arg(i), "POCAMEMORIA=") and not str_starts(arg(i), "JSMINIMA=") and not str_starts(arg(i), "DESCARGAS=") and not str_starts(arg(i), "CAJAS=") and not str_starts(arg(i), "CAJASEN=") and not str_starts(arg(i), "JS=") and not str_starts(arg(i), "JSEN=")
                nueva_ventana(arg(i))
            end
        end
        # (con argumentos no: así lo abren las pruebas y las medidas, que no deben preguntar a GitHub cada vez)
        if str_starts(actualizar_api, "http://")
            versiones_mirar(true)
        elif arg_count() == 0 and preferencia(FICHERO_PREFERENCIAS, "avisar_versiones") != "no" and preferencia(FICHERO_PREFERENCIAS, "versiones_visto") != "" + actualizar_hoy()
            versiones_mirar(false)
        end
        if arg_count() == 0
            catalogo_propio()
        elif str_starts(actualizar_descargas, "http://")
            preferencia_poner(FICHERO_PREFERENCIAS, "catalogo_pedido", "")
            catalogo_propio()
        end
        acerca_abierta = false
        while abiertas() > 0
            # también despierta con la señal de las tareas: la de la red (lib/red.dash) avisa al recibir algo, y las
            # que decodifican imágenes al acabar (0: una de ellas)
            ev = mui_wait_event_signals(task_signal() | rexx_signal())
            # (las órdenes de ARexx, que despiertan el bucle por su señal (D84): la que pide un botón va en lugar del
            # tic o de nada, o en la vuelta siguiente)
            arexx_atender()
            if dw_rexx_evento != 0 and (ev == 0 or ev == ID_TIC)
                ev = dw_rexx_evento
                dw_rexx_evento = 0
            end
            if ev == -1 or ev == ID_SALIR
                # (tarea 66: el cierre del vídeo 2 sin aviso; ¿sale por aquí? -1 es el Quit de MUI, también con Ctrl-C)
                traza("el bucle de eventos acaba por el evento " + ev + " (ventanas abiertas: " + abiertas() + ")")
                break
            end
            if ev == 0
                ev = ID_TIC
            end
            if ev == ID_TIC or ev == ID_RANGO
                # mui_timer es uno solo: sirve a todas las ventanas
                for t in dw_ventanas
                    if t.abierta
                        if ev == ID_RANGO
                            ajustar_barra(t)
                        else
                            tic(t)
                            # (el título que puso después el JavaScript: document.title, como en YouTube)
                            if t.actual != nil and t.actual.titulo != t.titulo_puesto
                                poner_titulo(t)
                            end
                        end
                    end
                end
                versiones_avanzar()
                descargas_tic()
                vaciar_salida()
                programar()
                continue
            end
            if ev == ID_COMPLETA_CERRADA
                salir_completa()
                continue
            end
            if ev == ID_COMPLETA
                tecla = mui_canvas_key(dw_completa_lienzo)
                if tecla == 0x40 and dw_completa != nil and dw_completa_de != nil and dw_completa_de.actual != nil
                    # espacio: parar o seguir
                    videos_alternar(documento_videos(dw_completa_de.actual), dw_completa.nodo, dw_completa_de.actual.direccion)
                    mui_canvas_redraw(dw_completa_lienzo)
                    programar()
                elif (tecla == 0x4E or tecla == 0x4F) and dw_completa != nil and dw_completa_de != nil and dw_completa_de.actual != nil
                    salto = 10000
                    if tecla == 0x4F
                        salto = -10000
                    end
                    videos_saltar(documento_videos(dw_completa_de.actual), dw_completa.nodo, salto)
                    mui_canvas_redraw(dw_completa_lienzo)
                    programar()
                elif tecla < 0 and mui_canvas_button(dw_completa_lienzo) == 1 and barra_completa() > 0
                    # (un clic en la barra de controles: reproducir o parar, o saltar; tarea 64f)
                    mui_canvas_redraw(dw_completa_lienzo)
                    programar()
                elif tecla == 0x45 or (tecla < 0 and mui_canvas_button(dw_completa_lienzo) == 1)
                    salir_completa()
                end
                continue
            end
            if ev >= ID_CERRADA and ev < ID_CERRADA + MAX_VENTANAS
                cerrar_ventana(dw_ventanas[ev - ID_CERRADA])
                continue
            end
            if ev >= ID_RATON and ev < ID_RATON + MAX_VENTANAS
                raton(dw_ventanas[ev - ID_RATON])
                continue
            end
            if ev >= ID_SOLTADO and ev < ID_SOLTADO + MAX_VENTANAS
                soltado(dw_ventanas[ev - ID_SOLTADO])
                continue
            end
            w = activa()
            if w == nil
                break
            end
            if ev == ID_PAGINA
                # un atajo de menú con el puntero sobre la página (tarea 57): la página tiene menú del botón derecho y
                # MUI 3.8 pone RMBTRAP en la ventana mientras el puntero está sobre ella; con él, Intuition no mira los
                # atajos de menú y la tecla llega a la página como una más
                atajo = atajo_de_menu(w)
                if atajo == ID_SALIR
                    break
                elif atajo > 0
                    ev = atajo
                end
            end
            if ev >= ID_PESTANA and ev < ID_PESTANA + MAX_PESTANAS
                elegir_pestana(w, ev - ID_PESTANA)
                continue
            end
            if ev == ID_PESTANA_MAS or ev == ID_NUEVA_PESTANA
                nueva_pestana(w, "")
                continue
            end
            if ev == ID_CERRAR_PESTANA
                cerrar_pestana(w)
                continue
            end
            if ev == ID_IR
                direccion = str_trim(mui_get_text(w.v.url))
                if es_busqueda(direccion)
                    # unas palabras: se buscan con el buscador elegido, como en Chrome
                    direccion = buscar_url(buscador_elegido(), direccion)
                elif direccion != ""
                    direccion = con_esquema(direccion)
                end
                if direccion == ""
                    abrir(w, "")
                else
                    navegar(w, direccion)
                end
            end
            if ev == ID_RECARGAR and w.actual != nil
                if w.visto >= 0
                    abrir(w, w.pasos[w.visto])
                else
                    abrir(w, "")
                end
            end
            if ev == ID_ATRAS
                paso_historial(w, -1, true)
            elif ev == ID_ADELANTE
                paso_historial(w, 1, true)
            end
            if ev == ID_INSPECCIONAR
                inspeccionar(w)
            end
            if ev == ID_VER_HISTORIAL
                navegar(w, "tachyon:historial")
            end
            if ev == ID_LECTURA
                leer_pagina(w)
            end
            if ev == ID_PEGAR
                pegar(w)
            end
            if ev == ID_COOKIES
                navegar(w, "tachyon:cookies")
            end
            if ev == ID_INFORME
                navegar(w, "tachyon:informe")
            end
            if ev == ID_BUSCADORES
                navegar(w, "tachyon:buscadores")
            end
            if ev == ID_DESCARGAS
                navegar(w, "tachyon:descargas")
            end
            if ev == ID_GUARDAR_PAGINA
                guardar_pagina(w)
            end
            if ev == ID_GUARDAR_ENLACE
                guardar_enlace(w)
            end
            if ev == ID_ABRIR_FICHERO
                abrir_fichero(w)
            end
            if ev == ID_IR_DIRECCION
                activar(w.v.window, w.v.url)
            end
            if ev == ID_CANDADO and w.actual != nil
                if w.candado == 1
                    dw_estado(w, hueco(tr(120, "Encrypted connection (HTTPS) to %1"), url_parse(w.actual.direccion).host))
                else
                    dw_estado(w, tr(121, "This page arrives unencrypted (HTTP)"))
                end
            end
            if ev == ID_SCROLL
                if w.desde != mui_get_value(w.v.barra)
                    w.aviso_scroll = true
                    # (lo mueve quien mira: la pestaña que volvía a su sitio se queda donde la deja)
                    w.desde_volver = -1
                end
                w.desde = mui_get_value(w.v.barra)
                mui_canvas_redraw(w.v.pagina)
                # (las imágenes perezosas que ahora quedan cerca empiezan a bajarse: el tic otra vez)
                if w.actual != nil
                    imagenes_hasta(w.actual.im, w.desde, mui_height(w.v.pagina))
                    programar()
                end
            end
            if ev == ID_PARAR and (w.carga != nil or w.preparando != nil)
                parar_carga(w)
                modo_carga(w, false)
                mui_set_value(w.v.progreso, 0)
                dw_estado(w, tr(122, "Stopped"))
                actualizar_giro(w)
                programar()
            end
            if ev == ID_PAGINA
                rueda = mui_canvas_wheel(w.v.pagina)
                tecla = mui_canvas_key(w.v.pagina)
                if w.foco != nil and w.actual != nil and not nodo_en_documento(w.actual.doc, w.foco)
                    # (el foco en algo que el JavaScript ya quitó, como el botón "Reject all" del aviso de cookies de
                    # YouTube: las teclas se perdían y la página no bajaba con el espacio)
                    w.foco = nil
                end
                if rueda != 0
                    desplazar(w, 0 - rueda * 30)
                elif tecla >= 0 and w.foco != nil
                    r = FORM_NADA
                    # Amiga (las dos) o Ctrl con V pega, C copia y X corta (tarea 59): el portapapeles va en UTF-8 y
                    # el DOM en Latin-1
                    atajo = (mui_canvas_qualifiers(w.v.pagina) & 10) != 0 and (tecla == 0x34 or tecla == 0x33 or tecla == 0x32)
                    if atajo and tecla == 0x34
                        r = formulario_pegar(w.foco, utf8_to_latin1(clip_read_text()))
                    elif atajo and tecla == 0x33
                        copia = formulario_copiable(w.foco)
                        if copia != ""
                            clip_write_text(latin1_to_utf8(copia))
                        end
                    elif atajo
                        # cortar: el campo se vacía solo si el texto ha llegado al portapapeles
                        copia = formulario_copiable(w.foco)
                        if copia != "" and clip_write_text(latin1_to_utf8(copia))
                            formulario_poner_valor(w.foco, "")
                            r = FORM_CAMBIO
                        end
                    elif (mui_canvas_qualifiers(w.v.pagina) & 8) == 0
                        # (Amiga con otra tecla no escribe: con el puntero sobre la página llegan aquí los atajos)
                        r = formulario_tecla(w.foco, mui_canvas_char(w.v.pagina), tecla)
                    end
                    if r == FORM_CAMBIO
                        mui_canvas_redraw(w.v.pagina)
                    elif r == FORM_ENVIAR
                        enviar(w, w.foco)
                    end
                elif (tecla == 0x4E or tecla == 0x4F) and w.actual != nil and videos_en_marcha(documento_videos(w.actual)) != nil
                    # las flechas de los lados con un vídeo en marcha: 10 s adelante o atrás, como en YouTube (tarea 64d)
                    salto = 10000
                    if tecla == 0x4F
                        salto = -10000
                    end
                    if videos_saltar(documento_videos(w.actual), videos_en_marcha(documento_videos(w.actual)), salto)
                        mui_canvas_redraw(w.v.pagina)
                        programar()
                    end
                elif tecla == 0x4D
                    desplazar(w, 20)
                elif tecla == 0x4C
                    desplazar(w, -20)
                elif tecla == 0x40
                    desplazar(w, mui_height(w.v.pagina) - 20)
                elif tecla == 0x41
                    desplazar(w, 20 - mui_height(w.v.pagina))
                elif mui_canvas_button(w.v.pagina) == 1
                    clic(w)
                end
            end
            if ev == ID_MARCADORES
                navegar(w, "tachyon:marcadores")
            end
            if (ev == ID_ANADIR or ev == ID_ESTRELLA) and w.actual != nil
                marcador_alternar(w)
            end
            if ev == ID_USAR_INICIO and w.actual != nil
                if preferencia_poner(FICHERO_PREFERENCIAS, "inicio", w.actual.direccion)
                    dw_estado(w, hueco(tr(123, "Home page: %1"), w.actual.direccion))
                end
            end
            if ev == ID_INICIO
                navegar(w, pagina_inicio())
            end
            if ev == ID_NUEVA
                if nueva_ventana(pagina_inicio()) == nil
                    dw_estado(w, hueco(tr(124, "At most %1 windows"), "" + MAX_VENTANAS))
                end
            end
            if ev == ID_CERRAR
                cerrar_ventana(w)
            end
            if ev == ID_ACTUALIZAR
                versiones_clic()
                if dw_reiniciar
                    break
                end
            end
            if ev == ID_BUSCAR_VERSIONES
                preferencia_poner(FICHERO_PREFERENCIAS, "avisar_versiones", "si")
                dw_estado(w, tr(125, "Checking for a new version..."))
                versiones_mirar(true)
            end
            if ev == ID_DEPURACION
                si = mui_get_value(w.v.depuracion_red) != 0
                depuracion(si)
                if si
                    preferencia_poner(FICHERO_PREFERENCIAS, "depuracion", "si")
                    dw_estado(w, hueco(tr(526, "Network debug log on: %1"), DEPURACION_FICHERO))
                else
                    preferencia_poner(FICHERO_PREFERENCIAS, "depuracion", "no")
                    dw_estado(w, tr(527, "Network debug log off"))
                end
                for o in dw_ventanas
                    if o.abierta
                        mui_set_value(o.v.depuracion_red, si)
                    end
                end
            end
            if ev == ID_PANTALLA
                si = mui_get_value(w.v.propia_pantalla) != 0
                if si
                    preferencia_poner(FICHERO_PREFERENCIAS, "pantalla", "si")
                    dw_estado(w, tr(168, "Tachyon will open on its own screen next time"))
                else
                    preferencia_poner(FICHERO_PREFERENCIAS, "pantalla", "no")
                    dw_estado(w, tr(169, "Tachyon will open on the Workbench screen next time"))
                end
                for o in dw_ventanas
                    if o.abierta
                        mui_set_value(o.v.propia_pantalla, si)
                    end
                end
            end
            if ev == ID_NO_AVISAR
                preferencia_poner(FICHERO_PREFERENCIAS, "avisar_versiones", "no")
                dw_estado(w, tr(126, "Won't tell you about new versions"))
            end
            if ev == ID_ACERCA
                if acerca_abierta
                    mui_window_close(a.window)
                else
                    mui_window_open(a.window)
                end
                acerca_abierta = not acerca_abierta
            end
        end
        traza("fuera del bucle de eventos (ventanas abiertas: " + abiertas() + "): se cierra todo")
        for w in dw_ventanas
            parar_carga(w)
            if w.actual != nil
                documento_liberar(w.actual)
            end
        end
        http_cerrar_libres()
        # la tarea de la red, parada (el programa espera a sus tareas al acabar)
        red_terminar()
        cookies_guardar(FICHERO_COOKIES)
        almacen_guardar(FICHERO_ALMACEN)
        mui_app_end()
        # (la pantalla, cerrada antes de abrir la versión nueva, que querrá la suya con el mismo nombre)
        if dw_pantalla != ""
            screen_close()
        end
        traza("fin de Main")
        video_trampa_quitar()
        if dw_reiniciar and not actualizar_lanzar(actualizar_programa())
            Print "Tachyon: no se pudo abrir la versión nueva; ábrela a mano"
        end
    end
end
