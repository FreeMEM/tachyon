# Cuánto tarda leer una hoja de estilo grande, y cuánta memoria ocupa leída (la de YouTube son 3,7 MB; tareas 38c y
# 38c6). Uso: css_grande FICHERO
import "../../lib/css.dash"

Main
    texto = file_read_text(arg(0))
    m0 = mem_total()
    t0 = time_ms()
    hoja = css_leer(texto, 0)
    Print "" + texto.length + " bytes, " + hoja.reglas.length + " reglas en " + (time_ms() - t0) + " ms; ocupa " + (m0 - mem_total()) / 1024 + " KB"
end
