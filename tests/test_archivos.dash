# Test: ficheros comprimidos (lib/archivos.dash y lib/lha.dash, tarea 63d): el tipo por la extensión; un .lha sin
# orden lha en el sistema (el emulador no la tiene) se lista y se extrae con lib/lha.dash (un cajón, un fichero lh5
# y un .readme); un .lzx sin lzx ni XAD dice qué hace falta y lleva a buscarlo en Aminet.
# memcheck
# expect-out: tipos: lha lha lzx zip tgz tgz [] []
# expect-out: lista: true true true true
# expect-out: extraído: [] 12 true
# expect-out: lzx: true true
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/archivos.dash"

Main
    Print "tipos: " + archivo_tipo("Work:a.lha") + " " + archivo_tipo("x.LZH") + " " + archivo_tipo("b.lzx") + " " + archivo_tipo("c.zip") + " " + archivo_tipo("d.tar.gz") + " " + archivo_tipo("e.tgz") + " [" + archivo_tipo("f.html") + "] [" + archivo_tipo("lha") + "]"
    hex = ""
    n = hex.length / 2
    b = buffer_alloc(n)
    for i in (0..n - 1)
        buffer_set_byte(b, i, str_to_int(hex[i * 2:i * 2 + 2], 16))
    end
    file_save("RAM:tprueba.lha", b, n)
    buffer_free(b)
    h = archivo_html("RAM:tprueba.lha")
    Print "lista: " + str_contains(h, "Prueba/Prueba") + " " + str_contains(h, "Prueba.readme") + " " + str_contains(h, "Prueba/</td>") + " " + str_contains(h, "tachyon:archivo?extraer=RAM:tprueba.lha")
    e = archivo_extraer("RAM:tprueba.lha", "RAM:tsal/")
    Print "extraído: [" + e + "] " + file_size("RAM:tsal/Prueba/Prueba") + " " + file_exists("RAM:tsal/Prueba.readme")
    file_write_text("RAM:tprueba.lzx", "")
    z = archivo_html("RAM:tprueba.lzx")
    Print "lzx: " + str_contains(z, "It needs <b>lzx</b>") + " " + str_contains(z, "https://aminet.net/search?query=lzx")
    file_delete("RAM:tprueba.lha")
    file_delete("RAM:tprueba.lzx")
end
