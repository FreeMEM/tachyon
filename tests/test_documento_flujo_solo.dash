# Test: un cambio del JavaScript dentro de un bloque en el flujo
# maqueta solo ese bloque si su alto no cambia (tarea 76: la c2 del plan). El bloque va dentro de un marco relative
# con top y z-index: lo nuevo queda igual que con la maqueta entera (sitio, capa y orden de posicionado), y la página
# es la misma. Si el texto se alarga y el bloque crece, maqueta entera (y lo de debajo baja); dentro de una fila
# flex (su ancho sale de lo de dentro), también. Un <p> sin borde ni relleno (sus márgenes se juntan con los de al
# lado) también se maqueta solo si lo que ve su padre no cambia.
# memcheck
# expect-out: parcial: true | igual que entera: true
# expect-out: crece: false | lo de debajo baja: true
# expect-out: en flex: false
# expect-out: párrafo: true | igual que entera: true
# expect-out: memcheck: vivos 0 objetos y 0 strings (escapados 0 y 0), errores 0

import "../lib/documento.dash"

func firma(p: Pagina) -> String
    r = ""
    for d in p.dibujos
        r = r + d.tipo + ":" + d.x + "," + d.y + " " + d.ancho + "x" + d.alto + " " + d.texto + " c" + d.capa + " p" + d.pos + " v" + d.velado + ";"
    end
    return r
end

func texto_de(p: Pagina, n: Nodo) -> Dibujo
    var nada: Dibujo = nil
    for d in p.dibujos
        if d.tipo == D_TEXTO and d.nodo == n
            return d
        end
    end
    return nada
end

Main
    h = "<body style='margin:0'><h1>Arriba</h1><div style='position:relative;top:4px;z-index:2'>"
    h = h + "<div id=tarjeta style='padding:8px;background:#eee'><p style='margin:0'>Hola <span id=t>mundo</span></p></div></div>"
    h = h + "<p id=abajo>debajo</p><p>Un <b id=pb>texto</b> suelto</p><div style='display:flex'><div style='padding:4px'><span id=f>flex</span></div><div>otro</div></div>"
    h = h + "<script>var t = document.getElementById('t'), f = document.getElementById('f');</script></body>"
    d = documento_html("http://x/", h)
    documento_maquetar(d, 300)
    # (el primer cambio tras maquetar a otro ancho rehace el índice de las hojas: estilo entero)
    js_evaluar(d.js, "t.setAttribute('data-x', '1')", "t.js")
    documento_al_dia(d)
    p = d.pagina
    js_evaluar(d.js, "t.textContent = 'gente'", "t.js")
    documento_al_dia(d)
    parcial = d.pagina == p
    f1 = firma(d.pagina)
    documento_maquetar(d, 300)
    f2 = firma(d.pagina)
    if f1 != f2
        Print "parcial " + f1
        Print "entera  " + f2
    end
    Print "parcial: " + parcial + " | igual que entera: " + (f1 == f2)
    p = d.pagina
    abajo = dom_por_id(d.doc, "abajo")
    y0 = texto_de(p, abajo).y
    js_evaluar(d.js, "t.textContent = 'mundo mundo mundo mundo mundo mundo mundo mundo mundo mundo mundo'", "t.js")
    documento_al_dia(d)
    Print "crece: " + (d.pagina == p) + " | lo de debajo baja: " + (texto_de(d.pagina, abajo).y > y0)
    p = d.pagina
    js_evaluar(d.js, "f.textContent = 'flexible'", "t.js")
    documento_al_dia(d)
    Print "en flex: " + (d.pagina == p)
    p = d.pagina
    js_evaluar(d.js, "document.getElementById('pb').textContent = 'otro'", "t.js")
    documento_al_dia(d)
    parcial = d.pagina == p
    f1 = firma(d.pagina)
    documento_maquetar(d, 300)
    f2 = firma(d.pagina)
    Print "párrafo: " + parcial + " | igual que entera: " + (f1 == f2)
    documento_liberar(d)
end
