# Test: dos infinitos son iguales (tarea 41d): la FPU emulada de FS-UAE da Infinity == Infinity falso; QuickJS los
# compara por sus bits (js_deq). testharness.js distingue 0 de -0 con 1/x === 1/y y fallaba "expected 0 but got 0".
# expect-out: true true true true true false false true true
import "../lib/js.dash"

Main
    js = js_nuevo()
    Print js_evaluar(js, "var x = 0, a = 1 / x; [Infinity === Infinity, a == 1 / x, a === Infinity, a >= Infinity, -a <= -Infinity, a === -Infinity, 1 / -0 === 1 / 0, Object.is(0, 0), [Infinity].indexOf(a) == 0].join(' ')", "t.js")
    js_liberar(js)
end
