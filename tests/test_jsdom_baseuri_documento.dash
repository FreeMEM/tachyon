# Test: baseURI de un documento que no es el de la ventana (DOMParser, createHTMLDocument) y de sus elementos: su <base
# href> resuelto contra su URL, o su URL; no el <base> de la página (heredaban su getter; WPT domparsing url-base,
# 0/45 -> 9/45). El de la página sigue con su <base>.
# expect-out: página http://a.b/fake/base | html http://a.b/c/d.html | elemento http://a.b/c/d.html | xml http://a.b/c/d.html
# expect-out: con su base http://a.b/otra/

import "../lib/jsdom.dash"
import "../lib/html5.dash"

Main
    doc = dom_desde_html5("<html><head><base href='/fake/base'></head><body></body></html>")
    js = js_nuevo()
    jsdom_preparar(js, doc)
    js_evaluar(js, "__dashweb_lugar('http://a.b/c/d.html')", "t.js")
    Print js_evaluar(js, "var d = new DOMParser().parseFromString('<html></html>', 'text/html'); var x = new DOMParser().parseFromString('<a/>', 'text/xml'); 'página ' + document.baseURI + ' | html ' + d.baseURI + ' | elemento ' + d.documentElement.baseURI + ' | xml ' + x.baseURI", "t.js")
    Print js_evaluar(js, "var e = new DOMParser().parseFromString('<html><head><base href=\\'/otra/\\'></head></html>', 'text/html'); 'con su base ' + e.baseURI", "t.js")
    js_liberar(js)
end
