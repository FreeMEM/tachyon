# Pruebas de interfaz en el emulador: espera una ventana (por el principio de su título) y le manda
# clics y teclas con input.device. Lo lanza tools/medir_visor.py --acciones en segundo plano (Run).
#
#   clicar "dashweb" e 100 c 50 40 e 50 t 0x4D
#
# Acciones: "e N" espera N/50 s; "c X Y" clic en X, Y dentro de los bordes de la ventana;
# "C X Y" lo mismo con Mayúsculas pulsada; "v X Y" lleva el puntero a X, Y sin pulsar; "t COD" pulsa y suelta la tecla raw COD (0x4D abajo, 0x40 espacio...); "a COD" la misma con Amiga
# derecha (atajos de menú: 0x22 = D); "k COD" la misma con Ctrl; "m M E" elige con el ratón el elemento E del menú M (desde 0,
# separadores incluidos); "h M E N" lo mismo, pero con el menú abierto N/50 s antes de soltar (para una captura);
# "i" arrastra el primer icono del escritorio del Workbench hasta la ventana; "r X Y" pulsa el botón derecho en X, Y, "p X Y" lo lleva pulsado al punto X, Y
# de la pantalla y "s" lo suelta (menús de MUI). Escribe lo que hace.

# (Dash 2.0: con los builtins window_find, window_found_*, input_*; antes, C con input.device)

func ventana(t: String) -> Int
    return window_find(t)
end

func ventana_texto(win: Int) -> String
    return "" + window_found_box(win, 0) + "," + window_found_box(win, 1) + " " + window_found_box(win, 2) + "x" + window_found_box(win, 3) + " bordes " + window_found_box(win, 4) + "," + window_found_box(win, 5)
end

# La ventana delante de todo y activa (los clics y las teclas van a la ventana activa)
func al_frente(win: Int)
    window_found_activate(win)
    time_delay(10)
end

# x, y dentro de los bordes de la ventana, como los cuentan los input_* (desde su esquina)
func bx(win: Int, x: Int) -> Int
    return window_found_box(win, 4) + x
end

func by(win: Int, y: Int) -> Int
    return window_found_box(win, 5) + y
end

# 1 si eligió el elemento, 0 si la ventana no tiene ese menú
func menu_raton(menu: Int, elemento: Int, espera: Int) -> Int
    if input_menu(menu, elemento, espera)
        return 1
    end
    return 0
end

func esperar(ticks: Int)
    if ticks > 0
        time_delay(ticks)
    else
        time_delay(1)
    end
end

Main
    titulo = arg(0)
    w = 0
    vueltas = 0
    while w == 0 and vueltas < 1500
        w = ventana(titulo)
        if w == 0
            esperar(10)
        end
        vueltas = vueltas + 1
    end
    if w == 0
        Print "clicar: no aparece la ventana " + titulo
    else
        Print "clicar: ventana " + titulo + " en " + ventana_texto(w)
        al_frente(w)
        i = 1
        while i < arg_count()
            a = arg(i)
            if a == "e" and i + 1 < arg_count()
                esperar(Int(arg(i + 1)))
                i = i + 2
            elif a == "c" and i + 2 < arg_count()
                input_click(bx(w, Int(arg(i + 1))), by(w, Int(arg(i + 2))), 0)
                Print "clicar: clic " + arg(i + 1) + "," + arg(i + 2)
                i = i + 3
            elif a == "C" and i + 2 < arg_count()
                input_click(bx(w, Int(arg(i + 1))), by(w, Int(arg(i + 2))), 1)
                Print "clicar: clic con Mayúsculas " + arg(i + 1) + "," + arg(i + 2)
                i = i + 3
            elif a == "v" and i + 2 < arg_count()
                input_move(bx(w, Int(arg(i + 1))), by(w, Int(arg(i + 2))))
                Print "clicar: ratón a " + arg(i + 1) + "," + arg(i + 2)
                i = i + 3
            elif a == "r" and i + 2 < arg_count()
                input_move(bx(w, Int(arg(i + 1))), by(w, Int(arg(i + 2))))
                time_delay(3)
                input_button(2, true)
                Print "clicar: botón derecho en " + arg(i + 1) + "," + arg(i + 2)
                i = i + 3
            elif a == "p" and i + 2 < arg_count()
                input_move_screen(Int(arg(i + 1)), Int(arg(i + 2)), 2)
                Print "clicar: con el botón derecho a " + arg(i + 1) + "," + arg(i + 2)
                i = i + 3
            elif a == "i"
                # un icono del escritorio del Workbench que no tape la ventana (su ARexx da dónde está), arrastrado
                # con el botón izquierdo hasta el centro de la ventana (tarea 60: soltar iconos, D83)
                n = Int(rexx_send("WORKBENCH", "GETATTR WINDOW.ICONS.ALL.COUNT NAME root"))
                x0 = -1
                y0 = -1
                k = 0
                while k < n and x0 < 0
                    q = "WINDOW.ICONS.ALL." + k + "."
                    l = Int(rexx_send("WORKBENCH", "GETATTR " + q + "LEFT NAME root"))
                    tp = Int(rexx_send("WORKBENCH", "GETATTR " + q + "TOP NAME root"))
                    iw = Int(rexx_send("WORKBENCH", "GETATTR " + q + "WIDTH NAME root"))
                    ih = Int(rexx_send("WORKBENCH", "GETATTR " + q + "HEIGHT NAME root"))
                    px = l + iw / 2
                    py = tp + ih / 2 + wm_bar_height()
                    fuera = px < window_found_box(w, 0) or px >= window_found_box(w, 0) + window_found_box(w, 2) or py < window_found_box(w, 1) or py >= window_found_box(w, 1) + window_found_box(w, 3)
                    if fuera
                        x0 = px
                        y0 = py
                        Print "clicar: icono " + k + " de " + n + ": " + rexx_send("WORKBENCH", "GETATTR " + q + "NAME NAME root")
                    end
                    k = k + 1
                end
                input_move_screen(x0, y0, 0)
                input_button(1, true)
                input_move_screen(x0 + 10, y0 + 10, 1)
                cx = window_found_box(w, 0) + window_found_box(w, 2) / 2
                cy = window_found_box(w, 1) + window_found_box(w, 3) / 2
                input_move_screen(cx, cy, 1)
                time_delay(25)
                input_move_screen(cx + 2, cy + 2, 1)
                time_delay(10)
                input_button(1, false)
                time_delay(10)
                input_move_screen(cx + 4, cy + 4, 0)
                Print "clicar: icono de " + x0 + "," + y0 + " soltado en la ventana"
                i = i + 1
            elif a == "s"
                input_button(2, false)
                Print "clicar: suelta el botón derecho"
                i = i + 1
            elif a == "m" and i + 2 < arg_count()
                Print "clicar: menú " + arg(i + 1) + " elemento " + arg(i + 2) + ": " + menu_raton(Int(arg(i + 1)), Int(arg(i + 2)), 10)
                i = i + 3
            elif a == "h" and i + 3 < arg_count()
                Print "clicar: menú " + arg(i + 1) + " elemento " + arg(i + 2) + " abierto " + arg(i + 3) + ": " + menu_raton(Int(arg(i + 1)), Int(arg(i + 2)), Int(arg(i + 3)))
                i = i + 4
            elif a == "a" and i + 1 < arg_count()
                input_key(str_to_int(str_replace(arg(i + 1), "0x", ""), 16), 8)
                Print "clicar: Amiga+" + arg(i + 1)
                i = i + 2
            elif a == "k" and i + 1 < arg_count()
                input_key(str_to_int(str_replace(arg(i + 1), "0x", ""), 16), 2)
                Print "clicar: Ctrl+" + arg(i + 1)
                i = i + 2
            elif a == "t" and i + 1 < arg_count()
                input_key(str_to_int(str_replace(arg(i + 1), "0x", ""), 16), 0)
                Print "clicar: tecla " + arg(i + 1)
                i = i + 2
            else
                i = i + 1
            end
        end
    end
end
